---
import '../styles/global.css';
const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title ? `${title} — Zia Hassan` : 'Zia Hassan'}</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Crimson+Text:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet" />
  </head>
  <body class="font-sans bg-white text-gray-900">
    <nav class="bg-white border-b border-gray-100 sticky top-0 z-50">
      <div class="max-w-4xl mx-auto px-6 py-4 flex items-center justify-between">
        <a href="/" class="text-sm font-semibold text-gray-900 hover:text-violet-700 transition-colors tracking-tight">
          Zia Hassan
        </a>
        <ul class="flex gap-5 text-sm">
          <li><a href="/blog" class="text-gray-500 hover:text-violet-700 transition-colors">Blog</a></li>
          <li><a href="/articles" class="text-gray-500 hover:text-violet-700 transition-colors">Articles</a></li>
          <li><a href="/notes" class="text-gray-500 hover:text-violet-700 transition-colors">Notes</a></li>
          <li><a href="/teaching" class="text-gray-500 hover:text-violet-700 transition-colors">Teaching</a></li>
          <li><a href="/cv" class="text-gray-500 hover:text-violet-700 transition-colors">CV</a></li>
          <li><a href="/media" class="text-gray-500 hover:text-violet-700 transition-colors">Media</a></li>
        </ul>
      </div>
    </nav>

    <main>
      <slot />
    </main>
  </body>
</html>