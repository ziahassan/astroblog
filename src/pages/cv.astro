---
import Layout from '../layouts/layout.astro';
import { getCollection } from 'astro:content';
import { createMarkdownProcessor } from '@astrojs/markdown-remark';

const cvEntries = await getCollection('cv');
const cv = cvEntries[0];

const contact = cv.data?.contact ?? {};
const updatedOn = cv.data?.lastUpdated ? new Date(cv.data.lastUpdated) : null;

const slugify = (value = '') =>
  value
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)/g, '');

const sections = [];
const sectionRegex = /##\s+(.+)\n([\s\S]*?)(?=(?:\n##\s+)|$)/g;
let match;
const markdownProcessor = await createMarkdownProcessor();

while ((match = sectionRegex.exec(cv.body ?? '')) !== null) {
  const [, rawTitle, rawContent = ''] = match;
  const title = rawTitle.trim();
  const id = slugify(title);
  const rendered = await markdownProcessor.render(rawContent.trim());
  sections.push({ title, id, html: rendered.code });
}

const headings = sections.map(({ title, id }) => ({ title, id }));

const researchSummaryMatch = cv.body?.match(/##\s+Research Interests([\s\S]*?)(?:\n##\s|$)/);
const stripMarkdown = (text = '') =>
  text
    .replace(/!\[.*?\]\(.*?\)/g, '')
    .replace(/\[(.*?)\]\(.*?\)/g, '$1')
    .replace(/[*_`]/g, '')
    .replace(/#+\s*/g, '')
    .trim();

const researchSummary = researchSummaryMatch
  ? stripMarkdown(researchSummaryMatch[1]).replace(/\s+/g, ' ')
  : '';
---

<Layout title="Curriculum Vitae">
  <!-- Hero -->
  <section class="cv-hero px-6 pt-16 pb-12">
    <div class="max-w-5xl mx-auto space-y-6 text-center lg:text-left">
      <p class="uppercase tracking-[0.3em] text-xs text-gray-500">Curriculum Vitae</p>
      <div>
        <h1 class="text-4xl md:text-5xl font-light text-slate-900 serif">Zia Hassan</h1>
        <p class="text-lg text-slate-500 mt-2">Educational technology researcher, consultant, and doctoral scholar.</p>
      </div>
      <div class="contact-grid">
        {contact.location && (
          <div class="contact-chip">
            <span>📍</span>
            {contact.location}
          </div>
        )}
        {contact.email && (
          <a href={`mailto:${contact.email}`} class="contact-chip hover:shadow-md transition-shadow">
            <span>✉️</span>
            {contact.email}
          </a>
        )}
      </div>
      {researchSummary && (
        <div class="research-summary">
          <h2>Research focus</h2>
          <p>{researchSummary}</p>
        </div>
      )}
    </div>
  </section>

  <!-- Main content -->
  <section class="cv-layout px-6 pb-16">
    <div class="max-w-6xl mx-auto grid gap-10 lg:grid-cols-[280px,1fr]">
      <aside class="space-y-6">
        <div class="cv-card">
          <h3>Contact</h3>
          <ul class="space-y-3 text-sm text-slate-600">
            {contact.location && <li><span class="card-label">Location</span>{contact.location}</li>}
            {contact.email && (
              <li>
                <span class="card-label">Email</span>
                <a href={`mailto:${contact.email}`} class="text-blue-600 hover:underline font-medium">{contact.email}</a>
              </li>
            )}
          </ul>
        </div>

        {updatedOn && (
          <div class="cv-card">
            <h3>Last updated</h3>
            <p class="text-sm text-slate-500">
              {updatedOn.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric'
              })}
            </p>
          </div>
        )}

        {headings.length > 0 && (
          <nav class="cv-card">
            <h3>On this page</h3>
            <ol class="space-y-2 text-sm text-slate-600">
              {headings.map((section) => (
                <li key={section.id}>
                  <a href={`#${section.id}`} class="hover:text-blue-600 transition-colors">
                    {section.title}
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        )}

        <div class="cv-card">
          <h3>Quick actions</h3>
          <div class="space-y-3">
            <button onclick="window.print()" class="cv-btn primary w-full">
              🖨️ Print CV
            </button>
            <a href="/notes" class="cv-btn ghost w-full text-center">
              🌐 Explore notes
            </a>
            <a href="/essays" class="cv-btn ghost w-full text-center">
              📝 Read essays
            </a>
          </div>
        </div>
      </aside>

      <article class="cv-article cv-content prose-custom">
        {sections.map((section) => (
          <section id={section.id} class="cv-section" key={section.id}>
            <h2>{section.title}</h2>
            <div class="section-body" set:html={section.html}></div>
          </section>
        ))}
      </article>
    </div>
  </section>
</Layout>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Crimson+Text:ital,wght@0,400;0,600;1,400&display=swap');
  
  .serif {
    font-family: 'Crimson Text', serif;
  }
  
  .cv-section {
    border: 1px solid #e2e8f0;
    border-radius: 1.25rem;
    padding: 1.75rem;
    margin-bottom: 1.5rem;
    box-shadow: 0 10px 25px rgba(15, 23, 42, 0.04);
    background: #fff;
  }

  .cv-section h2 {
    margin-top: 0;
    margin-bottom: 1rem;
    border-bottom: 1px solid #e2e8f0;
    padding-bottom: 0.4rem;
  }

  .cv-hero {
    background: linear-gradient(135deg, #f8fafc, #eef2ff);
  }

  .contact-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
  }

  @media (min-width: 1024px) {
    .contact-grid {
      justify-content: flex-start;
    }
  }

  .contact-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.5rem 0.9rem;
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 999px;
    font-size: 0.9rem;
    color: #475569;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.08);
  }

  .research-summary {
    background: white;
    border-radius: 1rem;
    border: 1px solid #e0e7ff;
    padding: 1.5rem;
    text-align: left;
    box-shadow: 0 10px 25px rgba(59, 130, 246, 0.08);
  }

  .research-summary h2 {
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-size: 0.75rem;
    color: #6366f1;
    margin-bottom: 0.5rem;
  }

  .cv-layout {
    background: #f8fafc;
  }

  .cv-card {
    background: white;
    border-radius: 1rem;
    border: 1px solid #e5e7eb;
    padding: 1.5rem;
    box-shadow: 0 15px 35px rgba(15, 23, 42, 0.05);
  }

  .cv-card h3 {
    font-size: 0.9rem;
    font-weight: 600;
    color: #0f172a;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    margin-bottom: 0.75rem;
  }

  .card-label {
    display: block;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: #94a3b8;
    margin-bottom: 0.25rem;
  }

  .cv-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    font-weight: 500;
    border-radius: 0.75rem;
    padding: 0.6rem 1rem;
    border: 1px solid transparent;
    transition: all 0.2s ease;
  }

  .cv-btn.primary {
    background: linear-gradient(135deg, #2563eb, #7c3aed);
    color: white;
    border-color: transparent;
    box-shadow: 0 10px 25px rgba(79, 70, 229, 0.25);
  }

  .cv-btn.primary:hover {
    box-shadow: 0 15px 30px rgba(79, 70, 229, 0.4);
  }

  .cv-btn.ghost {
    background: white;
    border-color: #e2e8f0;
    color: #2563eb;
  }

  .cv-btn.ghost:hover {
    border-color: #cbd5f5;
    background: #f8fbff;
  }

  .cv-article {
    background: white;
    border-radius: 1.5rem;
    border: 1px solid #e2e8f0;
    padding: 2.5rem;
    box-shadow: 0 25px 55px rgba(15, 23, 42, 0.08);
  }
  
  .prose-custom {
    line-height: 1.75;
    color: #334155;
  }
  
  .cv-content h3 {
    font-size: 1.125rem;
    font-weight: 600;
    color: #374151;
    margin-top: 2rem;
    margin-bottom: 0.5rem;
  }
  
  .cv-content p {
    margin-bottom: 0.8rem;
    color: #374151;
  }
  
  .cv-content .section-body p strong:first-child {
    display: block;
    margin-top: 2rem;
    margin-bottom: 0.35rem;
    color: #1f2937;
  }
  
  .cv-content .section-body p + p {
    margin-top: 0.35rem;
  }
  
  .cv-content .section-body p em {
    display: block;
    margin-top: 0.1rem;
    margin-bottom: 0.9rem;
    color: #475569;
  }
  
  .cv-content .section-body p:first-child strong:first-child {
    margin-top: 0;
  }
  
  .cv-content strong {
    font-weight: 600;
    color: #1f2937;
  }
  
  .cv-content em {
    font-style: italic;
    color: #6b7280;
  }
  
  .cv-content ul {
    margin: 1rem 0 2rem;
    padding-left: 1.4rem;
  }
  
  .cv-content li {
    margin-bottom: 0.35rem;
    color: #374151;
  }

  .cv-content .section-body p + ul {
    margin-top: 0.2rem;
  }

  .cv-content .section-body ul + p strong:first-child {
    margin-top: 2rem;
  }
  
  .cv-content a {
    color: #3b82f6;
    text-decoration: none;
    font-weight: 500;
  }
  
  .cv-content a:hover {
    text-decoration: underline;
  }
  
  /* Print styles */
  @media print {
    .cv-hero,
    .cv-layout {
      background: white !important;
      padding: 0 !important;
    }

    .cv-layout > div {
      display: block !important;
    }

    .cv-card,
    .cv-article {
      box-shadow: none !important;
      border: none !important;
      padding: 0 !important;
    }

    .cv-content {
      font-size: 11pt;
      line-height: 1.4;
    }
  }
  
  @media (max-width: 768px) {
    .cv-article {
      padding: 1.5rem;
    }

    .contact-grid {
      flex-direction: column;
    }
  }
</style>
