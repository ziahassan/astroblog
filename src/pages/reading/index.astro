---
// src/pages/reading/index.astro
import Layout from '../../layouts/layout.astro';
import { getCollection } from 'astro:content';

const reading = await getCollection('reading');
// Sort by creation date (newest first) and limit to 20
const sorted = reading
  .sort((a, b) => {
    // Use readDate if available, otherwise fall back to slug comparison
    const dateA = a.data.readDate || a.data.date || new Date(0);
    const dateB = b.data.readDate || b.data.date || new Date(0);
    return new Date(dateB) - new Date(dateA);
  })
  .slice(0, 20);

const random = reading[Math.floor(Math.random() * reading.length)];

// Collect all tags and their counts
const tagCounts = {};
reading.forEach(note => {
  if (note.data.tags && Array.isArray(note.data.tags)) {
    note.data.tags.forEach(tag => {
      tagCounts[tag] = (tagCounts[tag] || 0) + 1;
    });
  }
});

// Sort tags by count (most popular first)
const sortedTags = Object.entries(tagCounts)
  .sort(([,a], [,b]) => b - a)
  .map(([tag, count]) => ({ tag, count }));

// Create backlink count mapping
const backlinkCounts = {};
for (const sourceNote of reading) {
  for (const targetNote of reading) {
    // Check for both [[title]] and [[slug]] patterns
    const titlePattern = `[[${targetNote.data.title}]]`;
    const slugPattern = `[[${targetNote.slug}]]`;
    
    if (sourceNote.body.includes(titlePattern) || sourceNote.body.includes(slugPattern)) {
      backlinkCounts[targetNote.slug] = (backlinkCounts[targetNote.slug] || 0) + 1;
    }
  }
}
---

<Layout title="Reading">
  <section class="max-w-4xl mx-auto space-y-6">
    
    <!-- Header -->
    <div class="text-center border-b border-gray-200 pb-8">
      <h1 class="text-4xl font-light text-gray-800 mb-2">Reading Notes</h1>
      <p class="text-gray-600 text-lg">Literature notes and highlights from my reading</p>
    </div>

    <!-- Tag Cloud -->
    <section class="bg-gradient-to-r from-blue-50 to-gray-50 rounded-xl p-8 border border-gray-200">
      <h2 class="text-2xl font-light text-gray-800 mb-6 text-center">Explore by Topic</h2>
      {sortedTags.length > 0 ? (
        <div class="flex flex-wrap justify-center gap-3">
          {sortedTags.map(({ tag, count }) => {
            // Calculate size based on count (min 1rem, max 2rem)
            const maxCount = Math.max(...sortedTags.map(t => t.count));
            const minSize = 0.875; // text-sm
            const maxSize = 1.25;  // text-xl
            const size = minSize + (maxSize - minSize) * (count / maxCount);
            
            return (
              <a 
                href={`/reading/tags/${tag}`}
                class="group inline-flex items-center gap-2 px-4 py-2 bg-white/70 hover:bg-white border border-gray-200 hover:border-blue-300 rounded-full transition-all duration-200 hover:shadow-sm"
                style={`font-size: ${size}rem`}
              >
                <span class="font-medium text-gray-700 group-hover:text-blue-600 transition-colors">
                  {tag}
                </span>
                <span class="text-xs text-gray-500 bg-gray-100 group-hover:bg-blue-100 px-2 py-0.5 rounded-full font-mono transition-colors">
                  {count}
                </span>
              </a>
            );
          })}
        </div>
      ) : (
        <div class="text-center text-gray-500">
          <p>No tags found yet. Add tags to your reading notes to see them here!</p>
          <p class="text-sm mt-2">Debug: Found {reading.length} reading notes, {sortedTags.length} tags</p>
        </div>
      )}
    </section>
    
    <!-- Search Bar -->
    <div class="bg-gray-50 rounded-lg p-6 border border-gray-200">
      <div class="max-w-lg mx-auto relative">
        <div class="relative">
          <input
            type="text"
            id="search"
            placeholder="Search through reading notes..."
            class="w-full px-4 py-3 bg-white border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent text-gray-700 shadow-sm"
            autocomplete="off"
          />
          <div class="absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-400">
            <kbd class="px-2 py-1 bg-gray-100 rounded text-xs font-mono">⌘K</kbd>
          </div>
        </div>
        
        <!-- Search Results Dropdown -->
        <div 
          id="search-results" 
          class="absolute top-full left-0 right-0 mt-2 bg-white border border-gray-200 rounded-lg shadow-xl max-h-96 overflow-y-auto z-50 hidden"
        >
          <div class="px-4 py-2 text-sm text-gray-500 border-b border-gray-100 bg-gray-50">
            <span id="results-count"></span>
          </div>
          <div id="results-list"></div>
        </div>
      </div>
      
      <!-- Random Note Button -->
      <div class="text-center mt-4">
        <a href={`/reading/${random.slug}`}>
          <button class="inline-flex items-center px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition-colors font-medium text-sm shadow-sm">
            <span class="mr-2">🎲</span>
            Surprise Me
          </button>
        </a>
      </div>
    </div>
    
    <!-- Notes List (hidden when searching) -->
    <div id="notes-list" class="max-w-xl mx-auto">
      <h2 class="text-xl font-light text-gray-800 mb-4">Recent Reading ({sorted.length} of {reading.length})</h2>
      <ul class="text-left space-y-2">
        {sorted.map(note => (
          <li key={note.slug} class="flex items-center justify-between group">
            <div class="flex-1">
              <a 
                href={`/reading/${note.slug}`} 
                class="text-blue-600 hover:underline font-medium block"
              >
                {note.data.title || note.slug}
              </a>
              {note.data.author && note.data.author !== null && (
                <div class="text-sm text-gray-500 mt-1">by {note.data.author}</div>
              )}
            </div>
            <div class="flex items-center gap-2">
              {note.data.readDate && (
                <span class="text-xs text-gray-400 font-mono">
                  {typeof note.data.readDate === 'string' 
                    ? note.data.readDate 
                    : new Date(note.data.readDate).toLocaleDateString()
                  }
                </span>
              )}
              {backlinkCounts[note.slug] && (
                <span class="text-xs text-gray-500 bg-gray-100 px-2 py-1 rounded-full">
                  {backlinkCounts[note.slug]} links
                </span>
              )}
            </div>
          </li>
        ))}
      </ul>
      {reading.length > 20 && (
        <div class="mt-4 text-center">
          <p class="text-sm text-gray-500">
            Showing 20 most recent notes. Use search to find older notes.
          </p>
        </div>
      )}
    </div>
  </section>
</Layout>

<!-- Live Search Functionality -->
<script type="module" define:vars={{ reading, backlinkCounts }}>
  import Fuse from 'https://cdn.jsdelivr.net/npm/fuse.js@6.6.2/+esm';
  
  document.addEventListener('DOMContentLoaded', () => {
    const input = document.getElementById('search');
    const resultsContainer = document.getElementById('search-results');
    const resultsList = document.getElementById('results-list');
    const resultsCount = document.getElementById('results-count');
    const notesList = document.getElementById('notes-list');
    
    // Process reading data directly from Astro variables
    const processedReading = reading.map(n => ({
      title: n.data.title || n.slug,
      slug: n.slug,
      author: n.data.author || '',
      source: n.data.source || '',
      tags: n.data.tags || [],
      backlinks: backlinkCounts[n.slug] || 0,
      preview: n.body.replace(/\[\[.*?\]\]/g, '').substring(0, 100).trim()
    }));
    
    if (!processedReading || processedReading.length === 0) {
      console.error('No reading notes found');
      return;
    }
    
    // Configure Fuse.js for better search
    const fuse = new Fuse(processedReading, {
      keys: [
        { name: 'title', weight: 0.7 },
        { name: 'author', weight: 0.2 },
        { name: 'tags', weight: 0.1 }
      ],
      threshold: 0.4,
      includeScore: true,
      includeMatches: true
    });
    
    let selectedIndex = -1;
    let currentResults = [];
    
    // Search function
    function performSearch(query) {
      if (!query.trim()) {
        hideResults();
        return;
      }
      
      const searchResults = fuse.search(query);
      currentResults = searchResults.map(r => r.item);
      selectedIndex = -1;
      
      if (currentResults.length > 0) {
        showResults(searchResults);
      } else {
        showNoResults(query);
      }
    }
    
    // Show search results
    function showResults(searchResults) {
      const maxResults = 8;
      const limitedResults = searchResults.slice(0, maxResults);
      
      resultsCount.textContent = `${currentResults.length} note${currentResults.length === 1 ? '' : 's'} found`;
      
      resultsList.innerHTML = limitedResults.map((result, index) => {
        const note = result.item;
        const score = (1 - result.score) * 100;
        
        // Highlight matches in title
        let highlightedTitle = note.title;
        if (result.matches) {
          const titleMatch = result.matches.find(m => m.key === 'title');
          if (titleMatch && titleMatch.indices) {
            highlightedTitle = highlightText(note.title, titleMatch.indices);
          }
        }
        
        return `
          <div class="search-result-item p-3 hover:bg-blue-50 cursor-pointer border-b border-gray-100 last:border-b-0 transition-colors" data-index="${index}">
            <div class="flex items-center justify-between">
              <div class="flex-1">
                <div class="font-medium text-gray-900">${highlightedTitle}</div>
                ${note.author ? `<div class="text-sm text-gray-600 mt-1">by ${note.author}</div>` : ''}
                ${note.preview ? `<div class="text-sm text-gray-600 mt-1 truncate">${note.preview}...</div>` : ''}
                ${note.tags.length > 0 ? `<div class="text-xs text-blue-600 mt-1">#${note.tags.join(' #')}</div>` : ''}
              </div>
              <div class="text-right text-xs text-gray-400 ml-4">
                ${note.backlinks > 0 ? `<div>${note.backlinks} links</div>` : ''}
                <div>${Math.round(score)}% match</div>
              </div>
            </div>
          </div>
        `;
      }).join('');
      
      if (searchResults.length > maxResults) {
        resultsList.innerHTML += `
          <div class="p-3 text-center text-sm text-gray-500 border-t">
            ... and ${searchResults.length - maxResults} more results
          </div>
        `;
      }
      
      resultsContainer.classList.remove('hidden');
      notesList.classList.add('hidden');
    }
    
    // Show no results message
    function showNoResults(query) {
      resultsCount.textContent = 'No notes found';
      resultsList.innerHTML = `
        <div class="p-4 text-center text-gray-500">
          <div class="text-lg">🔍</div>
          <div class="mt-2">No reading notes found for "${query}"</div>
          <div class="text-sm mt-1">Try a different search term</div>
        </div>
      `;
      resultsContainer.classList.remove('hidden');
      notesList.classList.add('hidden');
    }
    
    // Hide search results
    function hideResults() {
      resultsContainer.classList.add('hidden');
      notesList.classList.remove('hidden');
      selectedIndex = -1;
    }
    
    // Highlight text matches
    function highlightText(text, indices) {
      let result = '';
      let lastIndex = 0;
      
      indices.forEach(([start, end]) => {
        result += text.slice(lastIndex, start);
        result += `<mark class="bg-yellow-200 px-1 rounded">${text.slice(start, end + 1)}</mark>`;
        lastIndex = end + 1;
      });
      
      result += text.slice(lastIndex);
      return result;
    }
    
    // Navigate to selected result
    function selectResult(index) {
      if (currentResults[index]) {
        window.location.href = `/reading/${currentResults[index].slug}`;
      }
    }
    
    // Update visual selection
    function updateSelection() {
      const items = document.querySelectorAll('.search-result-item');
      items.forEach((item, index) => {
        if (index === selectedIndex) {
          item.classList.add('bg-blue-100');
          item.scrollIntoView({ block: 'nearest' });
        } else {
          item.classList.remove('bg-blue-100');
        }
      });
    }
    
    // Event listeners
    input.addEventListener('input', (e) => {
      performSearch(e.target.value);
    });
    
    // Keyboard navigation
    input.addEventListener('keydown', (e) => {
      if (!resultsContainer.classList.contains('hidden')) {
        switch (e.key) {
          case 'ArrowDown':
            e.preventDefault();
            selectedIndex = Math.min(selectedIndex + 1, currentResults.length - 1);
            updateSelection();
            break;
          case 'ArrowUp':
            e.preventDefault();
            selectedIndex = Math.max(selectedIndex - 1, -1);
            updateSelection();
            break;
          case 'Enter':
            e.preventDefault();
            if (selectedIndex >= 0) {
              selectResult(selectedIndex);
            } else if (currentResults.length > 0) {
              selectResult(0);
            }
            break;
          case 'Escape':
            hideResults();
            input.blur();
            break;
        }
      }
    });
    
    // Click on search results
    resultsList.addEventListener('click', (e) => {
      const item = e.target.closest('.search-result-item');
      if (item) {
        const index = parseInt(item.dataset.index);
        selectResult(index);
      }
    });
    
    // Click outside to close
    document.addEventListener('click', (e) => {
      if (!e.target.closest('#search') && !e.target.closest('#search-results')) {
        hideResults();
      }
    });
    
    // Global keyboard shortcut (Cmd+K or Ctrl+K)
    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        input.focus();
        input.select();
      }
    });
    
    // Focus search on page load
    input.focus();
  });
</script>

<style>
  /* Custom scrollbar for search results */
  #search-results {
    scrollbar-width: thin;
    scrollbar-color: #cbd5e0 #f7fafc;
  }
  
  #search-results::-webkit-scrollbar {
    width: 6px;
  }
  
  #search-results::-webkit-scrollbar-track {
    background: #f7fafc;
  }
  
  #search-results::-webkit-scrollbar-thumb {
    background-color: #cbd5e0;
    border-radius: 3px;
  }
  
  /* Smooth transitions */
  .search-result-item {
    transition: background-color 0.15s ease;
  }
  
  /* Search input focus state */
  #search:focus {
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
  }
</style>