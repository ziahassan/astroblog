---
import Layout from '../../layouts/layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => data.draft !== true);
  return posts.map(post => ({ params: { slug: post.slug } }));
}

const { slug } = Astro.params;
const posts = await getCollection('blog');
const post = posts.find(p => p.slug === slug);

if (!post) throw new Error(`Post "${slug}" not found`);

const { Content } = await post.render();
const { data } = post;
---

<Layout title={data.title}>
  <article class="max-w-2xl mx-auto px-6 py-16" data-pagefind-body>

    <a href="/blog" class="text-xs text-gray-400 hover:text-violet-600 transition-colors tracking-wide uppercase font-medium" data-pagefind-ignore>
      ← All posts
    </a>

    {data.image && (
      <div class="mt-8 -mx-6 sm:mx-0 sm:rounded-xl overflow-hidden" style="max-height: 420px;">
        <img
          src={data.image}
          alt=""
          class="w-full object-cover"
          style="max-height: 420px;"
        />
      </div>
    )}

    <header class={`mb-12 ${data.image ? 'mt-8' : 'mt-10'}`}>
      <h1
        class="text-4xl font-light text-indigo-950 leading-tight mb-6"
        style="font-family: 'Crimson Text', Georgia, serif;"
        data-pagefind-meta="title"
      >
        {data.title}
      </h1>

      {data.description && (
        <p class="text-lg text-slate-500 leading-relaxed mb-6" style="font-family: 'Crimson Text', Georgia, serif;">
          {data.description}
        </p>
      )}

      <div class="flex items-center gap-4 text-sm pt-6 border-t border-gray-100">
        <time class="text-amber-500 font-mono font-medium text-xs">
          {new Date(data.publishDate).toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })}
        </time>
        {data.tags && data.tags.length > 0 && (
          <div class="flex flex-wrap gap-1.5">
            {data.tags.map(tag => (
              <span class="px-2 py-0.5 bg-violet-50 text-violet-500 border border-violet-100 text-xs rounded">
                {tag}
              </span>
            ))}
          </div>
        )}
      </div>
    </header>

    <div class="prose">
      <Content />
    </div>

    <footer class="mt-16 pt-8 border-t border-gray-100">
      <a href="/blog" class="text-sm text-violet-500 hover:text-violet-700 transition-colors font-medium">
        ← Back to all posts
      </a>
    </footer>

  </article>
</Layout>

<style>
  .prose {
    font-family: 'Crimson Text', Georgia, serif;
    font-size: 1.2rem;
    line-height: 1.8;
    color: #374151;
  }

  .prose p {
    margin-bottom: 1.5em;
  }

  .prose h2 {
    font-family: 'Crimson Text', Georgia, serif;
    font-size: 1.6rem;
    font-weight: 400;
    color: #1e1b4b;
    margin-top: 2.5em;
    margin-bottom: 0.75em;
    padding-bottom: 0.4em;
    border-bottom: 1px solid #f3f4f6;
  }

  .prose h3 {
    font-family: 'Crimson Text', Georgia, serif;
    font-size: 1.3rem;
    font-weight: 600;
    color: #1e1b4b;
    margin-top: 2em;
    margin-bottom: 0.5em;
  }

  .prose ul, .prose ol {
    margin: 1.2em 0;
    padding-left: 1.5em;
  }

  .prose li {
    margin-bottom: 0.4em;
  }

  .prose blockquote {
    border-left: 3px solid #ddd6fe;
    padding-left: 1.2em;
    margin: 2em 0;
    color: #6b7280;
    font-style: italic;
  }

  .prose a {
    color: #7c3aed;
    text-decoration: underline;
    text-decoration-color: #ddd6fe;
    text-underline-offset: 2px;
    transition: color 0.15s, text-decoration-color 0.15s;
  }

  .prose a:hover {
    color: #4c1d95;
    text-decoration-color: #7c3aed;
  }

  .prose code {
    background: #f5f3ff;
    color: #5b21b6;
    padding: 0.15em 0.4em;
    border-radius: 4px;
    font-size: 0.85em;
    font-family: ui-monospace, monospace;
  }

  .prose pre {
    background: #1e1b4b;
    color: #e0e7ff;
    padding: 1.25em 1.5em;
    border-radius: 8px;
    overflow-x: auto;
    margin: 1.8em 0;
    font-size: 0.85rem;
    line-height: 1.6;
  }

  .prose pre code {
    background: none;
    color: inherit;
    padding: 0;
    font-size: inherit;
  }

  .prose hr {
    border: none;
    border-top: 1px solid #f3f4f6;
    margin: 2.5em 0;
  }

  .prose strong {
    font-weight: 600;
    color: #1f2937;
  }

  .prose em {
    font-style: italic;
  }
</style>
