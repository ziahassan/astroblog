---
import Layout from '../../layouts/layout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog', ({ data }) => data.draft !== true);

const sorted = posts.sort((a, b) =>
  new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime()
);

const tagCounts: Record<string, number> = {};
posts.forEach(post => {
  (post.data.tags || []).forEach(tag => {
    tagCounts[tag] = (tagCounts[tag] || 0) + 1;
  });
});
const sortedTags = Object.entries(tagCounts).sort(([,a],[,b]) => b - a);
---

<Layout title="Blog">
  <div class="max-w-3xl mx-auto px-4">

    <header class="py-8 border-b border-gray-200">
      <div class="flex items-baseline justify-between">
        <h1 class="text-3xl font-light text-gray-800">Blog</h1>
        <span class="text-sm text-gray-500">{posts.length} post{posts.length !== 1 ? 's' : ''}</span>
      </div>
      <p class="text-gray-500 mt-2">Informal writing on education, AI, and whatever else is on my mind.</p>
    </header>

    {sortedTags.length > 0 && (
      <div class="py-4 flex flex-wrap gap-2 border-b border-gray-100">
        <button class="tag-filter active px-3 py-1 text-xs font-medium rounded-full bg-gray-900 text-white" data-tag="all">
          All
        </button>
        {sortedTags.map(([tag, count]) => (
          <button
            class="tag-filter px-3 py-1 text-xs font-medium rounded-full bg-gray-100 text-gray-600 hover:bg-gray-200 transition-colors"
            data-tag={tag}
          >
            {tag} <span class="text-gray-400">{count}</span>
          </button>
        ))}
      </div>
    )}

    <div class="py-6 space-y-1" id="posts-list">
      {sorted.map(post => {
        const tags = post.data.tags || [];
        return (
          <div
            class="post-item group flex items-baseline gap-4 py-3 px-3 -mx-3 rounded-lg hover:bg-gray-50 transition-colors"
            data-tags={JSON.stringify(tags)}
          >
            <time class="flex-shrink-0 text-xs text-gray-400 font-mono w-24">
              {new Date(post.data.publishDate).toLocaleDateString('en-US', {
                month: 'short',
                day: 'numeric',
                year: 'numeric',
              })}
            </time>
            <div class="flex-1 min-w-0">
              <a
                href={`/blog/${post.slug}`}
                class="text-gray-800 hover:text-blue-600 transition-colors font-medium"
              >
                {post.data.title}
              </a>
              {post.data.description && (
                <p class="text-sm text-gray-500 mt-0.5 truncate">{post.data.description}</p>
              )}
            </div>
            {tags.length > 0 && (
              <div class="hidden sm:flex gap-1 flex-shrink-0">
                {tags.slice(0, 2).map(tag => (
                  <span class="px-2 py-0.5 bg-gray-100 text-gray-400 text-xs rounded">
                    {tag}
                  </span>
                ))}
              </div>
            )}
          </div>
        );
      })}

      {posts.length === 0 && (
        <div class="py-16 text-center text-gray-400">
          <p>No posts yet.</p>
        </div>
      )}
    </div>

    <div id="empty-state" class="hidden py-12 text-center text-gray-400">
      <p>No posts match this filter.</p>
    </div>

  </div>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const filters = document.querySelectorAll('.tag-filter');
    const items = document.querySelectorAll('.post-item');
    const emptyState = document.getElementById('empty-state');
    const postsList = document.getElementById('posts-list');

    filters.forEach(btn => {
      btn.addEventListener('click', () => {
        const tag = (btn as HTMLElement).dataset.tag;

        filters.forEach(b => {
          b.classList.remove('active', 'bg-gray-900', 'text-white');
          b.classList.add('bg-gray-100', 'text-gray-600');
        });
        btn.classList.add('active', 'bg-gray-900', 'text-white');
        btn.classList.remove('bg-gray-100', 'text-gray-600');

        let visible = 0;
        items.forEach(item => {
          const tags = JSON.parse((item as HTMLElement).dataset.tags || '[]');
          const show = tag === 'all' || tags.includes(tag);
          (item as HTMLElement).style.display = show ? '' : 'none';
          if (show) visible++;
        });

        emptyState?.classList.toggle('hidden', visible > 0);
        postsList?.classList.toggle('hidden', visible === 0);
      });
    });
  });
</script>
