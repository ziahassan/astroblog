---
import Layout from '../../layouts/layout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog', ({ data }) => data.draft !== true);

const sorted = posts.sort((a, b) =>
  new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime()
);

const tagCounts: Record<string, number> = {};
posts.forEach(post => {
  (post.data.tags || []).forEach(tag => {
    tagCounts[tag] = (tagCounts[tag] || 0) + 1;
  });
});
const sortedTags = Object.entries(tagCounts).sort(([,a],[,b]) => b - a);
---

<Layout title="Blog">
  <div class="max-w-3xl mx-auto px-6 py-10">

    <header class="pb-8 border-b border-gray-100">
      <div class="flex items-baseline justify-between">
        <h1 class="text-3xl font-light text-indigo-950" style="font-family: 'Crimson Text', Georgia, serif;">Blog</h1>
        <span class="text-sm text-gray-400" id="post-count">{posts.length} posts</span>
      </div>
      <p class="text-gray-500 mt-2">Informal writing on education, AI, and whatever else is on my mind.</p>
      <div id="pagefind-search" class="mt-4"></div>
    </header>

    {sortedTags.length > 0 && (
      <div class="py-4 flex flex-wrap gap-2 border-b border-gray-100">
        <button class="tag-filter active px-3 py-1 text-xs font-medium rounded-full bg-violet-600 text-white" data-tag="all">
          All
        </button>
        {sortedTags.map(([tag, count]) => (
          <button
            class="tag-filter px-3 py-1 text-xs font-medium rounded-full bg-violet-50 text-violet-600 border border-violet-100 hover:bg-violet-100 transition-colors"
            data-tag={tag}
          >
            {tag} <span class="text-violet-400">{count}</span>
          </button>
        ))}
      </div>
    )}

    <div class="py-6 space-y-1" id="posts-list">
      {sorted.map(post => {
        const tags = post.data.tags || [];
        return (
          <div
            class="post-item group flex items-center gap-4 py-3 px-3 -mx-3 rounded-lg hover:bg-violet-50 transition-colors"
            data-tags={JSON.stringify(tags)}
          >
            <time class="flex-shrink-0 text-xs text-amber-500 font-mono w-24">
              {new Date(post.data.publishDate).toLocaleDateString('en-US', {
                month: 'short',
                day: 'numeric',
                year: 'numeric',
              })}
            </time>
            <div class="flex-1 min-w-0">
              <a
                href={`/blog/${post.slug}`}
                class="text-gray-800 hover:text-violet-700 transition-colors font-medium"
              >
                {post.data.title}
              </a>
              {post.data.description && (
                <p class="text-sm text-gray-500 mt-0.5 truncate">{post.data.description}</p>
              )}
            </div>
            {tags.length > 0 && (
              <div class="hidden sm:flex gap-1 flex-shrink-0">
                {tags.slice(0, 2).map(tag => (
                  <span class="px-2 py-0.5 bg-violet-50 text-violet-400 border border-violet-100 text-xs rounded">
                    {tag}
                  </span>
                ))}
              </div>
            )}
            {post.data.image && (
              <img
                src={post.data.image}
                alt=""
                class="flex-shrink-0 w-14 h-14 object-cover rounded-lg border border-gray-100"
              />
            )}
          </div>
        );
      })}

      {posts.length === 0 && (
        <div class="py-16 text-center text-gray-400">
          <p>No posts yet.</p>
        </div>
      )}
    </div>

    <div id="empty-state" class="hidden py-12 text-center text-gray-400">
      <p>No posts match this filter.</p>
    </div>

  </div>
</Layout>

<link rel="stylesheet" href="/pagefind/pagefind-ui.css" />

<script is:inline>
  window.addEventListener('DOMContentLoaded', async () => {
    try {
      await import('/pagefind/pagefind-ui.js');
      new PagefindUI({
        element: '#pagefind-search',
        showSubResults: false,
        showImages: false,
        resetStyles: false,
        excerptLength: 20,
      });
    } catch {
      document.getElementById('pagefind-search').innerHTML =
        '<input disabled placeholder="Search (run npm run build to enable)" class="w-full px-4 py-2 bg-gray-50 border border-gray-200 rounded-lg text-sm text-gray-400 cursor-not-allowed" />';
    }
  });
</script>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const filters = document.querySelectorAll('.tag-filter');
    const items = document.querySelectorAll<HTMLElement>('.post-item');
    const emptyState = document.getElementById('empty-state');
    const postsList = document.getElementById('posts-list');

    filters.forEach(btn => {
      btn.addEventListener('click', () => {
        const tag = (btn as HTMLElement).dataset.tag || 'all';
        filters.forEach(b => {
          b.classList.remove('active', 'bg-violet-600', 'text-white');
          b.classList.add('bg-violet-50', 'text-violet-600');
        });
        btn.classList.add('active', 'bg-violet-600', 'text-white');
        btn.classList.remove('bg-violet-50', 'text-violet-600');

        let visible = 0;
        items.forEach(item => {
          const tags = JSON.parse((item as HTMLElement).dataset.tags || '[]');
          const show = tag === 'all' || tags.includes(tag);
          (item as HTMLElement).style.display = show ? '' : 'none';
          if (show) visible++;
        });
        emptyState?.classList.toggle('hidden', visible > 0);
        postsList?.classList.toggle('hidden', visible === 0);
      });
    });
  });
</script>
