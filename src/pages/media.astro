---
import Layout from '../layouts/layout.astro';
import { getCollection } from 'astro:content';

const appearances = await getCollection('guestAppearances');

const sorted = appearances.sort((a, b) =>
  new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime()
);

const typeLabel: Record<string, string> = {
  podcast: 'Podcast',
  interview: 'Interview',
  talk: 'Talk',
  video: 'Video',
};

const typeColors: Record<string, string> = {
  podcast: 'bg-amber-50 text-amber-700 border-amber-200',
  interview: 'bg-purple-50 text-purple-700 border-purple-200',
  talk: 'bg-blue-50 text-blue-700 border-blue-200',
  video: 'bg-red-50 text-red-700 border-red-200',
};

const types = [...new Set(sorted.map(a => a.data.type))];
---

<Layout title="Media">
  <div class="max-w-3xl mx-auto px-4">

    <header class="py-8 border-b border-gray-200">
      <div class="flex items-baseline justify-between">
        <h1 class="text-3xl font-light text-gray-800">Media</h1>
        <span class="text-sm text-gray-500">{appearances.length} appearance{appearances.length !== 1 ? 's' : ''}</span>
      </div>
      <p class="text-gray-500 mt-2">Podcasts, talks, interviews, and other appearances.</p>
    </header>

    {types.length > 1 && (
      <div class="py-4 flex flex-wrap gap-2 border-b border-gray-100">
        <button class="type-filter active px-3 py-1 text-xs font-medium rounded-full bg-gray-900 text-white" data-type="all">
          All
        </button>
        {types.map(type => (
          <button
            class="type-filter px-3 py-1 text-xs font-medium rounded-full bg-gray-100 text-gray-600 hover:bg-gray-200 transition-colors"
            data-type={type}
          >
            {typeLabel[type]}
          </button>
        ))}
      </div>
    )}

    <div class="py-6 space-y-4" id="appearances-list">
      {sorted.map(item => (
        <article
          class="appearance-item border border-gray-200 rounded-lg p-5 hover:border-gray-300 transition-colors"
          data-type={item.data.type}
        >
          <div class="flex items-start justify-between gap-4 mb-2">
            <div class="flex-1 min-w-0">
              <h2 class="text-base font-medium text-gray-900 leading-snug">
                <a href={item.data.url} target="_blank" rel="noopener noreferrer" class="hover:text-blue-600 transition-colors">
                  {item.data.title}
                </a>
              </h2>
              <p class="text-sm text-gray-500 mt-0.5">
                {item.data.show}
                {item.data.duration && <> &middot; {item.data.duration}</>}
              </p>
            </div>
            <div class="flex flex-col items-end gap-1.5 flex-shrink-0">
              <span class={`text-xs font-medium px-2 py-0.5 rounded border ${typeColors[item.data.type]}`}>
                {typeLabel[item.data.type]}
              </span>
              <time class="text-xs text-gray-400 font-mono">
                {new Date(item.data.publishDate).toLocaleDateString('en-US', {
                  month: 'short',
                  year: 'numeric',
                })}
              </time>
            </div>
          </div>

          {item.data.description && (
            <p class="text-sm text-gray-600 leading-relaxed mt-2">{item.data.description}</p>
          )}

          {item.data.embedUrl && (
            <div class="mt-4 aspect-video rounded overflow-hidden bg-gray-100">
              <iframe
                src={item.data.embedUrl}
                class="w-full h-full"
                frameborder="0"
                allowfullscreen
                loading="lazy"
              />
            </div>
          )}
        </article>
      ))}

      {appearances.length === 0 && (
        <div class="py-16 text-center text-gray-400">
          <p>No appearances yet.</p>
        </div>
      )}
    </div>

    <div id="empty-state" class="hidden py-12 text-center text-gray-400">
      <p>No appearances match this filter.</p>
    </div>

  </div>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const filters = document.querySelectorAll('.type-filter');
    const items = document.querySelectorAll('.appearance-item');
    const emptyState = document.getElementById('empty-state');
    const list = document.getElementById('appearances-list');

    filters.forEach(btn => {
      btn.addEventListener('click', () => {
        const type = (btn as HTMLElement).dataset.type;

        filters.forEach(b => {
          b.classList.remove('active', 'bg-gray-900', 'text-white');
          b.classList.add('bg-gray-100', 'text-gray-600');
        });
        btn.classList.add('active', 'bg-gray-900', 'text-white');
        btn.classList.remove('bg-gray-100', 'text-gray-600');

        let visible = 0;
        items.forEach(item => {
          const show = type === 'all' || (item as HTMLElement).dataset.type === type;
          (item as HTMLElement).style.display = show ? '' : 'none';
          if (show) visible++;
        });

        emptyState?.classList.toggle('hidden', visible > 0);
        list?.classList.toggle('hidden', visible === 0);
      });
    });
  });
</script>
