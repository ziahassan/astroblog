---
import Layout from '../../layouts/layout.astro';
import fs from 'node:fs';
import path from 'node:path';

const presentationsDir = path.join(process.cwd(), 'public/presentations');

function extractTitle(html: string, fallback: string): string {
  const sections = html.match(/<section[^>]*>([\s\S]*?)<\/section>/i);
  if (sections) {
    const heading = sections[1].match(/<h[1-3][^>]*>([\s\S]*?)<\/h[1-3]>/i);
    if (heading) {
      return heading[1].replace(/<[^>]+>/g, '').trim();
    }
  }
  return fallback;
}

interface Presentation {
  name: string;
  title: string;
  url: string;
}

const presentations: Presentation[] = [];

if (fs.existsSync(presentationsDir)) {
  const folders = fs.readdirSync(presentationsDir, { withFileTypes: true })
    .filter(d => d.isDirectory())
    .map(d => d.name);

  for (const folder of folders) {
    const folderPath = path.join(presentationsDir, folder);
    const contents = fs.readdirSync(folderPath);

    const htmlFile = contents.find(f => f === 'index.html' || f === 'index.htm');
    if (!htmlFile) continue;

    const html = fs.readFileSync(path.join(folderPath, htmlFile), 'utf8');
    presentations.push({
      name: folder,
      title: extractTitle(html, folder),
      url: `/presentations/${folder}/${htmlFile}`,
    });
  }
}

presentations.sort((a, b) => a.title.localeCompare(b.title));
---

<Layout title="Teaching">
  <div class="max-w-3xl mx-auto px-6 py-10">

    <header class="pb-8 border-b border-gray-100">
      <div class="flex items-baseline justify-between">
        <h1 class="text-3xl font-light text-indigo-950" style="font-family: 'Crimson Text', Georgia, serif;">Teaching</h1>
        <span class="text-sm text-gray-400">{presentations.length} presentation{presentations.length !== 1 ? 's' : ''}</span>
      </div>
      <p class="text-gray-500 mt-2">Slides and workshop materials.</p>
    </header>

    <div class="py-6 space-y-0.5">
      {presentations.map(p => (
        <a
          href={p.url}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-3 py-3 px-3 -mx-3 rounded-lg hover:bg-violet-50 transition-colors group"
        >
          <span class="text-violet-200 text-sm group-hover:text-violet-500 transition-colors">▶</span>
          <span class="text-gray-800 group-hover:text-violet-700 transition-colors">{p.title}</span>
        </a>
      ))}

      {presentations.length === 0 && (
        <p class="py-16 text-center text-gray-400">No presentations yet.</p>
      )}
    </div>

  </div>
</Layout>
