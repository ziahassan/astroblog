---
import Layout from '../../layouts/layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  return notes.map(note => ({ params: { slug: note.slug } }));
}

const { slug } = Astro.params;
const allNotes = await getCollection('notes');

// Find the note
const note = allNotes.find(n => n.slug === slug);
if (!note) {
  throw new Error(`Note "${slug}" not found`);
}

// Create mappings for both directions
const titleToSlug = {};
const slugToTitle = {};
allNotes.forEach(n => {
  const title = n?.data?.title ?? n.slug;
  if (title) {
    titleToSlug[title] = n.slug;
    slugToTitle[n.slug] = title;
  }
});

const { Content } = await note.render();
const { data } = note;
const displayTitle = data?.title || slug;

// Get backlinks - now looking for both [[title]] and [[slug]] patterns
const backlinks = allNotes.filter(n => {
  const body = typeof n?.body === 'string' ? n.body : '';
  if (!body) return false;
  const titlePattern = data?.title ? `[[${data.title}]]` : null;
  const slugPattern = `[[${slug}]]`;
  return (titlePattern && body.includes(titlePattern)) || body.includes(slugPattern);
});

// Count backlinks by both title and slug patterns
const backlinkCounts = {};
for (const sourceNote of allNotes) {
  for (const targetNote of allNotes) {
    // Check for both [[title]] and [[slug]] patterns
    const targetTitle = targetNote?.data?.title ?? targetNote.slug;
    const titlePattern = targetTitle ? `[[${targetTitle}]]` : null;
    const slugPattern = `[[${targetNote.slug}]]`;
    
    const sourceBody = typeof sourceNote?.body === 'string' ? sourceNote.body : '';
    if (!sourceBody) continue;

    if ((titlePattern && sourceBody.includes(titlePattern)) || sourceBody.includes(slugPattern)) {
      const key = targetTitle || targetNote.slug;
      backlinkCounts[key] = (backlinkCounts[key] || 0) + 1;
    }
  }
}
---

<Layout title={displayTitle}>
  <!-- Compact Academic Search Bar -->
  <div class="fixed top-20 right-6 z-40">
    <div class="relative">
      <input
        type="text"
        id="quick-search"
        placeholder="Search notes..."
        class="w-60 px-3 py-2 text-sm bg-white/95 backdrop-blur border border-gray-300 rounded-md shadow-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200"
        autocomplete="off"
      />
      <div class="absolute right-2 top-1/2 transform -translate-y-1/2 text-gray-400 text-xs">
        <kbd class="px-1.5 py-0.5 bg-gray-100 rounded text-xs font-mono">⌘K</kbd>
      </div>
    </div>
    
    <!-- Quick Search Results -->
    <div 
      id="quick-search-results" 
      class="absolute top-full right-0 mt-2 w-80 bg-white border border-gray-200 rounded-lg shadow-xl max-h-64 overflow-y-auto z-40 hidden"
    >
      <div class="px-3 py-2 text-xs text-gray-500 border-b border-gray-100 bg-gray-50 font-medium" id="quick-results-count"></div>
      <div id="quick-results-list"></div>
    </div>
  </div>

  <!-- Main Article Content -->
  <article class="max-w-4xl mx-auto">
    <!-- Article Header -->
    <header class="mb-8 pb-6 border-b border-gray-200">
      <h1 class="text-4xl font-light text-gray-800 mb-3">{displayTitle}</h1>
      <div class="flex items-center gap-4 text-sm text-gray-600">
        {data.publishDate && (
          <span class="font-mono">{new Date(data.publishDate).toLocaleDateString('en-US', { 
            year: 'numeric', 
            month: 'long', 
            day: 'numeric' 
          })}</span>
        )}
        {data.tags && data.tags.length > 0 && (
          <div class="flex flex-wrap gap-1">
            {data.tags.map(tag => (
              <span class="inline-block px-2 py-1 bg-blue-50 text-blue-600 text-xs rounded-md font-medium">
                {tag}
              </span>
            ))}
          </div>
        )}
      </div>
    </header>
    
    <!-- Article Body -->
    <div class="wiki-content prose prose-lg prose-gray max-w-none leading-relaxed">
      <Content />
    </div>
    
    <!-- Local Graph Visualization -->
    <section class="mt-12 pt-8 border-t border-gray-200">
      <h2 class="text-2xl font-light text-gray-800 mb-4 flex items-center gap-2">
        <span>🕸️</span>
        Local Graph
      </h2>
      <div id="note-graph" class="w-full h-96 bg-gray-50 rounded-lg border border-gray-200"></div>
    </section>
    
    <!-- Backlinks Section -->
    {backlinks.length > 0 && (
      <section class="mt-12 pt-8 border-t border-gray-200">
        <h2 class="text-2xl font-light text-gray-800 mb-4 flex items-center gap-2">
          <span>🔗</span>
          Referenced by
        </h2>
        <div class="grid gap-3">
          {backlinks.map(link => (
            <div key={link.slug} class="p-4 bg-gray-50 rounded-lg border border-gray-200 hover:border-gray-300 transition-colors">
              <a href={`/notes/${link.slug}`} class="text-lg font-medium text-gray-900 hover:text-blue-600 transition-colors">
                {link.data.title || link.slug}
                {backlinkCounts[link.data.title] && (
                  <span class="ml-2 text-xs text-gray-500 bg-white px-2 py-1 rounded-md">
                    {backlinkCounts[link.data.title]} reference{backlinkCounts[link.data.title] > 1 ? 's' : ''}
                  </span>
                )}
              </a>
            </div>
          ))}
        </div>
      </section>
    )}
  </article>
</Layout>

<script define:vars={{ titleToSlug, slugToTitle, backlinkCounts }}>
  // Process internal links to show titles instead of slugs
  function processInternalLinks() {
    const content = document.querySelector('.wiki-content');
    if (!content) {
      console.log('No .wiki-content element found');
      return;
    }
    
    console.log('Processing internal links...');
    console.log('slugToTitle:', slugToTitle);
    console.log('backlinkCounts:', backlinkCounts);
    
    // Find all internal links (the ones Astro already created from [[]] syntax)
    const internalLinks = content.querySelectorAll('a.internal');
    console.log('Found internal links:', internalLinks.length);
    
    internalLinks.forEach(link => {
      const href = link.getAttribute('href');
      console.log('Processing link with href:', href);
      
      // Extract slug from href like "/notes/deep-work"
      const match = href.match(/\/notes\/(.+)$/);
      if (match) {
        const slug = match[1];
        const title = slugToTitle[slug];
        
        console.log('Slug:', slug, 'Title:', title);
        
        if (title) {
          // Update the link text to show the title instead of the slug
          link.textContent = title;
          
          // Add backlink count if it exists
          const backlinkCount = backlinkCounts[title];
          console.log('Looking for backlinks for title:', title, 'Found:', backlinkCount);
          console.log('All available backlink counts:', Object.keys(backlinkCounts));
          
          if (backlinkCount && backlinkCount > 0) {
            const sup = document.createElement('sup');
            sup.className = 'text-xs text-gray-500 ml-1';
            sup.textContent = backlinkCount;
            link.appendChild(sup);
            console.log('Added backlink count:', backlinkCount);
          } else {
            console.log('No backlink count found or count is 0');
          }
          
          // Update the classes to match our styling
          link.className = 'wiki-link text-blue-600 hover:underline font-medium';
          console.log('Updated link text to:', title);
        }
      }
    });
  }
  
  // Run when the page loads
  document.addEventListener('DOMContentLoaded', processInternalLinks);
</script>

<!-- Local Graph Visualization -->
<script define:vars={{ allNotes, data, slug, backlinks, displayTitle }}>
  document.addEventListener('DOMContentLoaded', () => {
    console.log('Starting graph creation...');
    console.log('Current note:', { slug, title: displayTitle });
    console.log('All notes:', allNotes.length);
    console.log('Backlinks:', backlinks.length);
    
    // Load D3 and create graph
    loadD3AndCreateGraph();
  });
  
  async function loadD3AndCreateGraph() {
    try {
      console.log('Loading D3...');
      
      // Create script element to load D3
      const script = document.createElement('script');
      script.src = 'https://cdnjs.cloudflare.com/ajax/libs/d3/7.8.5/d3.min.js';
      script.onload = () => {
        console.log('D3 loaded successfully');
        createLocalGraph();
      };
      script.onerror = (error) => {
        console.error('Failed to load D3:', error);
        // Fallback: create a simple visualization
        createFallbackGraph();
      };
      document.head.appendChild(script);
      
    } catch (error) {
      console.error('Error loading D3:', error);
      createFallbackGraph();
    }
  }
  
  function createFallbackGraph() {
    console.log('Creating fallback graph...');
    const container = document.getElementById('note-graph');
    if (!container) return;
    
    container.innerHTML = `
      <div class="flex items-center justify-center h-full text-gray-500">
        <div class="text-center">
          <div class="text-sm mb-2">📊 Graph visualization</div>
          <div class="text-xs">Current: ${displayTitle}</div>
          ${backlinks.length > 0 ? `<div class="text-xs">Connected to ${backlinks.length} note(s)</div>` : ''}
        </div>
      </div>
    `;
  }
  
  function createLocalGraph() {
    console.log('Creating D3 graph...');
    
    if (typeof d3 === 'undefined') {
      console.error('D3 not available');
      createFallbackGraph();
      return;
    }
    
    const container = document.getElementById('note-graph');
    if (!container) {
      console.error('Graph container not found');
      return;
    }
    
    // Clear any existing content
    container.innerHTML = '';
    console.log('Container cleared');
    
    // Build graph data
    const currentNote = {
      id: slug,
      title: displayTitle,
      type: 'current',
      tags: data.tags || []
    };
    
    // Create nodes - current note + connected notes
    const nodes = [currentNote];
    const links = [];
    
    console.log('Building graph data...');
    
    // Add backlinks (notes that link TO this note)
    backlinks.forEach(note => {
      console.log('Adding backlink:', note.data.title);
      const backlinkNode = {
        id: note.slug,
        title: note.data.title || note.slug,
        type: 'backlink',
        tags: note.data.tags || []
      };
      nodes.push(backlinkNode);
      
      // Create link FROM backlink TO current note
      links.push({
        source: note.slug,
        target: slug,
        type: 'backlink'
      });
    });
    
    // Add forward links (notes this note links TO)
    allNotes.forEach(note => {
      if (note.slug !== slug) {
        const currentNoteBody = allNotes.find(n => n.slug === slug)?.body || '';
        if (currentNoteBody.includes(`[[${note.data.title}]]`) || currentNoteBody.includes(`[[${note.slug}]]`)) {
          console.log('Adding forward link:', note.data.title);
          const existingNode = nodes.find(n => n.id === note.slug);
          if (!existingNode) {
            const forwardNode = {
              id: note.slug,
              title: note.data.title || note.slug,
              type: 'forward',
              tags: note.data.tags || []
            };
            nodes.push(forwardNode);
          }
          
          // Create link FROM current note TO forward link
          links.push({
            source: slug,
            target: note.slug,
            type: 'forward'
          });
        }
      }
    });
    
    // Add shared tag connections (notes with same tags)
    if (data.tags && data.tags.length > 0) {
      allNotes.forEach(note => {
        if (note.slug !== slug && note.data.tags) {
          const sharedTags = data.tags.filter(tag => note.data.tags.includes(tag));
          if (sharedTags.length > 0) {
            const existingNode = nodes.find(n => n.id === note.slug);
            if (!existingNode && nodes.length < 15) { // Limit nodes to keep graph readable
              console.log('Adding tag-related note:', note.data.title);
              const tagNode = {
                id: note.slug,
                title: note.data.title || note.slug,
                type: 'tag-related',
                tags: note.data.tags,
                sharedTags: sharedTags
              };
              nodes.push(tagNode);
              
              // Create tag-based connection
              links.push({
                source: slug,
                target: note.slug,
                type: 'tag',
                sharedTags: sharedTags
              });
            }
          }
        }
      });
    }
    
    console.log('Final graph data:', { nodes: nodes.length, links: links.length });
    console.log('Nodes:', nodes);
    console.log('Links:', links);
    
    // If no connections, show a simple single node
    if (nodes.length === 1) {
      console.log('No connections found, showing single node');
      createSingleNodeGraph(container, currentNote);
      return;
    }
    
    // Set up SVG
    const width = container.clientWidth || 800;
    const height = 384; // h-96 = 384px
    
    console.log('Creating SVG:', { width, height });
    
    const svg = d3.select(container)
      .append('svg')
      .attr('width', width)
      .attr('height', height)
      .attr('viewBox', [0, 0, width, height]);
    
    console.log('SVG created');
    
    // Create simulation
    const simulation = d3.forceSimulation(nodes)
      .force('link', d3.forceLink(links).id(d => d.id).distance(80))
      .force('charge', d3.forceManyBody().strength(-200))
      .force('center', d3.forceCenter(width / 2, height / 2))
      .force('collision', d3.forceCollide().radius(30));
    
    console.log('Simulation created');
    
    // Create links
    const link = svg.append('g')
      .selectAll('line')
      .data(links)
      .join('line')
      .attr('stroke', d => {
        switch (d.type) {
          case 'backlink': return '#3b82f6'; // blue
          case 'forward': return '#10b981'; // green
          case 'tag': return '#f59e0b'; // amber
          default: return '#6b7280'; // gray
        }
      })
      .attr('stroke-opacity', 0.6)
      .attr('stroke-width', d => d.type === 'tag' ? 1 : 2);
    
    console.log('Links created:', links.length);
    
    // Create nodes
    const node = svg.append('g')
      .selectAll('g')
      .data(nodes)
      .join('g')
      .attr('class', 'node')
      .style('cursor', 'pointer');
    
    // Add circles to nodes
    node.append('circle')
      .attr('r', d => d.type === 'current' ? 12 : 8)
      .attr('fill', d => {
        switch (d.type) {
          case 'current': return '#1f2937'; // dark gray
          case 'backlink': return '#3b82f6'; // blue
          case 'forward': return '#10b981'; // green
          case 'tag-related': return '#f59e0b'; // amber
          default: return '#6b7280'; // gray
        }
      })
      .attr('stroke', '#fff')
      .attr('stroke-width', 2);
    
    console.log('Node circles created:', nodes.length);
    
    // Add labels to nodes
    node.append('text')
      .text(d => d.title.length > 20 ? d.title.substring(0, 20) + '...' : d.title)
      .attr('x', 0)
      .attr('y', -15)
      .attr('text-anchor', 'middle')
      .attr('font-size', '11px')
      .attr('font-family', 'system-ui, sans-serif')
      .attr('fill', '#374151')
      .attr('font-weight', d => d.type === 'current' ? 'bold' : 'normal');
    
    console.log('Node labels created');
    
    // Add click handler to navigate to notes
    node.on('click', (event, d) => {
      if (d.id !== slug) {
        window.location.href = `/notes/${d.id}`;
      }
    });
    
    // Update positions on simulation tick
    simulation.on('tick', () => {
      link
        .attr('x1', d => d.source.x)
        .attr('y1', d => d.source.y)
        .attr('x2', d => d.target.x)
        .attr('y2', d => d.target.y);
      
      node
        .attr('transform', d => `translate(${d.x},${d.y})`);
    });
    
    console.log('Graph setup complete');
  }
  
  function createSingleNodeGraph(container, currentNote) {
    console.log('Creating single node graph');
    
    const width = container.clientWidth || 800;
    const height = 384;
    
    const svg = d3.select(container)
      .append('svg')
      .attr('width', width)
      .attr('height', height)
      .attr('viewBox', [0, 0, width, height]);
    
    // Create single node in center
    const nodeGroup = svg.append('g')
      .attr('transform', `translate(${width/2}, ${height/2})`);
    
    nodeGroup.append('circle')
      .attr('r', 15)
      .attr('fill', '#1f2937')
      .attr('stroke', '#fff')
      .attr('stroke-width', 2);
    
    nodeGroup.append('text')
      .text(currentNote.title.length > 20 ? currentNote.title.substring(0, 20) + '...' : currentNote.title)
      .attr('x', 0)
      .attr('y', -20)
      .attr('text-anchor', 'middle')
      .attr('font-size', '12px')
      .attr('font-family', 'system-ui, sans-serif')
      .attr('fill', '#374151')
      .attr('font-weight', 'bold');
    
    // Add "no connections" text
    svg.append('text')
      .text('No connections found')
      .attr('x', width/2)
      .attr('y', height/2 + 40)
      .attr('text-anchor', 'middle')
      .attr('font-size', '14px')
      .attr('fill', '#6b7280');
  }
</script>

<!-- Quick Search Functionality -->
<script type="module" define:vars={{ allNotes }}>
  document.addEventListener('DOMContentLoaded', async () => {
    // Load Fuse.js from a working CDN
    const { default: Fuse } = await import('https://cdnjs.cloudflare.com/ajax/libs/fuse.js/6.6.2/fuse.min.js');
    initQuickSearch(Fuse);
  });
  
  function initQuickSearch(Fuse) {
    const quickInput = document.getElementById('quick-search');
    const quickResultsContainer = document.getElementById('quick-search-results');
    const quickResultsList = document.getElementById('quick-results-list');
    const quickResultsCount = document.getElementById('quick-results-count');
    
    if (!quickInput) return;
    
    // Process notes data for search
    const searchNotes = allNotes.map(n => ({
      title: n.data.title || n.slug,
      slug: n.slug,
      tags: n.data.tags || [],
      preview: n.body.replace(/\[\[.*?\]\]/g, '').substring(0, 100).trim(),
      content: n.body.replace(/\[\[.*?\]\]/g, '') // Full content for searching
    }));
    
    // Configure Fuse.js
    const fuse = new Fuse(searchNotes, {
      keys: [
        { name: 'title', weight: 0.7 },
        { name: 'content', weight: 0.2 },
        { name: 'tags', weight: 0.1 }
      ],
      threshold: 0.4,
      includeScore: true,
      includeMatches: true
    });
    
    let selectedIndex = -1;
    let currentResults = [];
    
    // Search function
    function performQuickSearch(query) {
      if (!query.trim()) {
        hideQuickResults();
        return;
      }
      
      const searchResults = fuse.search(query);
      currentResults = searchResults.map(r => r.item);
      selectedIndex = -1;
      
      if (currentResults.length > 0) {
        showQuickResults(searchResults.slice(0, 5)); // Limit to 5 results
      } else {
        showNoQuickResults();
      }
    }
    
    // Show search results
    function showQuickResults(searchResults) {
      quickResultsCount.textContent = `${currentResults.length} note${currentResults.length === 1 ? '' : 's'}`;
      
      quickResultsList.innerHTML = searchResults.map((result, index) => {
        const note = result.item;
        return `
          <div class="quick-search-item p-3 hover:bg-blue-50 cursor-pointer border-b border-gray-100 last:border-b-0 text-sm transition-colors" data-index="${index}">
            <div class="font-medium text-gray-900 mb-1">${note.title}</div>
            ${note.preview ? `<div class="text-xs text-gray-600 leading-relaxed">${note.preview}...</div>` : ''}
            ${note.tags.length > 0 ? `
              <div class="flex flex-wrap gap-1 mt-2">
                ${note.tags.map(tag => `<span class="inline-block px-1.5 py-0.5 bg-blue-50 text-blue-600 text-xs rounded">${tag}</span>`).join('')}
              </div>
            ` : ''}
          </div>
        `;
      }).join('');
      
      quickResultsContainer.classList.remove('hidden');
    }
    
    // Show no results
    function showNoQuickResults() {
      quickResultsCount.textContent = 'No notes found';
      quickResultsList.innerHTML = `
        <div class="p-3 text-center text-gray-500 text-sm">
          No notes found
        </div>
      `;
      quickResultsContainer.classList.remove('hidden');
    }
    
    // Hide results
    function hideQuickResults() {
      quickResultsContainer.classList.add('hidden');
      selectedIndex = -1;
    }
    
    // Navigate to result
    function selectQuickResult(index) {
      if (currentResults[index]) {
        window.location.href = `/notes/${currentResults[index].slug}`;
      }
    }
    
    // Update visual selection
    function updateQuickSelection() {
      const items = document.querySelectorAll('.quick-search-item');
      items.forEach((item, index) => {
        if (index === selectedIndex) {
          item.classList.add('bg-blue-100');
          item.scrollIntoView({ block: 'nearest' });
        } else {
          item.classList.remove('bg-blue-100');
        }
      });
    }
    
    // Event listeners
    quickInput.addEventListener('input', (e) => {
      performQuickSearch(e.target.value);
    });
    
    // Keyboard navigation
    quickInput.addEventListener('keydown', (e) => {
      if (!quickResultsContainer.classList.contains('hidden')) {
        switch (e.key) {
          case 'ArrowDown':
            e.preventDefault();
            selectedIndex = Math.min(selectedIndex + 1, Math.min(currentResults.length - 1, 4));
            updateQuickSelection();
            break;
          case 'ArrowUp':
            e.preventDefault();
            selectedIndex = Math.max(selectedIndex - 1, -1);
            updateQuickSelection();
            break;
          case 'Enter':
            e.preventDefault();
            if (selectedIndex >= 0) {
              selectQuickResult(selectedIndex);
            } else if (currentResults.length > 0) {
              selectQuickResult(0);
            }
            break;
          case 'Escape':
            hideQuickResults();
            quickInput.blur();
            break;
        }
      }
    });
    
    // Click on results
    quickResultsList.addEventListener('click', (e) => {
      const item = e.target.closest('.quick-search-item');
      if (item) {
        const index = parseInt(item.dataset.index);
        selectQuickResult(index);
      }
    });
    
    // Click outside to close
    document.addEventListener('click', (e) => {
      if (!e.target.closest('#quick-search') && !e.target.closest('#quick-search-results')) {
        hideQuickResults();
      }
    });
    
    // Global keyboard shortcut (Cmd+K or Ctrl+K)
    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        quickInput.focus();
        quickInput.select();
      }
    });
  }
</script>

