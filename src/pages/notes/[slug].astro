---
import Layout from '../../layouts/layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  return notes.map(note => ({ params: { slug: note.slug } }));
}

const { slug } = Astro.params;
const allNotes = await getCollection('notes');

// Find the note
const note = allNotes.find(n => n.slug === slug);
if (!note) {
  throw new Error(`Note "${slug}" not found`);
}

const { Content } = await note.render();
const { data } = note;

// Get backlinks
const backlinks = allNotes.filter(n => n.body.includes(`[[${slug}]]`));

const backlinkCounts = {};
for (const sourceNote of allNotes) {
  for (const targetNote of allNotes) {
    if (sourceNote.body.includes(`[[${targetNote.slug}]]`)) {
      backlinkCounts[targetNote.slug] = (backlinkCounts[targetNote.slug] || 0) + 1;
    }
  }
}
---

<Layout title={data.title}>
  <article class="prose prose-lg max-w-3xl mx-auto my-8">
    <h1>{data.title}</h1>
    <Content />

    {backlinks.length > 0 && (
      <section class="mt-12 border-t pt-6">
        <h2 class="text-2xl font-bold mb-4">🔗 Backlinks</h2>
        <ul class="list-disc ml-6">
          {backlinks.map(link => (
  <li key={link.slug}>
    <a href={`/notes/${link.slug}`} class="text-blue-600 hover:underline">
      {link.data.title || link.slug}
      {backlinkCounts[link.slug] && (
        <sup class="text-xs text-gray-500 ml-1">{backlinkCounts[link.slug]}</sup>
      )}
    </a>
  </li>
))}
        </ul>
      </section>
    )}
  </article>
</Layout>