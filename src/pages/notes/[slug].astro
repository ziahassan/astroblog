---
import Layout from '../../layouts/layout.astro';
import { getCollection } from 'astro:content';
import LocalGraphView from '../../components/LocalGraphView.tsx';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  return notes.map(note => ({ params: { slug: note.slug } }));
}

const { slug } = Astro.params;
const allNotes = await getCollection('notes');

const note = allNotes.find(n => n.slug === slug);
if (!note) {
  throw new Error(`Note "${slug}" not found`);
}

const titleToSlug: Record<string, string> = {};
const slugToTitle: Record<string, string> = {};
allNotes.forEach(n => {
  const title = n?.data?.title ?? n.id.replace(/\.mdx?$/, '');
  if (title) {
    titleToSlug[title] = n.slug;
    slugToTitle[n.slug] = title;
  }
});

const { Content } = await note.render();
const { data } = note;
const displayTitle = data?.title || note.id
  .replace(/\.mdx?$/, '')
  .replace(/^\d{4}-\d{2}-\d{2}-?/, '')
  .replace(/-/g, ' ')
  .trim() || note.slug;

// Backlinks
const backlinks = [];
for (const n of allNotes) {
  if (n.slug === slug) continue;
  const body = typeof n?.body === 'string' ? n.body : '';
  if (!body) continue;

  const titlePattern = data?.title ? `[[${data.title}]]` : null;
  const filePattern = !data?.title ? `[[${displayTitle}]]` : null;
  const slugPattern = `[[${slug}]]`;

  const matchedPattern =
    (titlePattern && body.includes(titlePattern)) ? titlePattern :
    (filePattern && body.includes(filePattern)) ? filePattern :
    body.includes(slugPattern) ? slugPattern : null;

  if (matchedPattern) {
    const pattern = matchedPattern;
    const index = body.indexOf(pattern);
    const start = Math.max(0, index - 80);
    const end = Math.min(body.length, index + pattern.length + 80);
    let context = body.slice(start, end)
      .replace(/\[\[([^\]]+)\]\]/g, '$1')
      .replace(/\n/g, ' ')
      .trim();
    if (start > 0) context = '...' + context;
    if (end < body.length) context = context + '...';

    backlinks.push({
      slug: n.slug,
      title: n.data?.title || n.slug,
      context
    });
  }
}

// Outgoing links
const outgoingLinks = [];
const noteBody = typeof note?.body === 'string' ? note.body : '';
const wikiLinkRegex = /\[\[([^\]]+)\]\]/g;
const seenOutgoing = new Set();
let wikiMatch;
while ((wikiMatch = wikiLinkRegex.exec(noteBody)) !== null) {
  const linkText = wikiMatch[1];
  let targetSlug = null;
  if (titleToSlug[linkText] !== undefined) {
    targetSlug = titleToSlug[linkText];
  } else if (allNotes.find(n => n.slug === linkText)) {
    targetSlug = linkText;
  }
  if (targetSlug && targetSlug !== slug && !seenOutgoing.has(targetSlug)) {
    seenOutgoing.add(targetSlug);
    outgoingLinks.push({ slug: targetSlug, title: slugToTitle[targetSlug] || targetSlug });
  }
}

// Local graph
const localNodeMap = new Map();
localNodeMap.set(slug, { id: slug, title: displayTitle, isCurrent: true });
for (const l of outgoingLinks) {
  if (!localNodeMap.has(l.slug)) localNodeMap.set(l.slug, { id: l.slug, title: l.title, isCurrent: false });
}
for (const l of backlinks) {
  if (!localNodeMap.has(l.slug)) localNodeMap.set(l.slug, { id: l.slug, title: l.title, isCurrent: false });
}
const localGraphData = {
  nodes: Array.from(localNodeMap.values()),
  links: [
    ...outgoingLinks.map(l => ({ source: slug, target: l.slug })),
    ...backlinks.map(l => ({ source: l.slug, target: slug })),
  ],
  currentSlug: slug,
};

const backlinkCounts: Record<string, number> = {};
for (const sourceNote of allNotes) {
  for (const targetNote of allNotes) {
    const targetTitle = targetNote?.data?.title ?? targetNote.id.replace(/\.mdx?$/, '');
    const titlePattern = targetTitle ? `[[${targetTitle}]]` : null;
    const slugPattern = `[[${targetNote.slug}]]`;
    const sourceBody = typeof sourceNote?.body === 'string' ? sourceNote.body : '';
    if (!sourceBody) continue;
    if ((titlePattern && sourceBody.includes(titlePattern)) || sourceBody.includes(slugPattern)) {
      const key = targetTitle || targetNote.slug;
      backlinkCounts[key] = (backlinkCounts[key] || 0) + 1;
    }
  }
}
---

<Layout title={displayTitle}>

  <!-- Floating search -->
  <div class="fixed top-20 right-6 z-40">
    <div class="relative">
      <input
        type="text"
        id="quick-search"
        placeholder="Search notes..."
        class="w-56 px-3 py-2 text-sm bg-white/95 backdrop-blur border border-gray-200 rounded-lg shadow-md focus:outline-none focus:ring-2 focus:ring-teal-300 focus:border-transparent transition-all"
        autocomplete="off"
      />
      <kbd class="absolute right-2.5 top-1/2 -translate-y-1/2 px-1.5 py-0.5 bg-gray-100 text-gray-400 rounded text-xs font-mono">⌘K</kbd>
    </div>
    <div
      id="quick-search-results"
      class="absolute top-full right-0 mt-2 w-80 bg-white border border-gray-200 rounded-lg shadow-xl max-h-64 overflow-y-auto z-40 hidden"
    >
      <div class="px-3 py-2 text-xs text-teal-700 border-b border-teal-100 bg-teal-50 font-medium" id="quick-results-count"></div>
      <div id="quick-results-list"></div>
    </div>
  </div>

  <article class="max-w-2xl mx-auto px-6 py-16">

    <a href="/notes" class="text-xs text-gray-400 hover:text-teal-600 transition-colors tracking-wide uppercase font-medium">
      ← Garden
    </a>

    <header class="mt-10 mb-12">
      <h1
        class="text-4xl font-light text-gray-800 leading-tight mb-5"
        style="font-family: 'Crimson Text', Georgia, serif; color: #134e4a;"
      >
        {displayTitle}
      </h1>

      <div class="flex flex-wrap items-center gap-3 pt-5 border-t border-teal-100">
        {(data.publishDate || data.created) && (() => {
          const d = data.publishDate ?? data.created;
          return (
            <time class="text-xs text-amber-500 font-mono font-medium">
              {new Date(d as string | number | Date).toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })}
            </time>
          );
        })()}
        {data.tags && data.tags.length > 0 && (
          <div class="flex flex-wrap gap-1.5">
            {data.tags.map(tag => (
              <a href={`/tags/${tag}`} class="px-2 py-0.5 bg-teal-50 text-teal-600 border border-teal-100 text-xs rounded hover:bg-teal-100 hover:border-teal-300 transition-colors">
                {tag}
              </a>
            ))}
          </div>
        )}
      </div>
    </header>

    <div class="note-content prose">
      <Content />
    </div>

    <!-- Connections -->
    {(outgoingLinks.length > 0 || backlinks.length > 0) && (
      <section class="mt-16 pt-8 border-t border-teal-100">
        <h2 class="text-xs font-bold text-teal-500 uppercase tracking-widest mb-6">Connections</h2>

        <LocalGraphView data={localGraphData} client:only="react" />

        {outgoingLinks.length > 0 && (
          <div class="mt-8">
            <h3 class="text-xs font-medium text-gray-400 uppercase tracking-wider mb-3">Links out</h3>
            <div class="flex flex-wrap gap-2">
              {outgoingLinks.map(link => (
                <a
                  href={`/notes/${link.slug}`}
                  class="px-3 py-1.5 bg-teal-50 border border-teal-100 rounded-lg text-sm text-teal-700 hover:bg-teal-100 hover:border-teal-300 transition-all"
                >
                  {link.title}
                </a>
              ))}
            </div>
          </div>
        )}

        {backlinks.length > 0 && (
          <div class="mt-6">
            <h3 class="text-xs font-medium text-gray-400 uppercase tracking-wider mb-3">Mentioned by</h3>
            <div class="space-y-2">
              {backlinks.map(link => (
                <a
                  href={`/notes/${link.slug}`}
                  class="block p-4 rounded-lg border transition-all group"
                  style="background:#fafaf8; border-color:#d1fae5;"
                >
                  <div
                    class="font-medium text-sm mb-1 group-hover:text-teal-700 transition-colors"
                    style="font-family: 'Crimson Text', Georgia, serif; color: #134e4a;"
                  >
                    {link.title}
                  </div>
                  {link.context && (
                    <div class="text-xs text-gray-500 leading-relaxed">{link.context}</div>
                  )}
                </a>
              ))}
            </div>
          </div>
        )}
      </section>
    )}

    <footer class="mt-12 pt-8 border-t border-gray-100">
      <a href="/notes" class="text-sm text-teal-500 hover:text-teal-700 transition-colors font-medium">
        ← Back to garden
      </a>
    </footer>

  </article>
</Layout>

<script define:vars={{ titleToSlug, slugToTitle, backlinkCounts }}>
  function processInternalLinks() {
    const content = document.querySelector('.note-content');
    if (!content) return;

    content.querySelectorAll('a.internal').forEach(link => {
      const href = link.getAttribute('href');
      const match = href?.match(/\/notes\/(.+)$/);
      if (!match) return;

      const slug = match[1];
      const title = slugToTitle[slug];
      if (!title) return;

      link.textContent = title;
      const count = backlinkCounts[title];
      if (count > 0) {
        const sup = document.createElement('sup');
        sup.className = 'text-xs text-teal-400 ml-0.5';
        sup.textContent = count;
        link.appendChild(sup);
      }
      link.className = 'wiki-link';
    });
  }

  document.addEventListener('DOMContentLoaded', processInternalLinks);
</script>

<script type="module" define:vars={{ allNotes }}>
  document.addEventListener('DOMContentLoaded', async () => {
    const { default: Fuse } = await import('https://cdnjs.cloudflare.com/ajax/libs/fuse.js/6.6.2/fuse.min.js');

    const quickInput = document.getElementById('quick-search');
    const quickResultsContainer = document.getElementById('quick-search-results');
    const quickResultsList = document.getElementById('quick-results-list');
    const quickResultsCount = document.getElementById('quick-results-count');
    if (!quickInput) return;

    const searchNotes = allNotes.map(n => ({
      title: n.data.title || n.slug,
      slug: n.slug,
      tags: n.data.tags || [],
      preview: (n.body || '').replace(/\[\[.*?\]\]/g, '').substring(0, 100).trim(),
      content: (n.body || '').replace(/\[\[.*?\]\]/g, ''),
    }));

    const fuse = new Fuse(searchNotes, {
      keys: [{ name: 'title', weight: 0.7 }, { name: 'content', weight: 0.2 }, { name: 'tags', weight: 0.1 }],
      threshold: 0.4,
      includeScore: true,
    });

    let selectedIndex = -1;
    let currentResults = [];

    function showResults(results) {
      currentResults = results.map(r => r.item);
      quickResultsCount.textContent = `${currentResults.length} note${currentResults.length === 1 ? '' : 's'}`;
      quickResultsList.innerHTML = currentResults.slice(0, 5).map((note, i) => `
        <a href="/notes/${note.slug}" class="quick-search-item block px-4 py-3 hover:bg-teal-50 border-b border-gray-100 last:border-0 transition-colors" data-index="${i}">
          <div class="font-medium text-gray-900 text-sm">${note.title}</div>
          ${note.preview ? `<div class="text-xs text-gray-500 truncate mt-0.5">${note.preview}</div>` : ''}
        </a>
      `).join('');
      quickResultsContainer.classList.remove('hidden');
    }

    function hideResults() {
      quickResultsContainer.classList.add('hidden');
      selectedIndex = -1;
    }

    quickInput.addEventListener('input', e => {
      const q = e.target.value;
      if (!q.trim()) { hideResults(); return; }
      const results = fuse.search(q);
      results.length > 0 ? showResults(results) : (quickResultsCount.textContent = 'No results', quickResultsList.innerHTML = '', quickResultsContainer.classList.remove('hidden'));
    });

    quickInput.addEventListener('keydown', e => {
      if (quickResultsContainer.classList.contains('hidden')) return;
      if (e.key === 'ArrowDown') { e.preventDefault(); selectedIndex = Math.min(selectedIndex + 1, Math.min(currentResults.length - 1, 4)); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); selectedIndex = Math.max(selectedIndex - 1, -1); }
      else if (e.key === 'Enter') { e.preventDefault(); if (currentResults[selectedIndex >= 0 ? selectedIndex : 0]) window.location.href = `/notes/${currentResults[selectedIndex >= 0 ? selectedIndex : 0].slug}`; }
      else if (e.key === 'Escape') { hideResults(); quickInput.blur(); }
      document.querySelectorAll('.quick-search-item').forEach((el, i) => el.classList.toggle('bg-teal-50', i === selectedIndex));
    });

    document.addEventListener('click', e => {
      if (!e.target.closest('#quick-search') && !e.target.closest('#quick-search-results')) hideResults();
    });

    document.addEventListener('keydown', e => {
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') { e.preventDefault(); quickInput.focus(); quickInput.select(); }
    });
  });
</script>

<style>
  .note-content {
    font-family: 'Crimson Text', Georgia, serif;
    font-size: 1.15rem;
    line-height: 1.85;
    color: #374151;
  }

  .note-content p {
    margin-bottom: 1.4em;
  }

  .note-content h2 {
    font-family: 'Crimson Text', Georgia, serif;
    font-size: 1.5rem;
    font-weight: 400;
    color: #134e4a;
    margin-top: 2.5em;
    margin-bottom: 0.6em;
    padding-bottom: 0.3em;
    border-bottom: 1px solid #ccfbf1;
  }

  .note-content h3 {
    font-family: 'Crimson Text', Georgia, serif;
    font-size: 1.2rem;
    font-weight: 600;
    color: #134e4a;
    margin-top: 2em;
    margin-bottom: 0.5em;
  }

  .note-content ul, .note-content ol {
    margin: 1em 0;
    padding-left: 1.5em;
  }

  .note-content li {
    margin-bottom: 0.35em;
  }

  .note-content blockquote {
    border-left: 3px solid #99f6e4;
    padding-left: 1.2em;
    margin: 1.8em 0;
    color: #6b7280;
    font-style: italic;
  }

  .note-content a, .wiki-link {
    color: #0f766e;
    text-decoration: underline;
    text-decoration-color: #99f6e4;
    text-underline-offset: 2px;
    transition: color 0.15s, text-decoration-color 0.15s;
  }

  .note-content a:hover, .wiki-link:hover {
    color: #134e4a;
    text-decoration-color: #0f766e;
  }

  .note-content code {
    background: #f0fdfa;
    color: #0f766e;
    padding: 0.15em 0.4em;
    border-radius: 4px;
    font-size: 0.85em;
    font-family: ui-monospace, monospace;
  }

  .note-content pre {
    background: #134e4a;
    color: #ccfbf1;
    padding: 1.2em 1.4em;
    border-radius: 8px;
    overflow-x: auto;
    margin: 1.8em 0;
    font-size: 0.85rem;
    line-height: 1.6;
  }

  .note-content pre code {
    background: none;
    color: inherit;
    padding: 0;
    font-size: inherit;
  }

  .note-content hr {
    border: none;
    border-top: 1px solid #ccfbf1;
    margin: 2.5em 0;
  }

  .note-content strong {
    font-weight: 600;
    color: #111827;
  }
</style>
