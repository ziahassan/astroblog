---
import Layout from '../../layouts/layout.astro';
import { getCollection } from 'astro:content';
import FullGraphView from '../../components/FullGraphView.tsx';

const notes = await getCollection('notes');

// Helper to extract date from filename (e.g., "2019-01-18-lab-notebook" -> Date)
function getDateFromSlug(slug: string): Date | null {
  const match = slug.match(/^(\d{4}-\d{2}-\d{2})/);
  if (match) {
    const date = new Date(match[1]);
    if (!isNaN(date.getTime())) return date;
  }
  return null;
}

// Sort: first by backlinks (most connected), then by filename date, then alphabetically
const sorted = notes.sort((a, b) => {
  // First try frontmatter dates
  const dateA = a.data.publishDate || a.data.created;
  const dateB = b.data.publishDate || b.data.created;

  if (dateA && dateB) {
    return new Date(dateB).getTime() - new Date(dateA).getTime();
  }
  if (dateA) return -1;
  if (dateB) return 1;

  // Then try extracting date from filename
  const slugDateA = getDateFromSlug(a.slug);
  const slugDateB = getDateFromSlug(b.slug);

  if (slugDateA && slugDateB) {
    return slugDateB.getTime() - slugDateA.getTime();
  }
  if (slugDateA) return -1;
  if (slugDateB) return 1;

  // Finally, sort alphabetically by title
  const titleA = (a.data.title || a.slug).toLowerCase();
  const titleB = (b.data.title || b.slug).toLowerCase();
  return titleA.localeCompare(titleB);
});

const recentNotes = sorted; // render all, cap display in CSS

// Collect all tags and their counts
const tagCounts: Record<string, number> = {};
notes.forEach(note => {
  const tags = note.data.tags || [];
  tags.forEach((tag: string) => {
    tagCounts[tag] = (tagCounts[tag] || 0) + 1;
  });
});

// Sort tags by count
const sortedTags = Object.entries(tagCounts)
  .sort(([,a], [,b]) => b - a)
  .slice(0, 20); // Top 20 tags

// Create backlink count mapping
const backlinkCounts: Record<string, number> = {};
for (const sourceNote of notes) {
  const sourceBody = typeof sourceNote?.body === 'string' ? sourceNote.body : '';
  if (!sourceBody) continue;
  for (const targetNote of notes) {
    const titlePattern = `[[${targetNote.data.title}]]`;
    const slugPattern = `[[${targetNote.slug}]]`;
    if (sourceBody.includes(titlePattern) || sourceBody.includes(slugPattern)) {
      backlinkCounts[targetNote.slug] = (backlinkCounts[targetNote.slug] || 0) + 1;
    }
  }
}

// Random note
const random = notes[Math.floor(Math.random() * notes.length)];

// Clean up slug-style titles (e.g. "2019-01-18-lab-notebook" → "Lab Notebook")
function cleanTitle(note: any): string {
  if (note.data.title) return note.data.title;
  return note.id
    .replace(/\.mdx?$/, '')
    .replace(/^\d{4}-\d{2}-\d{2}-?/, '')
    .replace(/-/g, ' ')
    .trim() || note.slug;
}

// Build full graph data
const graphNodes = notes.map(note => ({
  id: note.slug,
  title: cleanTitle(note),
  connections: backlinkCounts[note.slug] || 0,
}));

const graphLinks: { source: string; target: string }[] = [];
const titleToSlug: Record<string, string> = {};
notes.forEach(n => {
  if (n.data.title) titleToSlug[n.data.title] = n.slug;
});
for (const note of notes) {
  const body = typeof note.body === 'string' ? note.body : '';
  const seen = new Set<string>();
  for (const match of body.matchAll(/\[\[([^\]]+)\]\]/g)) {
    const linkText = match[1];
    const targetSlug = titleToSlug[linkText] ?? (notes.find(n => n.slug === linkText)?.slug);
    if (targetSlug && targetSlug !== note.slug && !seen.has(targetSlug)) {
      seen.add(targetSlug);
      graphLinks.push({ source: note.slug, target: targetSlug });
    }
  }
}

const graphData = { nodes: graphNodes, links: graphLinks };
---

<Layout title="Notes">
  <div class="max-w-5xl mx-auto px-6 py-10">

    <!-- Header -->
    <header class="pb-8 border-b border-gray-100">
      <div class="flex items-baseline justify-between">
        <h1 class="text-3xl font-light text-indigo-950" style="font-family: 'Crimson Text', Georgia, serif;">Notes</h1>
        <span class="text-sm text-gray-400">{notes.length} notes</span>
      </div>
      <p class="text-gray-500 mt-2">Atomic ideas, research findings, and evergreen thoughts.</p>
    </header>

    <!-- Search + Random + Sort -->
    <div class="py-6 flex flex-wrap items-center gap-3">
      <div class="flex-1 relative min-w-[200px]">
        <input
          type="text"
          id="search"
          placeholder="Search notes..."
          class="w-full px-4 py-2 bg-gray-50 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-transparent text-sm"
          autocomplete="off"
        />
        <kbd class="absolute right-3 top-1/2 -translate-y-1/2 px-1.5 py-0.5 bg-gray-200 text-gray-500 rounded text-xs font-mono">⌘K</kbd>
      </div>

      <!-- Sort Options -->
      <div class="flex items-center gap-1 bg-gray-100 rounded-lg p-1">
        <button class="sort-btn active px-3 py-1.5 text-xs font-medium rounded-md bg-white shadow-sm text-gray-800 transition-all" data-sort="date">
          Date
        </button>
        <button class="sort-btn px-3 py-1.5 text-xs font-medium rounded-md text-gray-600 hover:bg-gray-200 transition-all" data-sort="connected">
          Connected
        </button>
        <button class="sort-btn px-3 py-1.5 text-xs font-medium rounded-md text-gray-600 hover:bg-gray-200 transition-all" data-sort="alpha">
          A-Z
        </button>
      </div>

      <a href={`/notes/${random.slug}`} class="px-3 py-2 bg-teal-50 hover:bg-teal-100 border border-teal-100 rounded-lg text-sm font-medium text-teal-700 transition-colors">
        🎲 Random
      </a>
      <a href="/reading" class="px-3 py-2 bg-gray-50 hover:bg-gray-100 border border-gray-200 rounded-lg text-sm text-gray-600 transition-colors">
        Reading notes →
      </a>

      <!-- View toggle -->
      <div class="flex items-center gap-1 bg-teal-50 border border-teal-100 rounded-lg p-1 ml-auto">
        <button id="view-cards" class="view-toggle active px-3 py-1.5 text-xs font-medium rounded-md bg-white shadow-sm text-teal-700 transition-all">
          Cards
        </button>
        <button id="view-graph" class="view-toggle px-3 py-1.5 text-xs font-medium rounded-md text-teal-500 hover:bg-teal-100 transition-all">
          Graph
        </button>
      </div>
    </div>

    <!-- Search Results (hidden by default) -->
    <div id="search-results" class="hidden mb-6">
      <div class="bg-white border border-gray-200 rounded-lg shadow-lg max-h-96 overflow-y-auto">
        <div class="px-4 py-2 bg-teal-50 border-b border-teal-100 text-sm text-teal-700" id="results-count"></div>
        <div id="results-list"></div>
      </div>
    </div>

    <!-- Tags Row -->
    {sortedTags.length > 0 && (
      <div class="pb-6 border-b border-gray-100">
        <div class="flex flex-wrap gap-2">
          <button class="tag-filter active px-3 py-1.5 text-xs font-medium rounded-full bg-teal-600 text-white transition-all" data-tag="all">
            All
          </button>
          {sortedTags.map(([tag, count]) => (
            <button
              class="tag-filter px-3 py-1.5 text-xs font-medium rounded-full bg-teal-50 text-teal-700 border border-teal-100 hover:bg-teal-100 transition-all"
              data-tag={tag}
            >
              {tag} <span class="text-teal-400 ml-1">{count}</span>
            </button>
          ))}
        </div>
      </div>
    )}

    <!-- Graph View -->
    <div id="graph-container" class="hidden py-6">
      <FullGraphView data={graphData} client:only="react" />
    </div>

    <!-- Notes List -->
    <div id="notes-container" class="py-6">

      <!-- Card Grid -->
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3" id="notes-list">
        {recentNotes.map((note, i) => {
          const tags = note.data.tags || [];
          const title = cleanTitle(note);
          const backlinks = backlinkCounts[note.slug] || 0;
          const dateA = note.data.publishDate || note.data.created;
          const slugMatch = note.slug.match(/^(\d{4}-\d{2}-\d{2})/);
          const slugDate = slugMatch ? slugMatch[1] : null;
          const sortDate = dateA ? new Date(dateA).getTime() : (slugDate ? new Date(slugDate).getTime() : 0);

          return (
            <a
              href={`/notes/${note.slug}`}
              class={`note-item group flex flex-col rounded-lg overflow-hidden border shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all${i >= 50 ? ' beyond-fifty' : ''}`}
              style="background:#fafaf8; border-color:#e8e3dc;"
              data-tags={JSON.stringify(tags)}
              data-title={title.toLowerCase()}
              data-backlinks={backlinks}
              data-date={sortDate}
            >
              <div class="h-[3px] bg-teal-300 group-hover:bg-teal-500 transition-colors" />
              <div class="p-3 flex flex-col flex-1" style="min-height:110px;">
                <p class="text-gray-800 group-hover:text-teal-700 transition-colors leading-snug font-medium text-sm flex-1" style="font-family: 'Crimson Text', Georgia, serif; font-size: 1rem;">
                  {title}
                </p>
                <div class="mt-3 flex items-end justify-between gap-1">
                  <div class="flex flex-wrap gap-1">
                    {tags.slice(0, 2).map((tag: string) => (
                      <span
                        class="tag-chip px-1.5 py-0.5 bg-teal-50 text-teal-600 border border-teal-100 text-xs rounded leading-none hover:bg-teal-100 hover:border-teal-300 transition-colors cursor-pointer"
                        data-tag={tag}
                      >
                        {tag}
                      </span>
                    ))}
                  </div>
                  {backlinks > 0 && (
                    <span class="text-xs text-teal-400 font-mono flex-shrink-0" title={`${backlinks} backlinks`}>
                      ←{backlinks}
                    </span>
                  )}
                </div>
              </div>
            </a>
          );
        })}
      </div>

      <!-- Show more -->
      {notes.length > 30 && (
        <div class="text-center py-4">
          <button
            id="show-all-btn"
            class="px-4 py-2 text-sm text-violet-600 hover:text-violet-800 font-medium transition-colors"
          >
            Show all {notes.length} notes ↓
          </button>
        </div>
      )}
    </div>

    <!-- Empty state for filters -->
    <div id="empty-state" class="hidden py-12 text-center">
      <p class="text-gray-400">No notes match this filter.</p>
    </div>

  </div>
</Layout>

<script define:vars={{ notes, backlinkCounts }}>
  document.addEventListener('DOMContentLoaded', () => {
    // Tag chips inside cards — navigate to tag page, don't follow card link
    document.querySelectorAll('.tag-chip').forEach(chip => {
      chip.addEventListener('click', e => {
        e.preventDefault();
        e.stopPropagation();
        window.location.href = `/tags/${chip.dataset.tag}`;
      });
    });

    const searchInput = document.getElementById('search');
    const searchResults = document.getElementById('search-results');
    const resultsList = document.getElementById('results-list');
    const resultsCount = document.getElementById('results-count');
    const notesContainer = document.getElementById('notes-container');
    const noteItems = document.querySelectorAll('.note-item');
    const tagFilters = document.querySelectorAll('.tag-filter');
    const emptyState = document.getElementById('empty-state');

    // Prepare notes data for search
    const notesData = notes.map(n => ({
      title: n.data.title || n.id.replace(/\.mdx?$/, '').replace(/^\d{4}-\d{2}-\d{2}-?/, '').replace(/-/g, ' ').trim() || n.slug,
      slug: n.slug,
      tags: n.data.tags || [],
      backlinks: backlinkCounts[n.slug] || 0,
      preview: (n.body || '').replace(/\[\[.*?\]\]/g, '').substring(0, 80).trim()
    }));

    let activeTag = 'all';

    // Show all button — reveal hidden notes and reset any active tag filter
    document.getElementById('show-all-btn')?.addEventListener('click', (e) => {
      document.querySelectorAll('.beyond-fifty').forEach(el => el.classList.remove('beyond-fifty'));
      // Reset tag filter to All
      noteItems.forEach(item => item.classList.remove('hidden'));
      tagFilters.forEach(b => {
        b.classList.remove('active', 'bg-teal-600', 'text-white');
        b.classList.add('bg-teal-50', 'text-teal-700');
      });
      document.querySelector('.tag-filter[data-tag="all"]')?.classList.add('active', 'bg-teal-600', 'text-white');
      document.querySelector('.tag-filter[data-tag="all"]')?.classList.remove('bg-teal-50', 'text-teal-700');
      activeTag = 'all';
      e.target.closest('div')?.remove();
    });

    // Sort functionality
    const sortBtns = document.querySelectorAll('.sort-btn');
    const notesList = document.getElementById('notes-list');

    function sortNotes(sortType) {
      const items = Array.from(noteItems);

      items.sort((a, b) => {
        if (sortType === 'connected') {
          // Sort by backlinks (most connected first)
          const backlinkA = parseInt(a.dataset.backlinks || '0');
          const backlinkB = parseInt(b.dataset.backlinks || '0');
          if (backlinkB !== backlinkA) return backlinkB - backlinkA;
          // Fall back to alphabetical for ties
          return (a.dataset.title || '').localeCompare(b.dataset.title || '');
        } else if (sortType === 'alpha') {
          // Sort alphabetically
          return (a.dataset.title || '').localeCompare(b.dataset.title || '');
        } else {
          // Sort by date (newest first)
          const dateA = parseInt(a.dataset.date || '0');
          const dateB = parseInt(b.dataset.date || '0');
          if (dateB !== dateA) return dateB - dateA;
          // Fall back to alphabetical for ties
          return (a.dataset.title || '').localeCompare(b.dataset.title || '');
        }
      });

      // Reorder DOM elements
      items.forEach(item => notesList.appendChild(item));
    }

    sortBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const sortType = btn.dataset.sort;

        // Update active state
        sortBtns.forEach(b => {
          b.classList.remove('active', 'bg-white', 'shadow-sm', 'text-gray-800');
          b.classList.add('text-gray-600');
        });
        btn.classList.add('active', 'bg-white', 'shadow-sm', 'text-gray-800');
        btn.classList.remove('text-gray-600');

        // Sort the notes
        sortNotes(sortType);
      });
    });

    // Tag filtering
    tagFilters.forEach(btn => {
      btn.addEventListener('click', () => {
        const tag = btn.dataset.tag;
        activeTag = tag;

        // Update active state
        tagFilters.forEach(b => {
          b.classList.remove('active', 'bg-teal-600', 'text-white');
          b.classList.add('bg-teal-50', 'text-teal-700');
        });
        btn.classList.add('active', 'bg-teal-600', 'text-white');
        btn.classList.remove('bg-teal-50', 'text-teal-700');

        // Filter notes — show all matching regardless of beyond-fifty
        let visibleCount = 0;
        noteItems.forEach(item => {
          const itemTags = JSON.parse(item.dataset.tags || '[]');
          const shouldShow = tag === 'all' || itemTags.includes(tag);

          if (shouldShow) {
            item.classList.remove('hidden');
            // When filtering, reveal beyond-fifty notes if they match
            if (tag !== 'all') item.classList.remove('beyond-fifty');
            visibleCount++;
          } else {
            item.classList.add('hidden');
          }
        });

        // Restore beyond-fifty when going back to All
        if (tag === 'all') {
          let count = 0;
          noteItems.forEach(item => {
            if (!item.classList.contains('hidden')) {
              count++;
              if (count > 50) item.classList.add('beyond-fifty');
            }
          });
        }

        // Show/hide empty state
        emptyState.classList.toggle('hidden', visibleCount > 0);
        notesContainer.classList.toggle('hidden', visibleCount === 0);
      });
    });

    // Search functionality
    function performSearch(query) {
      if (!query.trim()) {
        searchResults.classList.add('hidden');
        notesContainer.classList.remove('hidden');
        return;
      }

      const q = query.toLowerCase();
      const results = notesData.filter(note =>
        note.title.toLowerCase().includes(q) ||
        note.tags.some(t => t.toLowerCase().includes(q)) ||
        note.preview.toLowerCase().includes(q)
      ).slice(0, 10);

      if (results.length > 0) {
        resultsCount.textContent = `${results.length} result${results.length === 1 ? '' : 's'}`;
        resultsList.innerHTML = results.map((note, i) => `
          <a href="/notes/${note.slug}" class="block px-4 py-3 hover:bg-blue-50 border-b border-gray-100 last:border-0 transition-colors">
            <div class="font-medium text-gray-900">${note.title}</div>
            ${note.preview ? `<div class="text-sm text-gray-500 truncate mt-1">${note.preview}...</div>` : ''}
            ${note.tags.length > 0 ? `
              <div class="flex gap-1 mt-2">
                ${note.tags.slice(0, 3).map(t => `<span class="px-2 py-0.5 bg-gray-100 text-gray-500 text-xs rounded">${t}</span>`).join('')}
              </div>
            ` : ''}
          </a>
        `).join('');
        searchResults.classList.remove('hidden');
        notesContainer.classList.add('hidden');
      } else {
        resultsCount.textContent = 'No results';
        resultsList.innerHTML = `
          <div class="px-4 py-6 text-center text-gray-500">
            No notes found for "${query}"
          </div>
        `;
        searchResults.classList.remove('hidden');
        notesContainer.classList.add('hidden');
      }
    }

    searchInput.addEventListener('input', (e) => performSearch(e.target.value));

    // Keyboard shortcut
    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        searchInput.focus();
        searchInput.select();
      }
      if (e.key === 'Escape') {
        searchInput.value = '';
        searchResults.classList.add('hidden');
        notesContainer.classList.remove('hidden');
        searchInput.blur();
      }
    });

    // Click outside to close search
    document.addEventListener('click', (e) => {
      if (!e.target.closest('#search') && !e.target.closest('#search-results')) {
        if (searchInput.value) {
          searchResults.classList.add('hidden');
          notesContainer.classList.remove('hidden');
        }
      }
    });

    // View toggle: Cards ↔ Graph
    const graphContainer = document.getElementById('graph-container');
    const btnCards = document.getElementById('view-cards');
    const btnGraph = document.getElementById('view-graph');

    btnGraph?.addEventListener('click', () => {
      notesContainer.classList.add('hidden');
      graphContainer?.classList.remove('hidden');
      searchResults.classList.add('hidden');
      btnGraph.classList.add('bg-white', 'shadow-sm', 'text-teal-700');
      btnGraph.classList.remove('text-teal-500');
      btnCards?.classList.remove('bg-white', 'shadow-sm', 'text-teal-700');
      btnCards?.classList.add('text-teal-500');
    });

    btnCards?.addEventListener('click', () => {
      graphContainer?.classList.add('hidden');
      notesContainer.classList.remove('hidden');
      btnCards.classList.add('bg-white', 'shadow-sm', 'text-teal-700');
      btnCards.classList.remove('text-teal-500');
      btnGraph?.classList.remove('bg-white', 'shadow-sm', 'text-teal-700');
      btnGraph?.classList.add('text-teal-500');
    });
  });
</script>

<style>
  .note-item.hidden {
    display: none;
  }

  .note-item.beyond-fifty {
    display: none;
  }

  #search-results {
    scrollbar-width: thin;
  }

  #search:focus {
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.15);
  }
</style>
