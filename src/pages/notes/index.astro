---
import Layout from '../../layouts/layout.astro';
import { getCollection } from 'astro:content';

const notes = await getCollection('notes');
// Sort by creation date (newest first) and limit to 20
const sorted = notes
  .sort((a, b) => {
    // Use publishDate if available, otherwise fall back to slug comparison
    const dateA = a.data.publishDate || a.data.date || new Date(0);
    const dateB = b.data.publishDate || b.data.date || new Date(0);
    return new Date(dateB) - new Date(dateA);
  })
  .slice(0, 20);

const random = notes[Math.floor(Math.random() * notes.length)];

// Create backlink count mapping
const backlinkCounts = {};
for (const sourceNote of notes) {
  for (const targetNote of notes) {
    // Check for both [[title]] and [[slug]] patterns
    const titlePattern = `[[${targetNote.data.title}]]`;
    const slugPattern = `[[${targetNote.slug}]]`;
    
    if (sourceNote.body.includes(titlePattern) || sourceNote.body.includes(slugPattern)) {
      backlinkCounts[targetNote.slug] = (backlinkCounts[targetNote.slug] || 0) + 1;
    }
  }
}
---

<Layout title="Notes">
  <section class="space-y-6 text-center">
    <h1 class="text-3xl font-bold">Explore My Notes</h1>
    
    <!-- Enhanced Search Bar -->
    <div class="max-w-md mx-auto relative">
      <div class="relative">
        <input
          type="text"
          id="search"
          placeholder="Search notes... (⌘K)"
          class="w-full px-4 py-3 border-2 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-lg"
          autocomplete="off"
        />
        <div class="absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-400 text-sm">
          <kbd class="px-2 py-1 bg-gray-100 rounded">⌘K</kbd>
        </div>
      </div>
      
      <!-- Search Results Dropdown -->
      <div 
        id="search-results" 
        class="absolute top-full left-0 right-0 mt-2 bg-white border-2 border-gray-200 rounded-lg shadow-lg max-h-96 overflow-y-auto z-50 hidden"
      >
        <div class="p-2 text-sm text-gray-500 border-b">
          <span id="results-count"></span>
        </div>
        <div id="results-list"></div>
      </div>
    </div>
    
    <!-- Surprise Me Button -->
    <div>
      <a href={`/notes/${random.slug}`}>
        <button class="bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 transition-colors font-medium">
          🎲 Surprise Me
        </button>
      </a>
    </div>
    
    <!-- Notes List (hidden when searching) -->
    <div id="notes-list" class="max-w-xl mx-auto">
      <h2 class="text-xl font-semibold mb-4">Recent Notes ({sorted.length} of {notes.length})</h2>
      <ul class="text-left space-y-2">
        {sorted.map(note => (
          <li key={note.slug} class="flex items-center justify-between group">
            <a 
              href={`/notes/${note.slug}`} 
              class="text-blue-600 hover:underline font-medium flex-1"
            >
              {note.data.title || note.slug}
            </a>
            <div class="flex items-center gap-2">
              {note.data.publishDate && (
                <span class="text-xs text-gray-400">
                  {new Date(note.data.publishDate).toLocaleDateString()}
                </span>
              )}
              {backlinkCounts[note.slug] && (
                <span class="text-xs text-gray-500 bg-gray-100 px-2 py-1 rounded-full">
                  {backlinkCounts[note.slug]} links
                </span>
              )}
            </div>
          </li>
        ))}
      </ul>
      {notes.length > 20 && (
        <div class="mt-4 text-center">
          <p class="text-sm text-gray-500">
            Showing 20 most recent notes. Use search to find older notes.
          </p>
        </div>
      )}
    </div>
  </section>
</Layout>

<!-- Enhanced Live Search -->
<script type="module" define:vars={{ notes, backlinkCounts }}>
  import Fuse from 'https://cdn.jsdelivr.net/npm/fuse.js@6.6.2/+esm';
  
  document.addEventListener('DOMContentLoaded', () => {
    const input = document.getElementById('search');
    const resultsContainer = document.getElementById('search-results');
    const resultsList = document.getElementById('results-list');
    const resultsCount = document.getElementById('results-count');
    const notesList = document.getElementById('notes-list');
    
    console.log('Search initialized');
    
    // Process notes data directly from Astro variables
    const processedNotes = notes.map(n => ({
      title: n.data.title || n.slug,
      slug: n.slug,
      tags: n.data.tags || [],
      backlinks: backlinkCounts[n.slug] || 0,
      preview: n.body.replace(/\[\[.*?\]\]/g, '').substring(0, 100).trim()
    }));
    
    console.log('Processed notes:', processedNotes);
    
    if (!processedNotes || processedNotes.length === 0) {
      console.error('No notes found');
      return;
    }
    
    // Configure Fuse.js for better search
    const fuse = new Fuse(processedNotes, {
      keys: [
        { name: 'title', weight: 0.7 },
        { name: 'tags', weight: 0.2 },
        { name: 'preview', weight: 0.1 }
      ],
      threshold: 0.4,
      includeScore: true,
      includeMatches: true
    });
    
    let selectedIndex = -1;
    let currentResults = [];
    
    // Search function
    function performSearch(query) {
      console.log('Performing search for:', query); // Debug log
      
      if (!query.trim()) {
        console.log('Empty query, hiding results'); // Debug log
        hideResults();
        return;
      }
      
      const searchResults = fuse.search(query);
      console.log('Search results:', searchResults); // Debug log
      
      currentResults = searchResults.map(r => r.item);
      selectedIndex = -1;
      
      if (currentResults.length > 0) {
        console.log('Showing results'); // Debug log
        showResults(searchResults);
      } else {
        console.log('No results found'); // Debug log
        showNoResults(query);
      }
    }
    
    // Show search results
    function showResults(searchResults) {
      const maxResults = 8;
      const limitedResults = searchResults.slice(0, maxResults);
      
      resultsCount.textContent = `${currentResults.length} note${currentResults.length === 1 ? '' : 's'} found`;
      
      resultsList.innerHTML = limitedResults.map((result, index) => {
        const note = result.item;
        const score = (1 - result.score) * 100;
        
        // Highlight matches in title
        let highlightedTitle = note.title;
        if (result.matches) {
          const titleMatch = result.matches.find(m => m.key === 'title');
          if (titleMatch && titleMatch.indices) {
            highlightedTitle = highlightText(note.title, titleMatch.indices);
          }
        }
        
        return `
          <div class="search-result-item p-3 hover:bg-blue-50 cursor-pointer border-b border-gray-100 last:border-b-0" data-index="${index}">
            <div class="flex items-center justify-between">
              <div class="flex-1">
                <div class="font-medium text-gray-900">${highlightedTitle}</div>
                ${note.preview ? `<div class="text-sm text-gray-600 mt-1 truncate">${note.preview}...</div>` : ''}
                ${note.tags.length > 0 ? `<div class="text-xs text-blue-600 mt-1">#${note.tags.join(' #')}</div>` : ''}
              </div>
              <div class="text-right text-xs text-gray-400 ml-4">
                ${note.backlinks > 0 ? `<div>${note.backlinks} links</div>` : ''}
                <div>${Math.round(score)}% match</div>
              </div>
            </div>
          </div>
        `;
      }).join('');
      
      if (searchResults.length > maxResults) {
        resultsList.innerHTML += `
          <div class="p-3 text-center text-sm text-gray-500 border-t">
            ... and ${searchResults.length - maxResults} more results
          </div>
        `;
      }
      
      resultsContainer.classList.remove('hidden');
      notesList.classList.add('hidden');
    }
    
    // Show no results message
    function showNoResults(query) {
      resultsCount.textContent = 'No notes found';
      resultsList.innerHTML = `
        <div class="p-4 text-center text-gray-500">
          <div class="text-lg">🔍</div>
          <div class="mt-2">No notes found for "${query}"</div>
          <div class="text-sm mt-1">Try a different search term</div>
        </div>
      `;
      resultsContainer.classList.remove('hidden');
      notesList.classList.add('hidden');
    }
    
    // Hide search results
    function hideResults() {
      resultsContainer.classList.add('hidden');
      notesList.classList.remove('hidden');
      selectedIndex = -1;
    }
    
    // Highlight text matches
    function highlightText(text, indices) {
      let result = '';
      let lastIndex = 0;
      
      indices.forEach(([start, end]) => {
        result += text.slice(lastIndex, start);
        result += `<mark class="bg-yellow-200 px-1 rounded">${text.slice(start, end + 1)}</mark>`;
        lastIndex = end + 1;
      });
      
      result += text.slice(lastIndex);
      return result;
    }
    
    // Navigate to selected result
    function selectResult(index) {
      if (currentResults[index]) {
        window.location.href = `/notes/${currentResults[index].slug}`;
      }
    }
    
    // Update visual selection
    function updateSelection() {
      const items = document.querySelectorAll('.search-result-item');
      items.forEach((item, index) => {
        if (index === selectedIndex) {
          item.classList.add('bg-blue-100');
          item.scrollIntoView({ block: 'nearest' });
        } else {
          item.classList.remove('bg-blue-100');
        }
      });
    }
    
    // Event listeners
    input.addEventListener('input', (e) => {
      console.log('Input event triggered:', e.target.value); // Debug log
      performSearch(e.target.value);
    });
    
    // Keyboard navigation
    input.addEventListener('keydown', (e) => {
      if (!resultsContainer.classList.contains('hidden')) {
        switch (e.key) {
          case 'ArrowDown':
            e.preventDefault();
            selectedIndex = Math.min(selectedIndex + 1, currentResults.length - 1);
            updateSelection();
            break;
          case 'ArrowUp':
            e.preventDefault();
            selectedIndex = Math.max(selectedIndex - 1, -1);
            updateSelection();
            break;
          case 'Enter':
            e.preventDefault();
            if (selectedIndex >= 0) {
              selectResult(selectedIndex);
            } else if (currentResults.length > 0) {
              selectResult(0);
            }
            break;
          case 'Escape':
            hideResults();
            input.blur();
            break;
        }
      }
    });
    
    // Click on search results
    resultsList.addEventListener('click', (e) => {
      const item = e.target.closest('.search-result-item');
      if (item) {
        const index = parseInt(item.dataset.index);
        selectResult(index);
      }
    });
    
    // Click outside to close
    document.addEventListener('click', (e) => {
      if (!e.target.closest('#search') && !e.target.closest('#search-results')) {
        hideResults();
      }
    });
    
    // Global keyboard shortcut (Cmd+K or Ctrl+K)
    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        input.focus();
        input.select();
      }
    });
    
    // Focus search on page load
    input.focus();
  });
</script>

<style>
  /* Custom scrollbar for search results */
  #search-results {
    scrollbar-width: thin;
    scrollbar-color: #cbd5e0 #f7fafc;
  }
  
  #search-results::-webkit-scrollbar {
    width: 6px;
  }
  
  #search-results::-webkit-scrollbar-track {
    background: #f7fafc;
  }
  
  #search-results::-webkit-scrollbar-thumb {
    background-color: #cbd5e0;
    border-radius: 3px;
  }
  
  /* Smooth transitions */
  .search-result-item {
    transition: background-color 0.15s ease;
  }
  
  /* Search input focus state */
  #search:focus {
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
  }
</style>