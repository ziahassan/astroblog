---
// src/pages/index.astro
import Layout from '../layouts/layout.astro';
import { getCollection } from 'astro:content';
import GraphView from '../components/GraphView.tsx';

// Get notes for the graph
let notes = [];
try {
  notes = await getCollection('notes');
} catch (error) {
  console.warn('Could not load notes:', error);
}

// Build graph data safely
const nodes = notes.map(note => ({
  id: note.slug,
  title: note.data.title || note.slug,
  tags: note.data.tags || []
}));

const links = [];

// Create links between notes based on [[links]]
for (const sourceNote of notes) {
  for (const targetNote of notes) {
    if (sourceNote.slug !== targetNote.slug && sourceNote.body) {
      const titlePattern = `[[${targetNote.data.title}]]`;
      const slugPattern = `[[${targetNote.slug}]]`;
      
      if (sourceNote.body.includes(titlePattern) || sourceNote.body.includes(slugPattern)) {
        links.push({
          source: sourceNote.slug,
          target: targetNote.slug
        });
      }
    }
  }
}

const graphData = { nodes, links };
const nodeCount = nodes.length;
const linkCount = links.length;
const connectionPercentage = nodeCount > 1 ? Math.round((linkCount / Math.max(nodeCount * (nodeCount - 1) / 2, 1)) * 100) : 0;
