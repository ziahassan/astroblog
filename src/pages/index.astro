---
import Layout from '../layouts/layout.astro';
import { getCollection, getEntry, render } from 'astro:content';

// Recent blog posts
let recentBlog: any[] = [];
try {
  const posts = await getCollection('blog', ({ data }: any) => !data.draft);
  recentBlog = posts
    .sort((a: any, b: any) => new Date(b.data.publishDate).valueOf() - new Date(a.data.publishDate).valueOf())
    .slice(0, 2);
} catch (e) {}

// Recent notes
let recentNotes: any[] = [];
try {
  const notes = await getCollection('notes');
  recentNotes = (notes as any[])
    .sort((a, b) => {
      const aDate = (a.data.created || a.data.publishDate || new Date(0)) as Date;
      const bDate = (b.data.created || b.data.publishDate || new Date(0)) as Date;
      return new Date(bDate).valueOf() - new Date(aDate).valueOf();
    })
    .slice(0, 2);
} catch (e) {}

function noteExcerpt(body: string): string {
  return (body || '')
    .replace(/\[\[([^\]]+)\]\]/g, '$1')
    .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
    .replace(/#{1,6}\s+/gm, '')
    .replace(/\*\*([^*]+)\*\*/g, '$1')
    .replace(/\*([^*]+)\*/g, '$1')
    .replace(/^[-*+>\d.]+\s+/gm, '')
    .replace(/\n+/g, ' ')
    .replace(/\s+/g, ' ')
    .trim()
    .slice(0, 200);
}

function postExcerpt(post: any): string {
  if (post.data.description) return post.data.description;
  return noteExcerpt(post.body || '');
}

// Mastodon feed — fetched at build time
interface MastodonPost {
  id: string;
  created_at: string;
  content: string;
  url: string;
  media_attachments: any[];
}
let mastodonPosts: MastodonPost[] = [];
try {
  const res = await fetch(
    'https://pkm.social/api/v1/accounts/109330926909065720/statuses?limit=6&exclude_replies=true&exclude_reblogs=true'
  );
  if (res.ok) {
    mastodonPosts = (await res.json()).slice(0, 4);
  }
} catch (e) {
  console.warn('Could not fetch Mastodon posts at build time');
}

function stripHtml(html: string): string {
  return html
    .replace(/<br\s*\/?>/gi, ' ')
    .replace(/<\/p>/gi, ' ')
    .replace(/<[^>]+>/g, '')
    .replace(/&amp;/g, '&')
    .replace(/&lt;/g, '<')
    .replace(/&gt;/g, '>')
    .replace(/&#39;/g, "'")
    .replace(/&quot;/g, '"')
    .replace(/\s+/g, ' ')
    .trim();
}

function shortDate(dateStr: string): string {
  return new Date(dateStr).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}

function monthYear(date: Date): string {
  return new Date(date).toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
}

const nowEntry = await getEntry('pages', 'now');
const { Content: NowContent } = nowEntry ? await render(nowEntry) : { Content: null };
---

<Layout title="Zia Hassan">
  <div class="max-w-4xl mx-auto px-6 py-16">

    <!-- Hero -->
    <section class="mb-20 -mx-6 px-8 pt-14 pb-12 bg-gradient-to-br from-violet-50 via-indigo-50 to-white rounded-2xl">
      <h1 class="text-5xl font-light text-indigo-950 mb-3 tracking-tight" style="font-family: 'Crimson Text', Georgia, serif;">
        Zia Hassan
      </h1>
      <p class="text-lg text-slate-600 leading-relaxed max-w-2xl mb-8">
        I am curious about what it means to be human.
      </p>
      <nav class="flex flex-wrap gap-6 text-sm">
        <a href="https://pkm.social/@Ziahassan" target="_blank" rel="noopener" class="text-violet-600 hover:text-violet-900 font-medium transition-colors">Mastodon</a>
        <a href="https://pixelfed.social/ziahassan" target="_blank" rel="noopener" class="text-violet-600 hover:text-violet-900 font-medium transition-colors">Pixelfed</a>
        <a href="mailto:zhassan4@jh.edu" class="text-violet-600 hover:text-violet-900 font-medium transition-colors">Email</a>
        <a href="/cv" class="text-violet-600 hover:text-violet-900 font-medium transition-colors">CV</a>
      </nav>
    </section>

    <!-- Writing -->
    <section class="mb-16">
      <div class="flex items-end justify-between mb-7">
        <div>
          <h2 class="text-2xl font-light text-gray-900" style="font-family: 'Crimson Text', Georgia, serif;">Writing</h2>
          <p class="text-sm text-gray-400 mt-1">Thoughts on education, AI, and everything in between.</p>
        </div>
        <a href="/blog" class="text-sm text-violet-500 hover:text-violet-700 transition-colors flex-shrink-0 ml-4">All posts →</a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        {recentBlog.map((post: any) => {
          const excerpt = postExcerpt(post);
          return (
            <a
              href={`/blog/${post.slug}`}
              class="group flex flex-col bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-md transition-all overflow-hidden"
            >
              <div class="h-1.5 bg-violet-400 group-hover:bg-violet-500 transition-colors" />
              {post.data.image && (
                <div class="overflow-hidden" style="height:160px;">
                  <img src={post.data.image} alt="" class="w-full h-full object-cover" />
                </div>
              )}
              <div class="p-6 flex flex-col flex-1">
                <span class="card-label text-violet-500 mb-3">Writing</span>
                <h3 class="text-xl font-medium text-gray-900 leading-snug mb-3 group-hover:text-violet-700 transition-colors" style="font-family: 'Crimson Text', Georgia, serif;">
                  {post.data.title}
                </h3>
                {excerpt && (
                  <p class="text-sm text-gray-500 leading-relaxed flex-1 mb-5 line-clamp-3">{excerpt}</p>
                )}
                <div class="flex items-center justify-between mt-auto pt-2 border-t border-gray-50">
                  <span class="text-xs text-amber-500 font-medium">{monthYear(post.data.publishDate)}</span>
                  <span class="text-violet-400 group-hover:text-violet-600 transition-colors text-sm">→</span>
                </div>
              </div>
            </a>
          );
        })}
        {recentBlog.length === 0 && (
          <p class="text-sm text-gray-400 col-span-2">No posts yet.</p>
        )}
      </div>
    </section>

    <!-- Notes from the garden -->
    <section class="mb-16">
      <div class="flex items-end justify-between mb-7">
        <div>
          <h2 class="text-2xl font-light text-gray-900" style="font-family: 'Crimson Text', Georgia, serif;">From the Garden</h2>
          <p class="text-sm text-gray-400 mt-1">Atomic notes, research threads, and works in progress.</p>
        </div>
        <a href="/notes" class="text-sm text-teal-500 hover:text-teal-700 transition-colors flex-shrink-0 ml-4">All notes →</a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        {recentNotes.map((note: any) => {
          const title = note.data.title || (note.id || note.slug)
            .replace(/\.mdx?$/, '')
            .replace(/^\d{4}-\d{2}-\d{2}-?/, '')
            .replace(/-/g, ' ')
            .trim() || note.slug;
          const excerpt = noteExcerpt(note.body || '');
          const tags: string[] = note.data.tags || [];
          return (
            <a
              href={`/notes/${note.slug}`}
              class="group flex flex-col bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-md transition-all overflow-hidden"
            >
              <div class="h-1.5 bg-teal-400 group-hover:bg-teal-500 transition-colors" />
              <div class="p-6 flex flex-col flex-1">
                <span class="card-label text-teal-500 mb-3">Note</span>
                <h3 class="text-xl font-medium text-gray-900 leading-snug mb-3 group-hover:text-teal-700 transition-colors" style="font-family: 'Crimson Text', Georgia, serif;">
                  {title}
                </h3>
                {excerpt && (
                  <p class="text-sm text-gray-500 leading-relaxed flex-1 mb-5 line-clamp-3">{excerpt}</p>
                )}
                <div class="flex items-center justify-between mt-auto pt-2 border-t border-gray-50">
                  <div class="flex gap-1.5">
                    {tags.slice(0, 2).map(tag => (
                      <span class="text-xs bg-teal-50 text-teal-600 border border-teal-100 rounded px-1.5 py-0.5">{tag}</span>
                    ))}
                  </div>
                  <span class="text-teal-400 group-hover:text-teal-600 transition-colors text-sm">→</span>
                </div>
              </div>
            </a>
          );
        })}
        {recentNotes.length === 0 && (
          <p class="text-sm text-gray-400 col-span-2">No notes yet.</p>
        )}
      </div>
    </section>

    <!-- Bottom row: Mastodon + Currently -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">

      <!-- Mastodon -->
      <section class="bg-violet-50 rounded-2xl p-6 border border-violet-100">
        <div class="flex items-baseline justify-between mb-5">
          <h2 class="section-label-violet">On Mastodon</h2>
          <a href="https://pkm.social/@Ziahassan" target="_blank" rel="noopener" class="text-xs text-violet-400 hover:text-violet-600 transition-colors">Follow →</a>
        </div>
        {mastodonPosts.length > 0 ? (
          <div class="space-y-4">
            {mastodonPosts.map((post) => {
              const text = stripHtml(post.content);
              const truncated = text.length > 260 ? text.slice(0, 258) + '…' : text;
              return (
                <div class="text-sm border-l-2 border-violet-200 pl-3">
                  <p class="text-slate-700 leading-relaxed mb-1.5">{truncated}</p>
                  <a
                    href={post.url}
                    target="_blank"
                    rel="noopener"
                    class="text-xs text-violet-400 hover:text-violet-600 transition-colors"
                  >
                    {shortDate(post.created_at)}
                  </a>
                </div>
              );
            })}
          </div>
        ) : (
          <p class="text-sm text-violet-400">
            <a href="https://pkm.social/@Ziahassan" target="_blank" rel="noopener" class="hover:text-violet-600">
              @Ziahassan@pkm.social
            </a>
          </p>
        )}
      </section>

      <!-- Currently -->
      <section class="bg-amber-50 rounded-2xl p-6 border border-amber-100">
        <div class="mb-5">
          <h2 class="section-label-amber">Currently</h2>
        </div>
        <div class="currently-content text-sm text-slate-700 leading-relaxed">
          {NowContent && <NowContent />}
        </div>
      </section>

    </div>

    <!-- Newsletter -->
    <section class="mt-12 pt-8 border-t border-gray-100">
      <h2 class="section-label mb-4">Stay in touch</h2>
      <p class="text-sm text-gray-500 mb-4">A general purpose newsletter: hand picked web gems and hand rolled thoughts about how humanity is changing.</p>
      <form
        action="https://buttondown.com/api/emails/embed-subscribe/ziahassan"
        method="post"
        class="flex gap-2 max-w-sm"
      >
        <input
          type="email"
          name="email"
          id="bd-email"
          placeholder="your@email.com"
          required
          class="flex-1 px-3 py-2 text-sm bg-white border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-violet-300 focus:border-transparent"
        />
        <button
          type="submit"
          class="px-4 py-2 text-sm font-medium bg-violet-600 text-white rounded-lg hover:bg-violet-700 transition-colors"
        >
          Subscribe
        </button>
      </form>
    </section>

    <!-- Explore -->
    <section class="mt-12 pt-8 border-t border-gray-100">
      <h2 class="section-label mb-5">Explore</h2>
      <div class="flex flex-wrap gap-3">
        <a href="/articles" class="explore-pill">Articles &amp; papers</a>
        <a href="/teaching" class="explore-pill">Teaching &amp; presentations</a>
        <a href="/media" class="explore-pill">Podcasts &amp; media</a>
        <a href="/notes" class="explore-pill">Knowledge graph</a>
        <a href="/blog" class="explore-pill">Blog archive</a>
      </div>
    </section>

  </div>
</Layout>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Crimson+Text:ital,wght@0,400;0,600;1,400&display=swap');

  .card-label {
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .section-label {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #7c3aed; /* violet-700 */
  }

  .section-label-violet {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #6d28d9;
  }

  .section-label-amber {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #b45309;
  }

  .explore-pill {
    display: inline-block;
    padding: 0.35rem 0.85rem;
    background: #f5f3ff;
    color: #5b21b6;
    border: 1px solid #ddd6fe;
    border-radius: 9999px;
    font-size: 0.8rem;
    font-weight: 500;
    transition: background 0.15s, color 0.15s;
  }

  .explore-pill:hover {
    background: #ede9fe;
    color: #3b0764;
  }

  .currently-content :global(p) {
    margin-bottom: 0.75rem;
  }
  .currently-content :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
