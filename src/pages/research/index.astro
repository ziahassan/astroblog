---
import Layout from '../../layouts/layout.astro';
import { getCollection } from 'astro:content';

const papers = await getCollection('research');

const sorted = papers.sort((a, b) => b.data.year - a.data.year);

const statusLabel = {
  'preprint': 'Preprint',
  'under-review': 'Under Review',
  'published': 'Published',
};

const statusColors = {
  'preprint': 'bg-amber-50 text-amber-700 border-amber-200',
  'under-review': 'bg-blue-50 text-blue-700 border-blue-200',
  'published': 'bg-green-50 text-green-700 border-green-200',
};

const allTags = [...new Set(papers.flatMap(p => p.data.tags || []))].sort();
---

<Layout title="Research">
  <div class="max-w-4xl mx-auto px-4">

    <header class="py-8 border-b border-gray-200">
      <div class="flex items-baseline justify-between">
        <h1 class="text-3xl font-light text-gray-800">Research</h1>
        <span class="text-sm text-gray-500">{papers.length} paper{papers.length !== 1 ? 's' : ''}</span>
      </div>
      <p class="text-gray-500 mt-2">Publications, preprints, and work in progress.</p>
    </header>

    {allTags.length > 0 && (
      <div class="py-4 flex flex-wrap gap-2 border-b border-gray-100">
        <button class="tag-filter active px-3 py-1 text-xs font-medium rounded-full bg-gray-900 text-white" data-tag="all">
          All
        </button>
        {allTags.map(tag => (
          <button
            class="tag-filter px-3 py-1 text-xs font-medium rounded-full bg-gray-100 text-gray-600 hover:bg-gray-200 transition-colors"
            data-tag={tag}
          >
            {tag}
          </button>
        ))}
      </div>
    )}

    <div class="py-6 space-y-6" id="papers-list">
      {sorted.map(paper => (
        <article
          class="paper-item group border border-gray-200 rounded-lg p-6 hover:border-gray-300 transition-colors"
          data-tags={JSON.stringify(paper.data.tags || [])}
        >
          <div class="flex items-start justify-between gap-4 mb-2">
            <h2 class="text-lg font-medium text-gray-900 leading-snug">
              <a href={`/research/${paper.slug}`} class="hover:text-blue-600 transition-colors">
                {paper.data.title}
              </a>
            </h2>
            <span class={`flex-shrink-0 text-xs font-medium px-2.5 py-1 rounded border ${statusColors[paper.data.status]}`}>
              {statusLabel[paper.data.status]}
            </span>
          </div>

          <p class="text-sm text-gray-500 mb-3">
            {paper.data.authors.join(', ')} &middot; {paper.data.venue} &middot; {paper.data.year}
          </p>

          <p class="text-sm text-gray-600 leading-relaxed line-clamp-3">
            {paper.data.abstract}
          </p>

          {paper.data.tags && paper.data.tags.length > 0 && (
            <div class="flex flex-wrap gap-1.5 mt-4">
              {paper.data.tags.map(tag => (
                <span class="px-2 py-0.5 bg-gray-100 text-gray-500 text-xs rounded">
                  {tag}
                </span>
              ))}
            </div>
          )}
        </article>
      ))}

      {papers.length === 0 && (
        <div class="py-16 text-center text-gray-400">
          <p>No papers yet.</p>
        </div>
      )}
    </div>

    <div id="empty-state" class="hidden py-12 text-center text-gray-400">
      <p>No papers match this filter.</p>
    </div>

  </div>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const filters = document.querySelectorAll('.tag-filter');
    const items = document.querySelectorAll('.paper-item');
    const emptyState = document.getElementById('empty-state');
    const papersList = document.getElementById('papers-list');

    filters.forEach(btn => {
      btn.addEventListener('click', () => {
        const tag = (btn as HTMLElement).dataset.tag;

        filters.forEach(b => {
          b.classList.remove('active', 'bg-gray-900', 'text-white');
          b.classList.add('bg-gray-100', 'text-gray-600');
        });
        btn.classList.add('active', 'bg-gray-900', 'text-white');
        btn.classList.remove('bg-gray-100', 'text-gray-600');

        let visible = 0;
        items.forEach(item => {
          const tags = JSON.parse((item as HTMLElement).dataset.tags || '[]');
          const show = tag === 'all' || tags.includes(tag);
          (item as HTMLElement).style.display = show ? '' : 'none';
          if (show) visible++;
        });

        emptyState?.classList.toggle('hidden', visible > 0);
        papersList?.classList.toggle('hidden', visible === 0);
      });
    });
  });
</script>

<style>
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
