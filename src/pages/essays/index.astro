---
// src/pages/essays/index.astro
import Layout from '../../layouts/layout.astro';
import { getCollection } from 'astro:content';

const essays = await getCollection('essays', ({ data }) => {
  return data.draft !== true; // Only show published essays
});

// Sort by publish date (newest first)
const sortedEssays = essays.sort((a, b) => 
  new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime()
);

// Get recent essays (limit to 20)
const recentEssays = sortedEssays.slice(0, 20);

// Get featured essay (most recent)
const featuredEssay = recentEssays[0];
const otherEssays = recentEssays.slice(1);

// Collect all tags and their counts
const tagCounts = {};
essays.forEach(essay => {
  if (essay.data.tags) {
    essay.data.tags.forEach(tag => {
      tagCounts[tag] = (tagCounts[tag] || 0) + 1;
    });
  }
});

// Sort tags by count (most popular first)
const sortedTags = Object.entries(tagCounts)
  .sort(([,a], [,b]) => b - a)
  .map(([tag, count]) => ({ tag, count }));

// Helper function to get a default hero image based on tags or title
function getHeroImage(essay) {
  if (essay.data.heroImage) {
    return essay.data.heroImage;
  }
  
  // Generate a gradient based on the essay content
  const colors = [
    'from-blue-400 via-purple-500 to-purple-600',
    'from-green-400 via-blue-500 to-purple-600',
    'from-pink-400 via-red-500 to-yellow-500',
    'from-indigo-400 via-purple-500 to-pink-500',
    'from-teal-400 via-blue-500 to-indigo-600',
    'from-orange-400 via-red-500 to-pink-500'
  ];
  
  const hash = essay.slug.split('').reduce((a, b) => {
    a = ((a << 5) - a) + b.charCodeAt(0);
    return a & a;
  }, 0);
  
  return colors[Math.abs(hash) % colors.length];
}

// Reading time calculator
function calculateReadingTime(content) {
  const wordsPerMinute = 200;
  const wordCount = content.split(' ').length;
  return Math.ceil(wordCount / wordsPerMinute);
}
---

<Layout title="Essays">
  <div class="min-h-screen bg-gradient-to-br from-gray-50 via-white to-blue-50/30">
    
    <!-- Hero Section -->
    <section class="relative overflow-hidden bg-gradient-to-br from-slate-900 via-blue-900 to-indigo-900">
      <div class="absolute inset-0 bg-black/20"></div>
      <div class="relative max-w-6xl mx-auto px-6 py-20">
        <div class="text-center text-white">
          <h1 class="text-5xl md:text-6xl font-light mb-6 tracking-tight">
            Essays & Ideas
          </h1>
          <p class="text-xl md:text-2xl text-blue-100 mb-8 max-w-3xl mx-auto leading-relaxed">
            Long-form thoughts on AI, education, and the future of learning
          </p>
          <div class="flex items-center justify-center gap-8 text-sm text-blue-200">
            <div class="flex items-center gap-2">
              <span class="w-2 h-2 bg-blue-400 rounded-full"></span>
              <span>{essays.length} essays</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="w-2 h-2 bg-green-400 rounded-full"></span>
              <span>{sortedTags.length} topics</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="w-2 h-2 bg-purple-400 rounded-full"></span>
              <span>Updated weekly</span>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Decorative elements -->
      <div class="absolute top-20 left-10 w-32 h-32 bg-blue-500/10 rounded-full blur-3xl"></div>
      <div class="absolute bottom-20 right-10 w-40 h-40 bg-purple-500/10 rounded-full blur-3xl"></div>
    </section>

    <div class="max-w-6xl mx-auto px-6">
      
      <!-- Featured Essay -->
      {featuredEssay && (
        <section class="relative -mt-16 mb-16">
          <div class="bg-white rounded-2xl shadow-xl overflow-hidden border border-gray-100">
            <div class="grid md:grid-cols-2 gap-0">
              <!-- Hero Image -->
              <div class="relative h-64 md:h-auto">
                {featuredEssay.data.heroImage ? (
                  <img 
                    src={featuredEssay.data.heroImage} 
                    alt={featuredEssay.data.title}
                    class="w-full h-full object-cover"
                  />
                ) : (
                  <div class={`w-full h-full bg-gradient-to-br ${getHeroImage(featuredEssay)} flex items-center justify-center`}>
                    <div class="text-center text-white p-8">
                      <div class="text-4xl mb-4">📝</div>
                      <div class="text-lg font-medium opacity-90">{featuredEssay.data.title}</div>
                    </div>
                  </div>
                )}
                <div class="absolute top-4 left-4">
                  <span class="bg-black/80 text-white px-3 py-1 rounded-full text-xs font-medium">
                    Latest Essay
                  </span>
                </div>
              </div>
              
              <!-- Content -->
              <div class="p-8 flex flex-col justify-center">
                {featuredEssay.data.tags && featuredEssay.data.tags.length > 0 && (
                  <div class="flex flex-wrap gap-2 mb-4">
                    {featuredEssay.data.tags.slice(0, 3).map(tag => (
                      <span class="px-3 py-1 bg-blue-50 text-blue-600 text-sm rounded-full font-medium">
                        {tag}
                      </span>
                    ))}
                  </div>
                )}
                
                <h2 class="text-2xl md:text-3xl font-semibold text-gray-900 mb-4 leading-tight">
                  <a 
                    href={`/essays/${featuredEssay.slug}`} 
                    class="hover:text-blue-600 transition-colors"
                  >
                    {featuredEssay.data.title}
                  </a>
                </h2>
                
                <!-- Byline and metadata -->
                <div class="flex items-center gap-4 text-sm text-gray-500 mb-6">
                  <span class="font-medium text-gray-700">By Zia Hassan</span>
                  <span>•</span>
                  <time class="font-mono">
                    {new Date(featuredEssay.data.publishDate).toLocaleDateString('en-US', {
                      year: 'numeric',
                      month: 'long',
                      day: 'numeric'
                    })}
                  </time>
                  <span>•</span>
                  <span>{calculateReadingTime(featuredEssay.body || '')} min read</span>
                </div>
                
                {featuredEssay.data.description && (
                  <p class="text-gray-600 leading-relaxed mb-6 text-lg">
                    {featuredEssay.data.description}
                  </p>
                )}
                
                <a 
                  href={`/essays/${featuredEssay.slug}`} 
                  class="inline-flex items-center px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-all font-medium group"
                >
                  Read full essay
                  <span class="ml-2 group-hover:translate-x-1 transition-transform">→</span>
                </a>
              </div>
            </div>
          </div>
        </section>
      )}

      <!-- Tag Cloud -->
      {sortedTags.length > 0 && (
        <section class="mb-16">
          <div class="bg-white rounded-xl p-8 border border-gray-100 shadow-sm">
            <h2 class="text-2xl font-semibold text-gray-800 mb-6 text-center">Explore by Topic</h2>
            <div class="flex flex-wrap justify-center gap-3">
              {sortedTags.map(({ tag, count }) => {
                // Calculate size based on count
                const maxCount = Math.max(...sortedTags.map(t => t.count));
                const minSize = 0.875; // text-sm
                const maxSize = 1.25;  // text-xl
                const size = minSize + (maxSize - minSize) * (count / maxCount);
                
                return (
                  <a 
                    href={`/essays/tags/${tag}`}
                    class="group inline-flex items-center gap-2 px-4 py-2 bg-gray-50 hover:bg-blue-50 border border-gray-200 hover:border-blue-300 rounded-full transition-all duration-200 hover:shadow-sm"
                    style={`font-size: ${size}rem`}
                  >
                    <span class="font-medium text-gray-700 group-hover:text-blue-600 transition-colors">
                      {tag}
                    </span>
                    <span class="text-xs text-gray-500 bg-white group-hover:bg-blue-100 px-2 py-0.5 rounded-full font-mono transition-colors">
                      {count}
                    </span>
                  </a>
                );
              })}
            </div>
          </div>
        </section>
      )}

      <!-- Essay Search -->
      <section class="mb-16">
        <div class="bg-white rounded-xl border border-gray-100 shadow-sm">
          <div class="p-6 bg-gradient-to-r from-gray-50 to-blue-50/50">
            <div class="max-w-lg mx-auto relative">
              <div class="relative">
                <input
                  type="text"
                  id="essay-search"
                  placeholder="Search essays, ideas, and insights..."
                  class="w-full px-5 py-4 bg-white border-2 border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent text-gray-700 shadow-sm transition-all"
                  autocomplete="off"
                />
                <div class="absolute right-4 top-1/2 transform -translate-y-1/2 text-gray-400">
                  <kbd class="px-2 py-1 bg-gray-100 rounded text-xs font-mono">⌘K</kbd>
                </div>
              </div>
              
              <!-- Search Results Dropdown -->
              <div 
                id="essay-search-results" 
                class="absolute top-full left-0 right-0 mt-2 bg-white border border-gray-200 rounded-xl shadow-2xl max-h-96 overflow-y-auto z-[100] hidden"
                style="min-width: 400px;"
              >
                <div class="px-4 py-3 text-sm text-gray-500 border-b border-gray-100 bg-gray-50 font-medium">
                  <span id="essay-results-count"></span>
                </div>
                <div id="essay-results-list"></div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Recent Essays Grid -->
      <div id="essays-list">
        <div class="flex items-center justify-between mb-8">
          <h2 class="text-3xl font-semibold text-gray-800">Recent Essays</h2>
          <span class="text-sm text-gray-500 bg-gray-100 px-4 py-2 rounded-full font-medium">
            {recentEssays.length} essay{recentEssays.length === 1 ? '' : 's'}
          </span>
        </div>
        
        <div class="grid md:grid-cols-2 gap-8 mb-16">
          {otherEssays.map((essay, index) => (
            <article key={essay.slug} class="group">
              <div class="bg-white rounded-xl border border-gray-100 hover:border-gray-200 hover:shadow-lg transition-all duration-300 overflow-hidden">
                
                <!-- Essay Image -->
                <div class="relative h-48 overflow-hidden">
                  {essay.data.heroImage ? (
                    <img 
                      src={essay.data.heroImage} 
                      alt={essay.data.title}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                    />
                  ) : (
                    <div class={`w-full h-full bg-gradient-to-br ${getHeroImage(essay)} group-hover:scale-105 transition-transform duration-300 flex items-center justify-center`}>
                      <div class="text-center text-white">
                        <div class="text-2xl mb-2">✍️</div>
                        <div class="text-sm font-medium opacity-90 px-4">{essay.data.title}</div>
                      </div>
                    </div>
                  )}
                  
                  <!-- Reading time badge -->
                  <div class="absolute top-3 right-3">
                    <span class="bg-black/70 text-white px-2 py-1 rounded-md text-xs font-medium">
                      {calculateReadingTime(essay.body || '')} min
                    </span>
                  </div>
                </div>
                
                <!-- Essay Content -->
                <div class="p-6">
                  <!-- Metadata -->
                  <div class="flex items-center gap-3 text-sm text-gray-500 mb-3">
                    <span class="font-medium text-gray-700">By Zia Hassan</span>
                    <span>•</span>
                    <time class="font-mono">
                      {new Date(essay.data.publishDate).toLocaleDateString('en-US', {
                        month: 'short',
                        day: 'numeric',
                        year: 'numeric'
                      })}
                    </time>
                    
                    {essay.data.tags && essay.data.tags.length > 0 && (
                      <>
                        <span>•</span>
                        <div class="flex gap-1">
                          {essay.data.tags.slice(0, 2).map(tag => (
                            <a 
                              href={`/essays/tags/${tag}`}
                              class="px-2 py-1 bg-blue-50 text-blue-600 text-xs rounded-md font-medium hover:bg-blue-100 transition-colors"
                            >
                              {tag}
                            </a>
                          ))}
                          {essay.data.tags.length > 2 && (
                            <span class="text-xs text-gray-400">+{essay.data.tags.length - 2}</span>
                          )}
                        </div>
                      </>
                    )}
                  </div>

                  <!-- Title -->
                  <h3 class="text-xl font-semibold text-gray-900 mb-3 leading-tight">
                    <a 
                      href={`/essays/${essay.slug}`} 
                      class="hover:text-blue-600 transition-colors"
                    >
                      {essay.data.title}
                    </a>
                  </h3>

                  <!-- Description -->
                  {essay.data.description && (
                    <p class="text-gray-600 leading-relaxed mb-4 line-clamp-3">
                      {essay.data.description}
                    </p>
                  )}

                  <!-- Read More Link -->
                  <a 
                    href={`/essays/${essay.slug}`} 
                    class="inline-flex items-center text-sm text-blue-600 hover:text-blue-800 font-medium group-hover:translate-x-1 transition-all"
                  >
                    Continue reading
                    <span class="ml-1">→</span>
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>

      <!-- Newsletter Signup -->
      <section class="mb-16">
        <div class="bg-gradient-to-br from-blue-600 via-purple-600 to-indigo-700 rounded-2xl p-8 md:p-12 text-center text-white relative overflow-hidden">
          <div class="relative z-10">
            <h3 class="text-2xl md:text-3xl font-semibold mb-4">Stay Updated</h3>
            <p class="text-blue-100 mb-8 max-w-2xl mx-auto text-lg">
              Get notified when new essays are published. No spam, just thoughtful content delivered to your inbox.
            </p>
            <div class="flex flex-col sm:flex-row gap-4 max-w-md mx-auto">
              <input 
                type="email" 
                placeholder="Enter your email"
                class="flex-1 px-4 py-3 rounded-lg bg-white/10 border border-white/20 text-white placeholder-blue-200 focus:outline-none focus:ring-2 focus:ring-white/50 backdrop-blur"
              />
              <button class="px-6 py-3 bg-white text-blue-600 rounded-lg font-medium hover:bg-blue-50 transition-colors">
                Subscribe
              </button>
            </div>
          </div>
          
          <!-- Decorative elements -->
          <div class="absolute top-0 right-0 w-32 h-32 bg-white/5 rounded-full -translate-y-16 translate-x-16"></div>
          <div class="absolute bottom-0 left-0 w-24 h-24 bg-white/5 rounded-full translate-y-12 -translate-x-12"></div>
        </div>
      </section>

      <!-- Archive Link -->
      {essays.length > 20 && (
        <section class="text-center py-8 mb-16">
          <div class="bg-white rounded-xl p-8 border border-gray-100 shadow-sm">
            <h3 class="text-xl font-semibold text-gray-800 mb-3">Explore the Archives</h3>
            <p class="text-gray-600 mb-6 max-w-2xl mx-auto">
              Dive deeper into {essays.length - 20} more essays covering everything from AI breakthroughs to educational philosophy
            </p>
            <a 
              href="/essays/archive" 
              class="inline-flex items-center px-8 py-4 bg-gray-900 text-white rounded-xl hover:bg-gray-800 transition-colors font-medium text-lg"
            >
              Browse All Essays
              <span class="ml-2">📚</span>
            </a>
          </div>
        </section>
      )}

      <!-- Empty State -->
      {essays.length === 0 && (
        <div class="text-center py-20">
          <div class="text-6xl mb-6">📝</div>
          <h2 class="text-2xl font-semibold text-gray-800 mb-4">No essays yet</h2>
          <p class="text-gray-600 text-lg">Check back soon for thoughtful content and fresh perspectives!</p>
        </div>
      )}

    </div>
  </div>
</Layout>

<!-- Essay Search Functionality -->
<script define:vars={{ essays: sortedEssays }}>
  // Add a small delay to ensure DOM is fully ready
  function initializeEssaySearch() {
    console.log('Initializing essay search...');
    console.log('Essays data available:', essays ? essays.length : 'no data');
    
    const searchInput = document.getElementById('essay-search');
    const searchResults = document.getElementById('essay-search-results');
    const resultsList = document.getElementById('essay-results-list');
    const resultsCount = document.getElementById('essay-results-count');
    
    if (!searchInput) {
      console.error('Search input not found - retrying in 100ms');
      setTimeout(initializeEssaySearch, 100);
      return;
    }
    
    if (!searchResults || !resultsList || !resultsCount) {
      console.error('Search elements not found - retrying in 100ms');
      setTimeout(initializeEssaySearch, 100);
      return;
    }
    
    console.log('All search elements found, setting up search functionality');
    
    let currentResults = [];
    let selectedIndex = -1;
    let searchTimeout;
    
    // Debounced search function
    function performSearch(query) {
      console.log('Search triggered for:', query);
      
      // Clear previous timeout
      if (searchTimeout) {
        clearTimeout(searchTimeout);
      }
      
      // Debounce search by 150ms
      searchTimeout = setTimeout(() => {
        executeSearch(query);
      }, 150);
    }
    
    function executeSearch(query) {
      console.log('Executing search for:', query);
      
      if (!query.trim()) {
        hideResults();
        return;
      }
      
      if (!essays || essays.length === 0) {
        console.error('No essays data available');
        showNoResults(query);
        return;
      }
      
      try {
        // Simple text matching
        const matchingEssays = essays.filter(essay => {
          if (!essay || !essay.data) return false;
          
          const title = (essay.data.title || '').toLowerCase();
          const description = (essay.data.description || '').toLowerCase();
          const tags = (essay.data.tags || []).join(' ').toLowerCase();
          const searchTerm = query.toLowerCase();
          
          return title.includes(searchTerm) || 
                 description.includes(searchTerm) || 
                 tags.includes(searchTerm);
        });
        
        currentResults = matchingEssays;
        selectedIndex = -1;
        
        console.log('Search completed, found:', currentResults.length, 'results');
        
        if (currentResults.length > 0) {
          showResults(matchingEssays.slice(0, 6));
        } else {
          showNoResults(query);
        }
      } catch (error) {
        console.error('Search error:', error);
        showNoResults(query);
      }
    }
    
    // Show search results
    function showResults(searchResultsArray) {
      try {
        console.log('Displaying', searchResultsArray.length, 'results');
        
        resultsCount.textContent = `${currentResults.length} essay${currentResults.length === 1 ? '' : 's'} found`;
        
        const resultsHTML = searchResultsArray.map((essay, index) => {
          if (!essay || !essay.data) return '';
          
          return `
            <div class="essay-search-item p-4 hover:bg-blue-50 cursor-pointer border-b border-gray-100 last:border-b-0 transition-colors" data-index="${index}">
              <div class="flex items-start justify-between">
                <div class="flex-1">
                  <div class="font-semibold text-gray-900 mb-2">${essay.data.title || 'Untitled'}</div>
                  ${essay.data.description ? `<div class="text-sm text-gray-600 leading-relaxed mb-3">${essay.data.description}</div>` : ''}
                  ${essay.data.tags && essay.data.tags.length > 0 ? `
                    <div class="flex flex-wrap gap-1">
                      ${essay.data.tags.slice(0, 3).map(tag => `<span class="inline-block px-2 py-1 bg-blue-50 text-blue-600 text-xs rounded-md font-medium">${tag}</span>`).join('')}
                    </div>
                  ` : ''}
                </div>
                <div class="text-right text-xs text-gray-400 ml-4 flex-shrink-0">
                  <div class="mb-1 font-mono">${essay.data.publishDate ? new Date(essay.data.publishDate).toLocaleDateString() : ''}</div>
                </div>
              </div>
            </div>
          `;
        }).filter(html => html).join('');
        
        resultsList.innerHTML = resultsHTML;
        searchResults.classList.remove('hidden');
        console.log('Results displayed successfully');
        
      } catch (error) {
        console.error('Error displaying results:', error);
      }
    }
    
    // Show no results message
    function showNoResults(query) {
      console.log('Showing no results for:', query);
      
      try {
        resultsCount.textContent = 'No essays found';
        resultsList.innerHTML = `
          <div class="p-6 text-center text-gray-500">
            <div class="text-3xl mb-3">🔍</div>
            <div class="font-medium mb-1">No essays found for "${query}"</div>
            <div class="text-sm">Try a different search term or browse by topic</div>
          </div>
        `;
        searchResults.classList.remove('hidden');
      } catch (error) {
        console.error('Error showing no results:', error);
      }
    }
    
    // Hide search results
    function hideResults() {
      try {
        searchResults.classList.add('hidden');
        selectedIndex = -1;
      } catch (error) {
        console.error('Error hiding results:', error);
      }
    }
    
    // Navigate to selected result
    function selectResult(index) {
      try {
        if (currentResults[index] && currentResults[index].slug) {
          console.log('Navigating to:', currentResults[index].slug);
          window.location.href = `/essays/${currentResults[index].slug}`;
        }
      } catch (error) {
        console.error('Error selecting result:', error);
      }
    }
    
    // Event listeners with error handling
    try {
      searchInput.addEventListener('input', (e) => {
        console.log('Input event triggered:', e.target.value);
        performSearch(e.target.value);
      });
      
      searchInput.addEventListener('focus', () => {
        console.log('Search input focused');
      });
      
      // Click on search results
      resultsList.addEventListener('click', (e) => {
        const item = e.target.closest('.essay-search-item');
        if (item) {
          const index = parseInt(item.dataset.index);
          console.log('Result clicked, index:', index);
          selectResult(index);
        }
      });
      
      // Click outside to close
      document.addEventListener('click', (e) => {
        if (!e.target.closest('#essay-search') && !e.target.closest('#essay-search-results')) {
          hideResults();
        }
      });
      
      // Global keyboard shortcut (Cmd+K or Ctrl+K)
      document.addEventListener('keydown', (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
          e.preventDefault();
          searchInput.focus();
          searchInput.select();
        }
      });
      
      console.log('Search event listeners attached successfully');
      
    } catch (error) {
      console.error('Error setting up event listeners:', error);
    }
  }
  
  // Try to initialize when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeEssaySearch);
  } else {
    // DOM is already ready
    setTimeout(initializeEssaySearch, 10);
  }
</script>

<style>
  /* Line clamp utility */
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  /* Smooth transitions */
  * {
    transition-property: transform, opacity, background-color, border-color, color, box-shadow;
    transition-duration: 200ms;
    transition-timing-function: ease-in-out;
  }
  
  /* Custom scrollbar */
  #essay-search-results {
    scrollbar-width: thin;
    scrollbar-color: #cbd5e0 #f7fafc;
  }
  
  #essay-search-results::-webkit-scrollbar {
    width: 6px;
  }
  
  #essay-search-results::-webkit-scrollbar-track {
    background: #f7fafc;
  }
  
  #essay-search-results::-webkit-scrollbar-thumb {
    background-color: #cbd5e0;
    border-radius: 3px;
  }
  
  /* Focus styles */
  input:focus {
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
  }
  
  /* Hover effects */
  article:hover {
    transform: translateY(-2px);
  }
</style>