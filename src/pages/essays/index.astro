---
// src/pages/essays/index.astro
import Layout from '../../layouts/layout.astro';
import { getCollection } from 'astro:content';

const essays = await getCollection('essays', ({ data }) => {
  return data.draft !== true; // Only show published essays
});

// Sort by publish date (newest first)
const sortedEssays = essays.sort((a, b) => 
  new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime()
);

// Get recent essays (limit to 20)
const recentEssays = sortedEssays.slice(0, 20);

// Collect all tags and their counts
const tagCounts = {};
essays.forEach(essay => {
  if (essay.data.tags) {
    essay.data.tags.forEach(tag => {
      tagCounts[tag] = (tagCounts[tag] || 0) + 1;
    });
  }
});

// Sort tags by count (most popular first)
const sortedTags = Object.entries(tagCounts)
  .sort(([,a], [,b]) => b - a)
  .map(([tag, count]) => ({ tag, count }));
---

<Layout title="Essays">
  <div class="max-w-5xl mx-auto space-y-12">
    
    <!-- Header -->
    <header class="text-center border-b border-gray-200 pb-8">
      <h1 class="text-4xl font-light text-gray-800 mb-2">Essays</h1>
      <p class="text-gray-600 text-lg">Thoughts on AI, education, and the future of learning</p>
    </header>

    <!-- Tag Cloud -->
    {sortedTags.length > 0 && (
      <section class="bg-gradient-to-r from-blue-50 to-gray-50 rounded-xl p-8 border border-gray-200">
        <h2 class="text-2xl font-light text-gray-800 mb-6 text-center">Explore by Topic</h2>
        <div class="flex flex-wrap justify-center gap-3">
          {sortedTags.map(({ tag, count }) => {
            // Calculate size based on count (min 1rem, max 2rem)
            const maxCount = Math.max(...sortedTags.map(t => t.count));
            const minSize = 0.875; // text-sm
            const maxSize = 1.25;  // text-xl
            const size = minSize + (maxSize - minSize) * (count / maxCount);
            
            return (
              <a 
                href={`/essays/tags/${tag}`}
                class="group inline-flex items-center gap-2 px-4 py-2 bg-white/70 hover:bg-white border border-gray-200 hover:border-blue-300 rounded-full transition-all duration-200 hover:shadow-sm"
                style={`font-size: ${size}rem`}
              >
                <span class="font-medium text-gray-700 group-hover:text-blue-600 transition-colors">
                  {tag}
                </span>
                <span class="text-xs text-gray-500 bg-gray-100 group-hover:bg-blue-100 px-2 py-0.5 rounded-full font-mono transition-colors">
                  {count}
                </span>
              </a>
            );
          })}
        </div>
      </section>
    )}

    <!-- Essay Search -->
    <section class="bg-gray-50 rounded-lg p-6 border border-gray-200">
      <div class="max-w-lg mx-auto relative">
        <div class="relative">
          <input
            type="text"
            id="essay-search"
            placeholder="Search through essays and ideas..."
            class="w-full px-4 py-3 bg-white border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent text-gray-700 shadow-sm"
            autocomplete="off"
          />
          <div class="absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-400">
            <kbd class="px-2 py-1 bg-gray-100 rounded text-xs font-mono">⌘K</kbd>
          </div>
        </div>
        
        <!-- Search Results Dropdown -->
        <div 
          id="essay-search-results" 
          class="absolute top-full left-0 right-0 mt-2 bg-white border border-gray-200 rounded-lg shadow-xl max-h-96 overflow-y-auto z-50 hidden"
        >
          <div class="px-4 py-2 text-sm text-gray-500 border-b border-gray-100 bg-gray-50">
            <span id="essay-results-count"></span>
          </div>
          <div id="essay-results-list"></div>
        </div>
      </div>
    </section>

    <!-- Recent Essays (hidden when searching) -->
    <div id="essays-list">
      <div class="flex items-center justify-between mb-8">
        <h2 class="text-3xl font-light text-gray-800">Recent Essays</h2>
        <span class="text-sm text-gray-500 bg-gray-100 px-3 py-1 rounded-full">
          {recentEssays.length} of {essays.length} essays
        </span>
      </div>
      
      <div class="space-y-8">
        {recentEssays.map(essay => (
          <article key={essay.slug} class="group">
            <div class="p-6 bg-white rounded-lg border border-gray-200 hover:border-gray-300 hover:shadow-sm transition-all duration-200">
              
              <!-- Essay Header -->
              <header class="mb-4">
                <h3 class="text-2xl font-medium text-gray-900 mb-2">
                  <a 
                    href={`/essays/${essay.slug}`} 
                    class="hover:text-blue-600 transition-colors"
                  >
                    {essay.data.title}
                  </a>
                </h3>
                
                <!-- Metadata -->
                <div class="flex items-center gap-4 text-sm text-gray-500">
                  <time class="font-mono">
                    {new Date(essay.data.publishDate).toLocaleDateString('en-US', {
                      year: 'numeric',
                      month: 'long',
                      day: 'numeric'
                    })}
                  </time>
                  
                  {essay.data.tags && essay.data.tags.length > 0 && (
                    <div class="flex flex-wrap gap-1">
                      {essay.data.tags.map(tag => (
                        <a 
                          href={`/essays/tags/${tag}`}
                          class="px-2 py-1 bg-blue-50 text-blue-600 text-xs rounded-md font-medium hover:bg-blue-100 transition-colors"
                        >
                          {tag}
                        </a>
                      ))}
                    </div>
                  )}
                </div>
              </header>

              <!-- Description -->
              {essay.data.description && (
                <p class="text-gray-600 leading-relaxed mb-4">
                  {essay.data.description}
                </p>
              )}

              <!-- Read More Link -->
              <a 
                href={`/essays/${essay.slug}`} 
                class="inline-flex items-center text-sm text-blue-600 hover:text-blue-800 font-medium group-hover:translate-x-1 transition-all"
              >
                Read essay
                <span class="ml-1">→</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>

    <!-- Archive Link -->
    {essays.length > 20 && (
      <section class="text-center py-8 border-t border-gray-200">
        <div class="bg-gray-50 rounded-lg p-8 border border-gray-200">
          <h3 class="text-xl font-medium text-gray-800 mb-2">Looking for more?</h3>
          <p class="text-gray-600 mb-4">
            Explore {essays.length - 20} more essays in the archive
          </p>
          <a 
            href="/essays/archive" 
            class="inline-flex items-center px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors font-medium"
          >
            Browse Archive
            <span class="ml-2">📚</span>
          </a>
        </div>
      </section>
    )}

    <!-- Empty State -->
    {essays.length === 0 && (
      <div class="text-center py-12">
        <div class="text-4xl mb-4">📝</div>
        <h2 class="text-xl font-medium text-gray-800 mb-2">No essays yet</h2>
        <p class="text-gray-600">Check back soon for new content!</p>
      </div>
    )}

  </div>
</Layout>

<!-- Essay Search Functionality -->
<script type="module" define:vars={{ essays: sortedEssays }}>
  import Fuse from 'https://cdn.jsdelivr.net/npm/fuse.js@6.6.2/+esm';
  
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('essay-search');
    const searchResults = document.getElementById('essay-search-results');
    const resultsList = document.getElementById('essay-results-list');
    const resultsCount = document.getElementById('essay-results-count');
    
    if (!searchInput) return;
    
    // Process essays data for search
    const searchEssays = essays.map(essay => ({
      title: essay.data.title,
      slug: essay.slug,
      description: essay.data.description || '',
      tags: essay.data.tags || [],
      publishDate: essay.data.publishDate
    }));
    
    // Configure Fuse.js for better search
    const fuse = new Fuse(searchEssays, {
      keys: [
        { name: 'title', weight: 0.7 },
        { name: 'description', weight: 0.2 },
        { name: 'tags', weight: 0.1 }
      ],
      threshold: 0.4,
      includeScore: true,
      includeMatches: true
    });
    
    let selectedIndex = -1;
    let currentResults = [];
    
    // Search function
    function performSearch(query) {
      if (!query.trim()) {
        hideResults();
        return;
      }
      
      const searchResults = fuse.search(query);
      currentResults = searchResults.map(r => r.item);
      selectedIndex = -1;
      
      if (currentResults.length > 0) {
        showResults(searchResults.slice(0, 6)); // Limit to 6 results
      } else {
        showNoResults(query);
      }
    }
    
    // Show search results
    function showResults(searchResults) {
      const maxResults = 8;
      const limitedResults = searchResults.slice(0, maxResults);
      
      resultsCount.textContent = `${currentResults.length} essay${currentResults.length === 1 ? '' : 's'} found`;
      
      resultsList.innerHTML = limitedResults.map((result, index) => {
        const essay = result.item;
        const score = (1 - result.score) * 100;
        
        // Highlight matches in title
        let highlightedTitle = essay.title;
        if (result.matches) {
          const titleMatch = result.matches.find(m => m.key === 'title');
          if (titleMatch && titleMatch.indices) {
            highlightedTitle = highlightText(essay.title, titleMatch.indices);
          }
        }
        
        return `
          <div class="essay-search-item p-4 hover:bg-blue-50 cursor-pointer border-b border-gray-100 last:border-b-0 transition-colors" data-index="${index}">
            <div class="flex items-start justify-between">
              <div class="flex-1">
                <div class="font-medium text-gray-900 mb-1">${highlightedTitle}</div>
                ${essay.description ? `<div class="text-sm text-gray-600 leading-relaxed mb-2">${essay.description}</div>` : ''}
                ${essay.tags.length > 0 ? `
                  <div class="flex flex-wrap gap-1 mt-2">
                    ${essay.tags.map(tag => `<span class="inline-block px-2 py-1 bg-blue-50 text-blue-600 text-xs rounded-md">${tag}</span>`).join('')}
                  </div>
                ` : ''}
              </div>
              <div class="text-right text-xs text-gray-400 ml-4 flex-shrink-0">
                <div class="mb-1 font-mono">${new Date(essay.publishDate).toLocaleDateString()}</div>
                <div>${Math.round(score)}% match</div>
              </div>
            </div>
          </div>
        `;
      }).join('');
      
      if (searchResults.length > maxResults) {
        resultsList.innerHTML += `
          <div class="p-3 text-center text-sm text-gray-500 border-t">
            ... and ${searchResults.length - maxResults} more results
          </div>
        `;
      }
      
      searchResults.classList.remove('hidden');
    }
    
    // Show no results message
    function showNoResults(query) {
      resultsCount.textContent = 'No essays found';
      resultsList.innerHTML = `
        <div class="p-4 text-center text-gray-500">
          <div class="text-lg">🔍</div>
          <div class="mt-2">No essays found for "${query}"</div>
          <div class="text-sm mt-1">Try a different search term</div>
        </div>
      `;
      searchResults.classList.remove('hidden');
    }
    
    // Hide search results
    function hideResults() {
      searchResults.classList.add('hidden');
      selectedIndex = -1;
    }
    
    // Highlight text matches
    function highlightText(text, indices) {
      let result = '';
      let lastIndex = 0;
      
      indices.forEach(([start, end]) => {
        result += text.slice(lastIndex, start);
        result += `<mark class="bg-yellow-200 px-1 rounded">${text.slice(start, end + 1)}</mark>`;
        lastIndex = end + 1;
      });
      
      result += text.slice(lastIndex);
      return result;
    }
    
    // Navigate to selected result
    function selectResult(index) {
      if (currentResults[index]) {
        window.location.href = `/essays/${currentResults[index].slug}`;
      }
    }
    
    // Update visual selection
    function updateSelection() {
      const items = document.querySelectorAll('.essay-search-item');
      items.forEach((item, index) => {
        if (index === selectedIndex) {
          item.classList.add('bg-blue-100');
          item.scrollIntoView({ block: 'nearest' });
        } else {
          item.classList.remove('bg-blue-100');
        }
      });
    }
    
    // Event listeners
    searchInput.addEventListener('input', (e) => {
      performSearch(e.target.value);
    });
    
    // Keyboard navigation
    searchInput.addEventListener('keydown', (e) => {
      if (!searchResultsEl.classList.contains('hidden')) {
        switch (e.key) {
          case 'ArrowDown':
            e.preventDefault();
            selectedIndex = Math.min(selectedIndex + 1, currentResults.length - 1);
            updateSelection();
            break;
          case 'ArrowUp':
            e.preventDefault();
            selectedIndex = Math.max(selectedIndex - 1, -1);
            updateSelection();
            break;
          case 'Enter':
            e.preventDefault();
            if (selectedIndex >= 0) {
              selectResult(selectedIndex);
            } else if (currentResults.length > 0) {
              selectResult(0);
            }
            break;
          case 'Escape':
            hideResults();
            searchInput.blur();
            break;
        }
      }
    });
    
    // Click on search results
    resultsList.addEventListener('click', (e) => {
      const item = e.target.closest('.essay-search-item');
      if (item) {
        const index = parseInt(item.dataset.index);
        selectResult(index);
      }
    });
    
    // Click outside to close
    document.addEventListener('click', (e) => {
      if (!e.target.closest('#essay-search') && !e.target.closest('#essay-search-results')) {
        hideResults();
      }
    });
    
    // Global keyboard shortcut (Cmd+K or Ctrl+K)
    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        searchInput.focus();
        searchInput.select();
      }
    });
    
    // Focus search on page load
    searchInput.focus();
  });
</script>

<style>
  /* Smooth transitions for all interactive elements */
  a, article {
    transition: all 0.2s ease;
  }
  
  /* Search result transitions */
  .essay-search-item {
    transition: background-color 0.15s ease;
  }
  
  /* Custom scrollbar for search results */
  #essay-search-results {
    scrollbar-width: thin;
    scrollbar-color: #cbd5e0 #f7fafc;
  }
  
  #essay-search-results::-webkit-scrollbar {
    width: 6px;
  }
  
  #essay-search-results::-webkit-scrollbar-track {
    background: #f7fafc;
  }
  
  #essay-search-results::-webkit-scrollbar-thumb {
    background-color: #cbd5e0;
    border-radius: 3px;
  }
</style>