---
// src/pages/essays/archive.astro
import Layout from '../../layouts/layout.astro';
import { getCollection } from 'astro:content';

const essays = await getCollection('essays', ({ data }) => {
  return data.draft !== true; // Only show published essays
});

// Sort by publish date (newest first)
const sortedEssays = essays.sort((a, b) => 
  new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime()
);

// Group essays by year
const essaysByYear = {};
sortedEssays.forEach(essay => {
  const year = new Date(essay.data.publishDate).getFullYear();
  if (!essaysByYear[year]) {
    essaysByYear[year] = [];
  }
  essaysByYear[year].push(essay);
});

// Sort years (newest first)
const years = Object.keys(essaysByYear).sort((a, b) => b - a);

// Collect all tags for filtering
const allTags = new Set();
essays.forEach(essay => {
  if (essay.data.tags) {
    essay.data.tags.forEach(tag => allTags.add(tag));
  }
});
const sortedTags = Array.from(allTags).sort();
---

<Layout title="Essays Archive">
  <div class="max-w-5xl mx-auto space-y-8">
    
    <!-- Header -->
    <header class="text-center border-b border-gray-200 pb-8">
      <div class="mb-4">
        <a href="/essays" class="text-sm text-blue-600 hover:text-blue-800 font-medium">
          ← Back to recent essays
        </a>
      </div>
      <h1 class="text-4xl font-light text-gray-800 mb-2">Archive</h1>
      <p class="text-gray-600 text-lg">
        All {essays.length} essays, organized by year
      </p>
    </header>

    <!-- Filter by Tags -->
    {sortedTags.length > 0 && (
      <section class="bg-gray-50 rounded-lg p-6 border border-gray-200">
        <h2 class="text-lg font-medium text-gray-800 mb-4">Filter by topic</h2>
        <div class="flex flex-wrap gap-2">
          <button 
            class="archive-filter-btn active px-3 py-2 bg-blue-600 text-white text-sm rounded-md hover:bg-blue-700 transition-colors"
            data-filter="all"
          >
            All essays ({essays.length})
          </button>
          {sortedTags.map(tag => {
            const count = essays.filter(e => e.data.tags?.includes(tag)).length;
            return (
              <button 
                class="archive-filter-btn px-3 py-2 bg-white text-gray-700 text-sm rounded-md border border-gray-200 hover:bg-blue-50 hover:text-blue-600 hover:border-blue-200 transition-colors"
                data-filter={tag}
              >
                {tag} ({count})
              </button>
            );
          })}
        </div>
      </section>
    )}

    <!-- Essays by Year -->
    <section class="space-y-12">
      {years.map(year => (
        <div key={year} class="year-section">
          <h2 class="text-3xl font-light text-gray-800 mb-6 pb-2 border-b border-gray-200">
            {year}
            <span class="text-sm text-gray-500 font-normal ml-2">
              ({essaysByYear[year].length} essay{essaysByYear[year].length === 1 ? '' : 's'})
            </span>
          </h2>
          
          <div class="grid gap-6">
            {essaysByYear[year].map(essay => (
              <article 
                key={essay.slug} 
                class="essay-item group p-4 bg-white rounded-lg border border-gray-200 hover:border-gray-300 hover:shadow-sm transition-all duration-200"
                data-tags={essay.data.tags ? essay.data.tags.join(',') : ''}
              >
                <div class="flex items-start gap-4">
                  <!-- Date -->
                  <div class="flex-shrink-0 text-right">
                    <time class="text-sm text-gray-500 font-mono">
                      {new Date(essay.data.publishDate).toLocaleDateString('en-US', {
                        month: 'short',
                        day: 'numeric'
                      })}
                    </time>
                  </div>
                  
                  <!-- Content -->
                  <div class="flex-1 min-w-0">
                    <h3 class="text-xl font-medium text-gray-900 mb-2">
                      <a 
                        href={`/essays/${essay.slug}`} 
                        class="hover:text-blue-600 transition-colors"
                      >
                        {essay.data.title}
                      </a>
                    </h3>
                    
                    {essay.data.description && (
                      <p class="text-gray-600 text-sm leading-relaxed mb-3">
                        {essay.data.description}
                      </p>
                    )}
                    
                    <div class="flex items-center justify-between">
                      {essay.data.tags && essay.data.tags.length > 0 && (
                        <div class="flex flex-wrap gap-1">
                          {essay.data.tags.map(tag => (
                            <a 
                              href={`/essays/tag/${tag}`}
                              class="px-2 py-1 bg-blue-50 text-blue-600 text-xs rounded-md font-medium hover:bg-blue-100 transition-colors"
                            >
                              {tag}
                            </a>
                          ))}
                        </div>
                      )}
                      
                      <a 
                        href={`/essays/${essay.slug}`} 
                        class="text-sm text-blue-600 hover:text-blue-800 font-medium group-hover:translate-x-1 transition-all ml-auto"
                      >
                        Read →
                      </a>
                    </div>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </div>
      ))}
    </section>

    <!-- Empty State -->
    {essays.length === 0 && (
      <div class="text-center py-12">
        <div class="text-4xl mb-4">📚</div>
        <h2 class="text-xl font-medium text-gray-800 mb-2">No essays in archive</h2>
        <p class="text-gray-600">The archive will populate as essays are published.</p>
      </div>
    )}

  </div>
</Layout>

<!-- Archive filtering script -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const filterButtons = document.querySelectorAll('.archive-filter-btn');
    const essayItems = document.querySelectorAll('.essay-item');
    const yearSections = document.querySelectorAll('.year-section');
    
    filterButtons.forEach(button => {
      button.addEventListener('click', () => {
        const filter = button.getAttribute('data-filter');
        
        // Update active button
        filterButtons.forEach(btn => {
          btn.classList.remove('active', 'bg-blue-600', 'text-white');
          btn.classList.add('bg-white', 'text-gray-700', 'border-gray-200');
        });
        button.classList.add('active', 'bg-blue-600', 'text-white');
        button.classList.remove('bg-white', 'text-gray-700', 'border-gray-200');
        
        // Filter essays
        essayItems.forEach(item => {
          const tags = item.getAttribute('data-tags');
          const shouldShow = filter === 'all' || (tags && tags.split(',').includes(filter));
          
          if (shouldShow) {
            item.style.display = 'block';
          } else {
            item.style.display = 'none';
          }
        });
        
        // Hide/show year sections based on visible essays
        yearSections.forEach(section => {
          const visibleEssays = section.querySelectorAll('.essay-item[style="display: block"], .essay-item:not([style*="display: none"])');
          if (filter === 'all' || visibleEssays.length > 0) {
            section.style.display = 'block';
          } else {
            section.style.display = 'none';
          }
        });
      });
    });
  });
</script>

<style>
  /* Smooth transitions for filtering */
  .essay-item {
    transition: all 0.3s ease;
  }
  
  .year-section {
    transition: all 0.3s ease;
  }
  
  /* Archive filter button states */
  .archive-filter-btn.active {
    @apply bg-blue-600 text-white border-blue-600;
  }
</style>