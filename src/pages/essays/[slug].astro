---
// src/pages/essays/[slug].astro
import Layout from '../../layouts/layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const essays = await getCollection('essays', ({ data }) => {
    return data.draft !== true; // Only build published essays
  });
  return essays.map(essay => ({ params: { slug: essay.slug } }));
}

const { slug } = Astro.params;
const allEssays = await getCollection('essays', ({ data }) => data.draft !== true);

// Find the essay
const essay = allEssays.find(e => e.slug === slug);
if (!essay) {
  throw new Error(`Essay "${slug}" not found`);
}

const { Content, headings } = await essay.render();
const { data } = essay;

// Filter headings for TOC (h2 and h3 only)
const tocHeadings = headings.filter(h => h.depth === 2 || h.depth === 3);

// Get related essays (same tags)
const relatedEssays = allEssays
  .filter(e => e.slug !== slug)
  .filter(e => e.data.tags?.some(tag => data.tags?.includes(tag)))
  .slice(0, 3);

// Helper function to get a default hero image based on tags or title
function getHeroImage(essay) {
  if (essay.data.heroImage) {
    return essay.data.heroImage;
  }
  
  // Generate a gradient based on the essay content
  const colors = [
    'from-blue-400 via-purple-500 to-purple-600',
    'from-green-400 via-blue-500 to-purple-600',
    'from-pink-400 via-red-500 to-yellow-500',
    'from-indigo-400 via-purple-500 to-pink-500',
    'from-teal-400 via-blue-500 to-indigo-600',
    'from-orange-400 via-red-500 to-pink-500'
  ];
  
  const hash = essay.slug.split('').reduce((a, b) => {
    a = ((a << 5) - a) + b.charCodeAt(0);
    return a & a;
  }, 0);
  
  return colors[Math.abs(hash) % colors.length];
}

// Reading time calculator
function calculateReadingTime(content) {
  const wordsPerMinute = 200;
  const wordCount = content.split(' ').length;
  return Math.ceil(wordCount / wordsPerMinute);
}
---

<Layout title={data.title}>
  <!-- Hero Image Section -->
  <section class="relative h-96 mb-16 overflow-hidden">
    {data.heroImage ? (
      <img 
        src={data.heroImage} 
        alt={data.title}
        class="w-full h-full object-cover"
      />
    ) : (
      <div class={`w-full h-full bg-gradient-to-br ${getHeroImage(essay)} flex items-center justify-center`}>
        <div class="text-center text-white p-8">
          <div class="text-5xl mb-4">📖</div>
          <div class="text-xl font-medium opacity-90 max-w-2xl">{data.title}</div>
        </div>
      </div>
    )}
    
    <!-- Gradient overlay for better text readability -->
    <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent"></div>
    
    <!-- Floating metadata -->
    <div class="absolute bottom-6 left-6 right-6">
      <div class="max-w-4xl mx-auto">
        <div class="flex flex-wrap items-center gap-4 text-white">
          <span class="bg-black/30 px-3 py-1 rounded-full backdrop-blur text-sm">
            {calculateReadingTime(essay.body || '')} min read
          </span>
          {data.tags && data.tags.length > 0 && (
            <div class="flex flex-wrap gap-2">
              {data.tags.slice(0, 3).map(tag => (
                <span class="px-3 py-1 bg-white/20 backdrop-blur text-white text-sm rounded-full font-medium">
                  {tag}
                </span>
              ))}
              {data.tags.length > 3 && (
                <span class="px-3 py-1 bg-white/20 backdrop-blur text-white text-sm rounded-full">
                  +{data.tags.length - 3}
                </span>
              )}
            </div>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- Main Article Content -->
  <article class="max-w-4xl mx-auto">
    
    <!-- Article Header -->
    <header class="mb-12 pb-8 border-b border-gray-200">
      <h1 class="text-5xl font-light text-gray-800 mb-6 leading-tight">{data.title}</h1>
      
      <!-- Byline and metadata -->
      <div class="flex flex-wrap items-center gap-4 text-gray-600 mb-6">
        <span class="font-medium text-gray-800">By Zia Hassan</span>
        <span>•</span>
        <time class="font-mono text-sm">
          {new Date(data.publishDate).toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric'
          })}
        </time>
        <span>•</span>
        <span class="text-sm">{calculateReadingTime(essay.body || '')} min read</span>
        
        {data.tags && data.tags.length > 0 && (
          <>
            <span>•</span>
            <div class="flex flex-wrap gap-2">
              {data.tags.map(tag => (
                <span class="px-3 py-1 bg-blue-50 text-blue-600 text-sm rounded-md font-medium">
                  {tag}
                </span>
              ))}
            </div>
          </>
        )}
      </div>
      
      {data.description && (
        <p class="text-xl text-gray-600 leading-relaxed max-w-3xl">
          {data.description}
        </p>
      )}
    </header>
    
    <!-- Article Body with Table of Contents -->
    <div class="relative">
      {tocHeadings.length > 0 && (
        <div class="mb-6">
          {/* Mobile collapsible TOC */}
          <div class="lg:hidden">
            <details id="toc-accordion" class="group bg-white border border-gray-200 rounded-xl shadow-sm">
              <summary class="flex items-center justify-between px-4 py-3 cursor-pointer text-sm font-semibold text-gray-800">
                <span class="flex items-center gap-2">
                  <span class="sr-only">Table of contents</span>
                  <span class="flex items-center justify-center w-8 h-8 rounded-full bg-blue-50 text-blue-600 border border-blue-100">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 7h14M5 12h14M5 17h14" />
                    </svg>
                  </span>
                </span>
                <span class="text-gray-400 group-open:rotate-180 transition-transform">⌄</span>
              </summary>
              <nav class="border-t border-gray-100 p-3 space-y-2 max-h-64 overflow-y-auto">
                {tocHeadings.map(heading => (
                  <a 
                    href={`#${heading.slug}`}
                    class={`block text-sm rounded-lg px-3 py-2 transition-colors toc-link ${
                      heading.depth === 2 
                        ? 'text-gray-700 font-medium' 
                        : 'text-gray-500 pl-4'
                    }`}
                    data-target={heading.slug}
                  >
                    {heading.text}
                  </a>
                ))}
              </nav>
            </details>
          </div>

          {/* Desktop floating mini menu */}
          <div class="hidden lg:block">
            <div class="fixed right-6 top-1/2 -translate-y-1/2 z-30 flex flex-col items-end gap-3 pointer-events-none">
              <button 
                id="toc-toggle"
                class="pointer-events-auto flex items-center gap-2 px-3 py-2 text-sm font-semibold text-gray-700 bg-white/95 backdrop-blur border border-gray-200 rounded-full shadow-md hover:border-blue-300 hover:text-blue-700 transition-all"
                aria-expanded="false"
                aria-controls="toc-flyout"
                aria-label="Toggle table of contents"
              >
                <span class="flex items-center justify-center w-6 h-6 rounded-full bg-blue-50 text-blue-600 border border-blue-100">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 7h14M5 12h14M5 17h14" />
                  </svg>
                </span>
                <svg class="w-4 h-4 text-gray-400 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              <div 
                id="toc-flyout" 
                class="pointer-events-auto hidden w-80 bg-white/95 backdrop-blur border border-gray-200 rounded-2xl shadow-2xl max-h-[70vh] overflow-y-auto p-3 translate-y-1"
              >
                <nav class="space-y-2" id="toc-nav">
                  {tocHeadings.map(heading => (
                    <a 
                      href={`#${heading.slug}`}
                      class={`block text-sm rounded-lg px-3 py-2 transition-colors toc-link ${
                        heading.depth === 2 
                          ? 'text-gray-700 font-medium border-l-2 border-transparent hover:border-blue-300 hover:text-blue-700' 
                          : 'text-gray-500 pl-4 border-l-2 border-transparent hover:border-blue-200 hover:text-blue-600'
                      }`}
                      data-target={heading.slug}
                    >
                      {heading.text}
                    </a>
                  ))}
                </nav>
              </div>
            </div>
          </div>
        </div>
      )}

      <div class="max-w-4xl">
        <div class="prose prose-xl prose-gray max-w-none leading-relaxed">
          <Content />
        </div>
      </div>
    </div>
    
    <!-- Related Essays -->
    {relatedEssays.length > 0 && (
      <section class="mt-16 pt-8 border-t border-gray-200">
        <h2 class="text-2xl font-light text-gray-800 mb-6">Related Essays</h2>
        <div class="grid gap-6 md:grid-cols-3">
          {relatedEssays.map(related => (
            <div key={related.slug} class="group">
              <div class="bg-white rounded-lg border border-gray-200 hover:border-gray-300 hover:shadow-md transition-all duration-200 overflow-hidden">
                <!-- Small hero image for related essays -->
                <div class="h-32 overflow-hidden">
                  {related.data.heroImage ? (
                    <img 
                      src={related.data.heroImage} 
                      alt={related.data.title}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                    />
                  ) : (
                    <div class={`w-full h-full bg-gradient-to-br ${getHeroImage(related)} group-hover:scale-105 transition-transform duration-300 flex items-center justify-center`}>
                      <div class="text-center text-white">
                        <div class="text-lg">📄</div>
                      </div>
                    </div>
                  )}
                </div>
                
                <div class="p-4">
                  <h3 class="text-lg font-medium text-gray-900 mb-2 leading-tight">
                    <a href={`/essays/${related.slug}`} class="hover:text-blue-600 transition-colors">
                      {related.data.title}
                    </a>
                  </h3>
                  {related.data.description && (
                    <p class="text-sm text-gray-600 mb-3 line-clamp-2 leading-relaxed">
                      {related.data.description}
                    </p>
                  )}
                  <div class="flex items-center justify-between text-xs text-gray-500">
                    <time class="font-mono">
                      {new Date(related.data.publishDate).toLocaleDateString()}
                    </time>
                    <span>{calculateReadingTime(related.body || '')} min read</span>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>
    )}
    
    <!-- Navigation -->
    <div class="mt-16 pt-8 border-t border-gray-200">
      <div class="flex items-center justify-between">
        <a 
          href="/essays" 
          class="inline-flex items-center text-sm text-blue-600 hover:text-blue-800 font-medium group"
        >
          <span class="group-hover:-translate-x-1 transition-transform">←</span>
          <span class="ml-2">Back to all essays</span>
        </a>
        
        <!-- Share buttons -->
        <div class="flex items-center gap-3">
          <span class="text-sm text-gray-500">Share:</span>
          <button 
            onclick="navigator.share ? navigator.share({title: document.title, url: window.location.href}) : navigator.clipboard.writeText(window.location.href)"
            class="text-gray-400 hover:text-blue-600 transition-colors p-2 hover:bg-blue-50 rounded-full"
            title="Share this essay"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.367 2.684 3 3 0 00-5.367-2.684z"></path>
            </svg>
          </button>
        </div>
      </div>
    </div>
    
  </article>
</Layout>

<style>
  /* Line clamp utility */
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Enhanced prose styling for essays */
  .prose {
    @apply text-gray-700;
  }
  
  .prose h2 {
    @apply text-3xl font-light text-gray-800 mt-12 mb-6 border-b border-gray-200 pb-3 scroll-mt-8;
  }
  
  .prose h3 {
    @apply text-2xl font-medium text-gray-800 mt-10 mb-4 scroll-mt-8;
  }
  
  .prose h4 {
    @apply text-xl font-medium text-gray-800 mt-8 mb-3 scroll-mt-8;
  }
  
  .prose p {
    @apply mb-6 leading-relaxed;
  }
  
  .prose ul, .prose ol {
    @apply my-6 space-y-2;
  }
  
  .prose li {
    @apply leading-relaxed;
  }
  
  .prose blockquote {
    @apply border-l-4 border-blue-200 pl-6 italic text-gray-600 my-8 bg-blue-50 py-4 rounded-r-lg;
  }
  
  .prose strong {
    @apply text-gray-800 font-semibold;
  }
  
  .prose em {
    @apply text-gray-600;
  }
  
  .prose code {
    @apply bg-gray-100 px-2 py-1 rounded text-sm font-mono text-gray-800;
  }
  
  .prose pre {
    @apply bg-gray-100 p-6 rounded-lg overflow-x-auto my-8;
  }
  
  .prose a {
    @apply text-blue-600 hover:text-blue-800 font-medium transition-colors;
  }
  
  .prose hr {
    @apply border-gray-200 my-12;
  }
  
  /* TOC Active states */
  .toc-link.active {
    @apply text-blue-600 border-blue-600 bg-blue-50;
  }
  
  .toc-link:hover {
    @apply text-blue-600 border-blue-300;
  }

  details summary::-webkit-details-marker {
    display: none;
  }
  
  #toc-toggle svg {
    transition: transform 150ms ease;
  }
  
  /* Smooth transitions */
  * {
    transition-property: transform, opacity, background-color, border-color, color, box-shadow;
    transition-duration: 200ms;
    transition-timing-function: ease-in-out;
  }
</style>

<!-- Scroll spy and TOC toggle script -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const tocLinks = document.querySelectorAll('.toc-link');
    const headings = document.querySelectorAll('.prose h2, .prose h3');
    const mobileToc = document.getElementById('toc-accordion');
    const tocToggle = document.getElementById('toc-toggle');
    const tocFlyout = document.getElementById('toc-flyout');

    if (tocLinks.length === 0 || headings.length === 0) return;

    function closeFlyout() {
      if (tocFlyout) tocFlyout.classList.add('hidden');
      if (tocToggle) tocToggle.setAttribute('aria-expanded', 'false');
      if (tocToggle) tocToggle.querySelector('svg')?.classList.remove('rotate-180');
    }

    function openFlyout() {
      if (tocFlyout) tocFlyout.classList.remove('hidden');
      if (tocToggle) tocToggle.setAttribute('aria-expanded', 'true');
      if (tocToggle) tocToggle.querySelector('svg')?.classList.add('rotate-180');
    }

    if (tocToggle && tocFlyout) {
      tocToggle.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = tocToggle.getAttribute('aria-expanded') === 'true';
        if (isOpen) {
          closeFlyout();
        } else {
          openFlyout();
        }
      });

      document.addEventListener('click', (e) => {
        if (!tocFlyout.contains(e.target) && !tocToggle.contains(e.target)) {
          closeFlyout();
        }
      });
    }
    
    // Create intersection observer for scroll spy
    const observer = new IntersectionObserver((entries) => {
      let activeHeading = null;
      
      // Find the heading that's most visible
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          activeHeading = entry.target;
        }
      });
      
      // If no heading is intersecting, find the one closest to the top
      if (!activeHeading) {
        let closestHeading = null;
        let closestDistance = Infinity;
        
        headings.forEach(heading => {
          const rect = heading.getBoundingClientRect();
          const distance = Math.abs(rect.top);
          if (distance < closestDistance) {
            closestDistance = distance;
            closestHeading = heading;
          }
        });
        
        activeHeading = closestHeading;
      }
      
      // Update TOC active states
      tocLinks.forEach(link => {
        link.classList.remove('active');
        const target = link.getAttribute('data-target');
        if (activeHeading && activeHeading.id === target) {
          link.classList.add('active');
        }
      });
    }, {
      rootMargin: '-20% 0px -70% 0px', // Trigger when heading is in the middle area
      threshold: 0
    });
    
    // Observe all headings
    headings.forEach(heading => {
      observer.observe(heading);
    });
    
    // Smooth scroll for TOC clicks
    tocLinks.forEach(link => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        const target = document.getElementById(link.getAttribute('data-target'));
        if (target) {
          target.scrollIntoView({ 
            behavior: 'smooth',
            block: 'start'
          });
          if (mobileToc && mobileToc.hasAttribute('open')) {
            mobileToc.removeAttribute('open');
          }
          closeFlyout();
        }
      });
    });
  });
</script>
