---
import Layout from '../../layouts/layout.astro';
import { getCollection } from 'astro:content';

const articles = await getCollection('articles', ({ data }) => {
  return data.draft !== true;
});

// Sort by publish date (newest first)
const sortedArticles = articles.sort((a, b) =>
  new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime()
);
---

<Layout title="Articles">
  <div class="max-w-4xl mx-auto px-4">

    <!-- Header -->
    <header class="py-10 border-b border-gray-200">
      <h1 class="text-3xl font-light text-gray-800">Articles</h1>
      <p class="text-gray-500 mt-2">Formal research, analysis, and technical writing.</p>
    </header>

    <!-- Articles List -->
    <div class="py-8">
      {sortedArticles.length === 0 ? (
        <div class="text-center py-16 text-gray-500">
          <div class="text-4xl mb-4">📝</div>
          <p>No articles yet. Check back soon.</p>
        </div>
      ) : (
        <div class="space-y-8">
          {sortedArticles.map(article => (
            <article class="group">
              <a href={`/articles/${article.slug}`} class="block">
                <div class="border border-gray-200 rounded-lg p-6 hover:border-gray-300 hover:shadow-sm transition-all">

                  <div class="flex items-start justify-between gap-4">
                    <div class="flex-1">
                      <h2 class="text-xl font-semibold text-gray-900 group-hover:text-blue-600 transition-colors">
                        {article.data.title}
                      </h2>

                      {article.data.authors && article.data.authors.length > 0 && (
                        <p class="text-sm text-gray-500 mt-1">
                          {article.data.authors.join(', ')}
                        </p>
                      )}

                      {article.data.abstract && (
                        <p class="text-gray-600 mt-3 line-clamp-2">
                          {article.data.abstract}
                        </p>
                      )}

                      {article.data.description && !article.data.abstract && (
                        <p class="text-gray-600 mt-3 line-clamp-2">
                          {article.data.description}
                        </p>
                      )}

                      {article.data.tags && article.data.tags.length > 0 && (
                        <div class="flex flex-wrap gap-2 mt-3">
                          {article.data.tags.map(tag => (
                            <span class="px-2 py-1 bg-gray-100 text-gray-600 text-xs rounded">
                              {tag}
                            </span>
                          ))}
                        </div>
                      )}
                    </div>

                    <div class="text-right text-sm text-gray-400 flex-shrink-0">
                      <time datetime={article.data.publishDate.toISOString()}>
                        {article.data.publishDate.toLocaleDateString('en-US', {
                          year: 'numeric',
                          month: 'short'
                        })}
                      </time>
                      {article.data.quartoFile && (
                        <div class="mt-1 text-xs text-blue-500">Quarto</div>
                      )}
                    </div>
                  </div>

                </div>
              </a>
            </article>
          ))}
        </div>
      )}
    </div>

  </div>
</Layout>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
