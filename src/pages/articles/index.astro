---
import Layout from '../../layouts/layout.astro';
import fs from 'node:fs';
import path from 'node:path';

const articlesDir = path.join(process.cwd(), 'public/articles');

interface Article {
  title: string;
  authors: string[];
  date: Date | null;
  description: string;
  abstract: string;
  htmlUrl: string;
  pdfUrl: string | null;
  imageUrl: string | null;
}

const articles: Article[] = [];

if (fs.existsSync(articlesDir)) {
  const files = fs.readdirSync(articlesDir).filter(f => f.endsWith('.html'));

  for (const file of files) {
    const htmlPath = path.join(articlesDir, file);
    const html = fs.readFileSync(htmlPath, 'utf8');
    const basename = file.replace(/\.html$/, '');

    const title =
      html.match(/<title>([^<]+)<\/title>/i)?.[1]?.trim() ||
      basename;

    const authorRaw = html.match(/<meta\s+name="author"\s+content="([^"]+)"/i)?.[1] || '';
    const authors = authorRaw ? authorRaw.split(/[;,]/).map(a => a.trim()).filter(Boolean) : [];

    const dateRaw = html.match(/<meta\s+name="date"\s+content="([^"]+)"/i)?.[1] || '';
    const date = dateRaw ? new Date(dateRaw) : null;

    const description =
      html.match(/<meta\s+name="description"\s+content="([^"]+)"/i)?.[1] ||
      html.match(/<meta\s+property="og:description"\s+content="([^"]+)"/i)?.[1] ||
      '';

    const abstractBlock = html.match(/<div[^>]*class="[^"]*abstract[^"]*"[^>]*>([\s\S]*?)<\/div>\s*<\/div>/i);
    const abstract = abstractBlock
      ? abstractBlock[1].replace(/<div[^>]*class="[^"]*block-title[^"]*"[^>]*>[\s\S]*?<\/div>/i, '')
          .replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim()
      : '';

    const pdfFile = basename + '.pdf';
    const hasPdf = fs.existsSync(path.join(articlesDir, pdfFile));

    const imageExt = ['jpg', 'jpeg', 'png', 'webp'].find(ext =>
      fs.existsSync(path.join(articlesDir, `${basename}.${ext}`))
    );
    const imageUrl = imageExt ? `/articles/${basename}.${imageExt}` : null;

    articles.push({
      title,
      authors,
      date: date && !isNaN(date.getTime()) ? date : null,
      description,
      abstract,
      htmlUrl: `/articles/${file}`,
      pdfUrl: hasPdf ? `/articles/${pdfFile}` : null,
      imageUrl,
    });
  }
}

articles.sort((a, b) => {
  if (!a.date && !b.date) return 0;
  if (!a.date) return 1;
  if (!b.date) return -1;
  return b.date.getTime() - a.date.getTime();
});
---

<Layout title="Articles">
  <div class="max-w-4xl mx-auto px-6 py-10">

    <header class="pb-8 border-b border-gray-100">
      <div class="flex items-baseline justify-between">
        <h1 class="text-3xl font-light text-indigo-950" style="font-family: 'Crimson Text', Georgia, serif;">Articles</h1>
        <span class="text-sm text-gray-400">{articles.length} article{articles.length !== 1 ? 's' : ''}</span>
      </div>
      <p class="text-gray-500 mt-2">Formal research and academic writing.</p>
    </header>

    <div class="py-8">
      {articles.length === 0 ? (
        <div class="text-center py-16 text-gray-400">
          <p>No articles yet. Drop a Quarto-exported <code>.html</code> into <code>public/articles/</code>.</p>
        </div>
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          {articles.map(article => (
            <div
              class="article-card group flex flex-col bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-md transition-all overflow-hidden cursor-pointer"
              data-href={article.htmlUrl}
            >
              <div class="h-1.5 bg-indigo-300 group-hover:bg-indigo-500 transition-colors" />
              {article.imageUrl && (
                <div class="overflow-hidden" style="height:160px;">
                  <img src={article.imageUrl} alt="" class="w-full h-full object-cover" />
                </div>
              )}
              <div class="p-6 flex flex-col flex-1">
                <span class="card-label text-indigo-400 mb-3">Article</span>
                <h2
                  class="text-xl font-medium text-gray-900 leading-snug mb-2 group-hover:text-indigo-700 transition-colors"
                  style="font-family: 'Crimson Text', Georgia, serif;"
                >
                  {article.title}
                </h2>

                {article.authors.length > 0 && (
                  <p class="text-xs text-gray-400 mb-3 font-medium tracking-wide">
                    {article.authors.join(', ')}
                  </p>
                )}

                {(article.abstract || article.description) && (
                  <p class="text-sm text-gray-500 leading-relaxed flex-1 mb-5 line-clamp-3">
                    {article.abstract || article.description}
                  </p>
                )}

                <div class="flex items-center justify-between mt-auto pt-3 border-t border-gray-50">
                  <div class="flex items-center gap-3">
                    <span class="text-xs text-indigo-500 font-medium group-hover:text-indigo-700 transition-colors">Read →</span>
                    {article.pdfUrl && (
                      <a
                        href={article.pdfUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-xs text-gray-400 hover:text-gray-600 transition-colors"
                      >
                        PDF ↓
                      </a>
                    )}
                  </div>
                  {article.date && (
                    <time class="text-xs text-amber-500 font-mono font-medium">
                      {article.date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}
                    </time>
                  )}
                </div>
              </div>
            </div>
          ))}
        </div>
      )}
    </div>

  </div>
</Layout>

<script>
  document.querySelectorAll('.article-card').forEach(card => {
    card.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) return;
      window.location.href = (card as HTMLElement).dataset.href!;
    });
  });
</script>

<style>
  .card-label {
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
