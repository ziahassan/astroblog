---
// src/pages/now.astro
import Layout from '../layouts/layout.astro';
---

<Layout title="Now">
  <!-- Background decorative elements -->
  <div class="floating-emoji" style="top: 10%; left: 5%;">🌱</div>
  <div class="floating-emoji" style="top: 20%; right: 10%;">📚</div>
  <div class="floating-emoji" style="top: 60%; left: 8%;">💭</div>
  <div class="floating-emoji" style="top: 80%; right: 5%;">✨</div>

  <!-- Header -->
  <header class="relative max-w-4xl mx-auto px-6 pt-16 pb-12">
    <div class="text-center mb-12">
      <h1 class="text-5xl md:text-6xl font-light text-gray-800 mb-4 serif">
        What I'm up to now
      </h1>
      <p class="text-xl text-gray-600 max-w-2xl mx-auto leading-relaxed">
        A living document of my current projects, thoughts, and focus areas. 
        Inspired by Derek Sivers' <a href="https://nownownow.com/about" class="text-blue-600 hover:underline font-medium">now page movement</a>.
      </p>
    </div>
    
    <!-- Last updated badge -->
    <div class="last-updated rounded-lg p-4 text-center max-w-md mx-auto">
      <p class="text-sm text-gray-600">
        <span class="font-medium">Last updated:</span> January 2025
      </p>
    </div>
  </header>

  <!-- Main content -->
  <main class="max-w-4xl mx-auto px-6 pb-16">
    
    <!-- Current focus -->
    <section class="mb-16">
      <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-8 md:p-12">
        <div class="prose-custom">
          <h2 class="timeline-dot">Currently</h2>
          
          <p>
            I'm deep into exploring how AI can transform education without losing the human elements that make learning meaningful. 
            There's something fascinating about the tension between personalization and community, between efficiency and serendipity.
          </p>
          
          <p>
            Most of my days are split between writing, teaching, and experimenting with new tools. I'm particularly excited about 
            how AI can help us ask better questions rather than just giving us better answers. The essays I've been working on 
            explore this theme from different angles.
          </p>
          
          <p>
            On the technical side, I'm building out this digital garden you're reading right now. It's becoming a place where 
            I can think in public and see how ideas connect to each other over time. The graph visualizations are my favorite part – 
            there's something magical about seeing thought patterns emerge.
          </p>
        </div>
      </div>
    </section>

    <!-- Projects -->
    <section class="mb-16">
      <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-8 md:p-12">
        <div class="prose-custom">
          <h2 class="timeline-dot">Projects</h2>
          
          <h3>🌐 This Digital Garden</h3>
          <p>
            Building a connected knowledge base that functions like a second brain. The goal is to create a space where 
            ideas can grow and link to each other organically. I'm particularly focused on making the connections between 
            concepts visible and explorable.
          </p>
          
          <h3>✍️ AI & Education Essay Series</h3>
          <p>
            Working on a collection of long-form pieces about the intersection of artificial intelligence and learning. 
            Each essay explores a different facet – from personalization to assessment to the future of teaching itself.
          </p>
          
          <h3>🎓 Teaching & Workshops</h3>
          <p>
            Continuing to work with educators who want to thoughtfully integrate AI tools into their practice. 
            The focus is always on amplifying human creativity and connection, not replacing it.
          </p>
        </div>
      </div>
    </section>

    <div class="section-divider"></div>

    <!-- Reading & Learning -->
    <section class="mb-16">
      <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-8 md:p-12">
        <div class="prose-custom">
          <h2 class="timeline-dot">Reading & Learning</h2>
          
          <p>
            I'm always consuming books, papers, and conversations that shape how I think about learning and technology. 
            Here's what's currently on my bedside table and in my browser tabs:
          </p>
          
          <div class="grid md:grid-cols-2 gap-6 mt-8">
            <div>
              <h3>📖 Currently Reading</h3>
              <div class="space-y-3">
                <div class="reading-item p-3 border-l-2 border-blue-200 pl-4">
                  <div class="font-medium text-gray-800">The Alignment Problem</div>
                  <div class="text-sm text-gray-600">Brian Christian</div>
                  <div class="text-xs text-gray-500 mt-1">How machine learning reflects human values</div>
                </div>
                <div class="reading-item p-3 border-l-2 border-green-200 pl-4">
                  <div class="font-medium text-gray-800">A Pedagogy for Liberation</div>
                  <div class="text-sm text-gray-600">Paulo Freire & Ira Shor</div>
                  <div class="text-xs text-gray-500 mt-1">Dialogues on transforming education</div>
                </div>
                <div class="reading-item p-3 border-l-2 border-purple-200 pl-4">
                  <div class="font-medium text-gray-800">The Pattern on the Stone</div>
                  <div class="text-sm text-gray-600">W. Daniel Hillis</div>
                  <div class="text-xs text-gray-500 mt-1">The simple ideas that make computers work</div>
                </div>
              </div>
            </div>
            
            <div>
              <h3>🔖 Want to Read</h3>
              <div class="space-y-3">
                <div class="reading-item p-3 border-l-2 border-orange-200 pl-4">
                  <div class="font-medium text-gray-800">The Age of AI</div>
                  <div class="text-sm text-gray-600">Henry Kissinger, Eric Schmidt, Daniel Huttenlocher</div>
                </div>
                <div class="reading-item p-3 border-l-2 border-teal-200 pl-4">
                  <div class="font-medium text-gray-800">Mindstorms</div>
                  <div class="text-sm text-gray-600">Seymour Papert</div>
                </div>
                <div class="reading-item p-3 border-l-2 border-pink-200 pl-4">
                  <div class="font-medium text-gray-800">The Network Society</div>
                  <div class="text-sm text-gray-600">Manuel Castells</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Thinking About -->
    <section class="mb-16">
      <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-8 md:p-12">
        <div class="prose-custom">
          <h2 class="timeline-dot">Thinking About</h2>
          
          <div class="grid md:grid-cols-2 gap-8">
            <div>
              <h3>🤖 AI & Humanity</h3>
              <p>
                How do we preserve what makes us uniquely human while embracing tools that can augment our capabilities? 
                I'm particularly interested in the space between automation and creativity.
              </p>
            </div>
            
            <div>
              <h3>🧠 Learning Systems</h3>
              <p>
                What can we learn from how children naturally acquire knowledge? How do we scale personalized learning 
                without losing the magic of human connection and serendipitous discovery?
              </p>
            </div>
            
            <div>
              <h3>🌱 Digital Gardens</h3>
              <p>
                How can we make our thinking more visible and connected? I'm fascinated by tools that help us 
                see patterns in our own thoughts and make unexpected connections.
              </p>
            </div>
            
            <div>
              <h3>🎯 Focused Work</h3>
              <p>
                In an age of constant distraction, how do we create the deep focus necessary for meaningful work? 
                What practices and environments support sustained attention?
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <div class="section-divider"></div>

    <!-- Personal -->
    <section class="mb-16">
      <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-8 md:p-12">
        <div class="prose-custom">
          <h2 class="timeline-dot">Life Outside Work</h2>
          
          <p>
            I'm trying to be more intentional about how I spend my time away from screens. This means longer walks, 
            more conversations that meander, and protecting time for pure play and exploration.
          </p>
          
          <p>
            Music continues to be a constant companion. I'm slowly working through Bach's Well-Tempered Clavier on piano – 
            there's something about the mathematical beauty of his counterpoint that feels connected to the work I do with AI.
          </p>
          
          <p>
            I've been experimenting with film photography as a way to slow down and be more deliberate. There's something 
            about the constraints and the anticipation of development that creates a different relationship with image-making.
          </p>
        </div>
      </div>
    </section>

    <!-- Contact -->
    <section>
      <div class="bg-gradient-to-br from-blue-50 to-indigo-50 rounded-2xl border border-blue-100 p-8 md:p-12 text-center">
        <h2 class="text-2xl font-semibold text-gray-800 mb-4 serif">Want to Connect?</h2>
        <p class="text-gray-600 mb-6 max-w-2xl mx-auto">
          I'm always interested in conversations about learning, technology, and the future we're building together. 
          If something here resonates with you, I'd love to hear from you.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="mailto:hello@ziahassan.com" class="inline-flex items-center px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors font-medium">
            <span class="mr-2">✉️</span>
            Email me
          </a>
          <a href="/essays" class="inline-flex items-center px-6 py-3 bg-white text-blue-600 rounded-lg border border-blue-200 hover:bg-blue-50 transition-colors font-medium">
            <span class="mr-2">📝</span>
            Read my essays
          </a>
          <a href="/notes" class="inline-flex items-center px-6 py-3 bg-white text-blue-600 rounded-lg border border-blue-200 hover:bg-blue-50 transition-colors font-medium">
            <span class="mr-2">🌐</span>
            Explore my notes
          </a>
        </div>
      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer class="max-w-4xl mx-auto px-6 py-8 text-center text-sm text-gray-500">
    <p>
      This page is inspired by <a href="https://maggieappleton.com/now/" class="text-blue-600 hover:underline">Maggie Appleton's approach</a> 
      to sharing work in progress and current thinking.
    </p>
  </footer>
</Layout>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Crimson+Text:ital,wght@0,400;0,600;1,400&display=swap');
  
  body {
    font-family: 'Inter', sans-serif;
    background: linear-gradient(to bottom right, #f9fafb, #ffffff);
    min-height: 100vh;
  }
  
  .serif {
    font-family: 'Crimson Text', serif;
  }
  
  .prose-custom {
    line-height: 1.75;
  }
  
  .prose-custom p {
    margin-bottom: 1.5rem;
    color: #374151;
  }
  
  .prose-custom h2 {
    font-family: 'Crimson Text', serif;
    font-size: 1.5rem;
    font-weight: 600;
    color: #1f2937;
    margin-top: 3rem;
    margin-bottom: 1rem;
    border-bottom: 1px solid #e5e7eb;
    padding-bottom: 0.5rem;
  }
  
  .prose-custom h3 {
    font-size: 1.25rem;
    font-weight: 500;
    color: #374151;
    margin-top: 2rem;
    margin-bottom: 1rem;
  }
  
  .prose-custom a {
    color: #3b82f6;
    text-decoration: none;
    font-weight: 500;
  }
  
  .prose-custom a:hover {
    text-decoration: underline;
  }
  
  .prose-custom em {
    font-style: italic;
    color: #6b7280;
  }
  
  .prose-custom strong {
    font-weight: 600;
    color: #1f2937;
  }
  
  .last-updated {
    background: linear-gradient(135deg, #f3f4f6 0%, #e5e7eb 100%);
    border-left: 4px solid #3b82f6;
  }
  
  .reading-item {
    transition: all 0.2s ease;
  }
  
  .reading-item:hover {
    transform: translateX(4px);
    background-color: #f9fafb;
  }
  
  .section-divider {
    height: 1px;
    background: linear-gradient(to right, transparent, #e5e7eb, transparent);
    margin: 3rem 0;
  }
  
  .floating-emoji {
    position: absolute;
    font-size: 1.5rem;
    opacity: 0.6;
    pointer-events: none;
    z-index: 1;
    animation: float 6s ease-in-out infinite;
  }
  
  .timeline-dot {
    position: relative;
  }
  
  .timeline-dot::before {
    content: '';
    position: absolute;
    left: -2rem;
    top: 0.5rem;
    width: 8px;
    height: 8px;
    background: #3b82f6;
    border-radius: 50%;
    border: 2px solid white;
    box-shadow: 0 0 0 2px #3b82f6;
  }
  
  @keyframes float {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-10px); }
  }
  
  @media (max-width: 768px) {
    .timeline-dot::before {
      display: none;
    }
  }
</style>

<script>
  // Add staggered animations to floating emojis
  document.addEventListener('DOMContentLoaded', () => {
    const emojis = document.querySelectorAll('.floating-emoji');
    
    emojis.forEach((emoji, index) => {
      emoji.style.animationDelay = `${index * 0.5}s`;
    });
  });
</script>