---
import Layout from '../layouts/layout.astro';
import { getCollection } from 'astro:content';

// 🔧 Utility helpers to prevent localeCompare/type errors
const str = (v) => String(v ?? '').toLowerCase();
const time = (v) => {
  const t = new Date(v).getTime();
  return Number.isFinite(t) ? t : -Infinity; // invalid dates sort last
};

// Get content collections
const essays = await getCollection('essays', ({ data }) =>
  data.draft !== true && data.publishDate && new Date(data.publishDate) <= new Date()
);

const notes = await getCollection('notes');
const readings = await getCollection('reading');

// 📝 Sorters
const recentEssays = essays
  .sort((a, b) => time(b?.data?.publishDate) - time(a?.data?.publishDate))
  .slice(0, 3);

const recentNotes = notes
  .filter((n) => (n?.data?.title ?? n?.slug) != null)
  .sort((a, b) => {
    const da = time(a?.data?.created ?? a?.data?.publishDate);
    const db = time(b?.data?.created ?? b?.data?.publishDate);
    if (da !== db) return db - da;
    const ta = str(a?.data?.title ?? a?.slug);
    const tb = str(b?.data?.title ?? b?.slug);
    return ta.localeCompare(tb);
  })
  .slice(0, 6);

const recentReadings = readings
  .filter((r) => r?.data?.readDate || r?.data?.dateAdded)
  .sort(
    (a, b) =>
      time(b?.data?.readDate ?? b?.data?.dateAdded) -
      time(a?.data?.readDate ?? a?.data?.dateAdded)
  )
  .slice(0, 5);

// 🕒 Relative time helper (optional)
function getRelativeTime(dateString) {
  const date = new Date(dateString);
  if (isNaN(date.getTime())) return '';
  const now = new Date();
  const diff = Math.floor((now - date) / 1000);
  if (diff < 60) return 'just now';
  if (diff < 3600) return `${Math.floor(diff / 60)}m ago`;
  if (diff < 86400) return `${Math.floor(diff / 3600)}h ago`;
  if (diff < 604800) return `${Math.floor(diff / 86400)}d ago`;
  return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
}
---

<Layout title="Now">
  <main class="max-w-4xl mx-auto p-6">
    <h1 class="text-4xl font-light mb-8 text-center">Now</h1>

    <section class="mb-16">
      <h2 class="text-2xl font-semibold mb-4">Recent Essays</h2>
      <ul class="space-y-3">
        {recentEssays.map((e) => (
          <li>
            <a href={`/essays/${e.slug}`} class="text-blue-600 hover:underline">
              {e.data.title}
            </a>{' '}
            <span class="text-gray-500 text-sm">
              ({getRelativeTime(e.data.publishDate)})
            </span>
          </li>
        ))}
      </ul>
    </section>

    <section class="mb-16">
      <h2 class="text-2xl font-semibold mb-4">Recent Notes</h2>
      <ul class="space-y-3">
        {recentNotes.map((n) => (
          <li>
            <a href={`/notes/${n.slug}`} class="text-green-600 hover:underline">
              {n.data.title || n.slug}
            </a>{' '}
            <span class="text-gray-500 text-sm">
              ({getRelativeTime(n.data.created || n.data.publishDate)})
            </span>
          </li>
        ))}
      </ul>
    </section>

    <section>
      <h2 class="text-2xl font-semibold mb-4">Recent Reading</h2>
      <ul class="space-y-3">
        {recentReadings.map((r) => (
          <li>
            <a href={`/reading/${r.slug}`} class="text-purple-600 hover:underline">
              {r.data.title}
            </a>{' '}
            <span class="text-gray-500 text-sm">
              ({getRelativeTime(r.data.readDate || r.data.dateAdded)})
            </span>
          </li>
        ))}
      </ul>
    </section>
  </main>
</Layout>